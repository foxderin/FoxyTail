#!/system/bin/sh
# FoxyTail MagicDNS Split Resolver
#
# Split-DNS via a local dnsmasq: tailnet names go to 100.100.100.100,
# everything else to the system resolver. Coexistence-aware.
#
# Subcommands:
#   start   Start dnsmasq split-DNS and the port-53 redirect. Requires
#           MAGIC_DNS=on, a dnsmasq binary in $TS_BIN_DIR and MagicDNS
#           enabled on the tailnet. Reads .MagicDNSSuffix from
#           `tailscale --socket=... status --json`. If any prerequisite fails
#           the script logs a Warning, records state "degraded" and exits 0.
#           If `foxytail.compat check-dns-hijack` reports a conflicting global
#           DNS hijack (non-zero exit), interception is removed, dnsmasq
#           remains available locally, and state stays degraded.
#   stop    Remove the redirect chain and stop dnsmasq.
#   status  Show running / degraded / stopped state. `status --json` prints
#           the machine-readable form {"state","suffix","port","pid"} for
#           foxytail.webapi.sh.

# POSIX sh (Android mksh / busybox). No bashisms, no `set -e`.

DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "${DIR}/../settings.sh"

scripts_name=$(basename "$0")
TS_SOCKET="${TS_RUN_DIR}/tailscaled.sock"
DNS_BIN="${TS_BIN_DIR}/dnsmasq"
DNS_CONF="${TS_RUN_DIR}/dnsmasq.conf"
DNS_LOG="${TS_RUN_DIR}/dnsmasq.log"
PID_FILE="${TS_PID_DIR}/dnsmasq.pid"
DNS_STATE_FILE="${TS_RUN_DIR}/dnsmasq.state"
DNS_CONTEXT_FILE="${TS_RUN_DIR}/dnsmasq.context.json"
CHAIN_DNS="FOXY_DNS"

set_state() {
  echo "$1" >"${DNS_STATE_FILE}"
}

get_state() {
  cat "${DNS_STATE_FILE}" 2>/dev/null || echo "stopped"
}

# PIDs of OUR dnsmasq instance only: argv[0] must be the binary under
# $TS_BIN_DIR (or its bare name) and the cmdline must reference our config.
dns_pids() {
  for _dp_pid in $(pids_of_path "${DNS_BIN}"); do
    if tr '\0' ' ' <"/proc/${_dp_pid}/cmdline" 2>/dev/null | grep -qF "${DNS_CONF}"; then
      echo "${_dp_pid}"
    fi
  done
}

# True when the installed coexistence probe finds a reachable DNS redirect.
# Contract: `foxytail.compat check-dns-hijack` exits 0 when the coast is
# clear, non-zero when someone else redirects/TProxys port 53.
dns_hijack_conflict() {
  command -v foxytail.compat >/dev/null 2>&1 || return 1
  ! foxytail.compat check-dns-hijack >/dev/null 2>&1
}

# Mount FOXY_DNS (nat) on OUTPUT and redirect UDP/53 into dnsmasq. The first
# rule exempts dnsmasq's own upstream queries (it runs as AID_NOBODY=9999, see
# --user=nobody below) so they are not redirected back into dnsmasq itself.
redirect_apply() {
  iptables -t nat -N "${CHAIN_DNS}" 2>/dev/null
  if ! iptables -t nat -C "${CHAIN_DNS}" -m owner --uid-owner 9999 -j RETURN 2>/dev/null; then
    iptables -t nat -I "${CHAIN_DNS}" 1 -m owner --uid-owner 9999 -j RETURN ||
      { log Warning "failed to add dnsmasq owner exemption to ${CHAIN_DNS}."; return 1; }
  fi
  for _dr_proto in udp tcp; do
    if ! iptables -t nat -C "${CHAIN_DNS}" -p "${_dr_proto}" --dport 53 -j REDIRECT --to-ports "${DNS_PORT}" 2>/dev/null; then
      iptables -t nat -A "${CHAIN_DNS}" -p "${_dr_proto}" --dport 53 -j REDIRECT --to-ports "${DNS_PORT}" ||
        { log Warning "failed to add DNS REDIRECT rule."; return 1; }
    fi
  done
  if ! iptables -t nat -C OUTPUT -j "${CHAIN_DNS}" 2>/dev/null; then
    iptables -t nat -A OUTPUT -j "${CHAIN_DNS}" ||
      { log Warning "failed to mount ${CHAIN_DNS} on nat/OUTPUT."; return 1; }
  fi
  return 0
}

redirect_teardown() {
  while iptables -t nat -D OUTPUT -j "${CHAIN_DNS}" 2>/dev/null; do :; done
  iptables -t nat -F "${CHAIN_DNS}" 2>/dev/null
  iptables -t nat -X "${CHAIN_DNS}" 2>/dev/null
  iptables -t nat -C OUTPUT -j "${CHAIN_DNS}" 2>/dev/null && return 1
  iptables -t nat -S "${CHAIN_DNS}" >/dev/null 2>&1 && return 1
  return 0
}

redirect6_apply() {
  ip6tables -t nat -N "${CHAIN_DNS}" 2>/dev/null
  if ! ip6tables -t nat -C "${CHAIN_DNS}" -m owner --uid-owner 9999 -j RETURN 2>/dev/null; then
    ip6tables -t nat -I "${CHAIN_DNS}" 1 -m owner --uid-owner 9999 -j RETURN ||
      { log Warning "failed to add v6 dnsmasq owner exemption to ${CHAIN_DNS}."; return 1; }
  fi
  for _dr6_proto in udp tcp; do
    if ! ip6tables -t nat -C "${CHAIN_DNS}" -p "${_dr6_proto}" --dport 53 -j REDIRECT --to-ports "${DNS_PORT}" 2>/dev/null; then
      ip6tables -t nat -A "${CHAIN_DNS}" -p "${_dr6_proto}" --dport 53 -j REDIRECT --to-ports "${DNS_PORT}" ||
        { log Warning "failed to add v6 DNS REDIRECT rule."; return 1; }
    fi
  done
  if ! ip6tables -t nat -C OUTPUT -j "${CHAIN_DNS}" 2>/dev/null; then
    ip6tables -t nat -A OUTPUT -j "${CHAIN_DNS}" ||
      { log Warning "failed to mount ${CHAIN_DNS} on ip6tables nat/OUTPUT."; return 1; }
  fi
  return 0
}

redirect6_teardown() {
  while ip6tables -t nat -D OUTPUT -j "${CHAIN_DNS}" 2>/dev/null; do :; done
  ip6tables -t nat -F "${CHAIN_DNS}" 2>/dev/null
  ip6tables -t nat -X "${CHAIN_DNS}" 2>/dev/null
  ip6tables -t nat -C OUTPUT -j "${CHAIN_DNS}" 2>/dev/null && return 1
  ip6tables -t nat -S "${CHAIN_DNS}" >/dev/null 2>&1 && return 1
  return 0
}

# Reconcile redirect independently from process liveness. A running dnsmasq
# without interception remains degraded and can recover on the next start.
reconcile_redirect() {
  if dns_hijack_conflict; then
    _dr_cleanup=0
    redirect_teardown || _dr_cleanup=1
    redirect6_teardown || _dr_cleanup=1
    log Warning "another tool hijacks DNS; local resolver runs without interception"
    set_state degraded
    return "${_dr_cleanup}"
  fi
  if ! redirect_apply || { [ "${IPV6}" = on ] && ! redirect6_apply; }; then
    redirect_teardown
    redirect6_teardown
    set_state degraded
    return 1
  fi
  if [ "${IPV6}" != on ] && ! redirect6_teardown; then
    set_state degraded
    return 1
  fi
  set_state running
}

redirect_present() {
  for _dp_cmd in iptables ip6tables; do
    [ "${_dp_cmd}" = ip6tables ] && [ "${IPV6}" != on ] && continue
    "${_dp_cmd}" -t nat -C OUTPUT -j "${CHAIN_DNS}" 2>/dev/null || return 1
    "${_dp_cmd}" -t nat -C "${CHAIN_DNS}" -m owner --uid-owner 9999 -j RETURN 2>/dev/null || return 1
    for _dp_proto in udp tcp; do
      "${_dp_cmd}" -t nat -C "${CHAIN_DNS}" -p "${_dp_proto}" --dport 53 -j REDIRECT --to-ports "${DNS_PORT}" 2>/dev/null || return 1
    done
  done
}

# A live resolver is useful only for the currently selected account/tailnet.
# Keep the observed context as JSON data; suffixes are validated before they
# are written to dnsmasq configuration. An unreachable daemon is not ready.
current_dns_context() {
  _dc_json=$(tmo 5 tailscale --socket="${TS_SOCKET}" status --json 2>/dev/null) || return 1
  printf '%s' "${_dc_json}" | jqr -e -c '
    select(.CurrentTailnet.MagicDNSEnabled == true)
    | {suffix:(.MagicDNSSuffix // ""),tailnet:(.CurrentTailnet.Name // ""),self:(.Self.ID // "")}
    | select(.suffix | test("^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$"))' 2>/dev/null
}

dns_context_matches() {
  [ -f "${DNS_CONTEXT_FILE}" ] &&
    [ "$(cat "${DNS_CONTEXT_FILE}" 2>/dev/null)" = "$1" ] &&
    [ "$(awk -F/ '/^server=\// {print $2; exit}' "${DNS_CONF}" 2>/dev/null)" = "$(printf '%s' "$1" | jqr -r '.suffix')" ]
}

dns_start() {
  ensure_run_dirs
  load_conf || return 1

  if [ "${MAGIC_DNS}" != "on" ]; then
    log Debug "MAGIC_DNS=off; split DNS disabled."
    dns_stop
    return $?
  fi

  _ds_context=$(current_dns_context)
  if [ -z "${_ds_context}" ]; then
    log Warning "current tailnet MagicDNS is unavailable; removing stale resolver state"
    dns_stop || { set_state degraded; return 1; }
    set_state degraded
    return 0
  fi
  _ds_suffix=$(printf '%s' "${_ds_context}" | jqr -r '.suffix')

  if [ -n "$(dns_pids)" ]; then
    _ds_config_v6=off
    grep -q '^listen-address=::1$' "${DNS_CONF}" 2>/dev/null && _ds_config_v6=on
    if [ "$(sed -n 's/^port=//p' "${DNS_CONF}" 2>/dev/null)" = "${DNS_PORT}" ] &&
      [ "${_ds_config_v6}" = "${IPV6}" ] && dns_context_matches "${_ds_context}"; then
      log Info "dnsmasq is already running; reconciling DNS interception."
      reconcile_redirect
      return $?
    fi
    dns_stop || return 1
  fi

  if [ ! -x "${DNS_BIN}" ]; then
    log Warning "dnsmasq binary not found at ${DNS_BIN}; MagicDNS degraded."
    set_state degraded
    return 0
  fi

  _ds_default_dns=$(getprop net.dns1 2>/dev/null)
  [ -z "${_ds_default_dns}" ] && _ds_default_dns="1.1.1.1"

  {
    echo "port=${DNS_PORT}"
    echo "listen-address=127.0.0.1"
    [ "${IPV6}" = "on" ] && echo "listen-address=::1"
    echo "bind-interfaces"
    echo "no-resolv"
    echo "cache-size=512"
    echo "server=/${_ds_suffix}/100.100.100.100"
    echo "server=${_ds_default_dns}"
  } >"${DNS_CONF}"
  chmod 0644 "${DNS_CONF}"

  rotate_log "${DNS_LOG}"
  log Info "Starting dnsmasq on 127.0.0.1:${DNS_PORT} (suffix: ${_ds_suffix}, upstream: ${_ds_default_dns})."
  nohup "${DNS_BIN}" --keep-in-foreground --conf-file="${DNS_CONF}" \
    --pid-file="${PID_FILE}" --user=nobody >>"${DNS_LOG}" 2>&1 &

  sleep 1
  if [ -z "$(dns_pids)" ]; then
    log Warning "dnsmasq failed to start; see ${DNS_LOG}. MagicDNS degraded."
    set_state degraded
    return 0
  fi

  printf '%s\n' "${_ds_context}" >"${DNS_CONTEXT_FILE}" || { set_state degraded; return 1; }
  reconcile_redirect || return 1
  [ "$(get_state)" = running ] || return 0

  log Success "MagicDNS split resolver is up."
  return 0
}

dns_stop() {
  ensure_run_dirs
  # Cleanup uses fixed chain names and the owned process path, not desired config.

  _dt_rc=0
  redirect_teardown || _dt_rc=1
  redirect6_teardown || _dt_rc=1
  _dt_pids=$(dns_pids)
  if [ -n "${_dt_pids}" ]; then
    stop_by_pids dnsmasq "${_dt_pids}" || _dt_rc=1
  fi

  [ -z "$(dns_pids)" ] || _dt_rc=1
  if [ "${_dt_rc}" = 0 ]; then
    rm -f "${PID_FILE}" "${DNS_CONTEXT_FILE}"
    set_state stopped
  else
    log Error "DNS cleanup incomplete; retaining degraded state for retry"
    set_state degraded
  fi
  return "${_dt_rc}"
}

dns_status() {
  ensure_run_dirs
  load_conf || return 1

  _dst_json=false
  [ "${1:-}" = "--json" ] && _dst_json=true

  _dst_state=$(get_state)
  _dst_pids=$(dns_pids)
  if [ -n "${_dst_pids}" ]; then
    _dst_context=$(current_dns_context)
    if [ "${_dst_state}" != running ] || [ -z "${_dst_context}" ] ||
      ! dns_context_matches "${_dst_context}" || ! redirect_present || dns_hijack_conflict; then
      _dst_state=degraded
    fi
  elif [ "${_dst_state}" = "running" ]; then
    # An unexpectedly dead resolver may leave interception in place.
    _dst_state="degraded"
  fi

  _dst_pid=null
  if [ -n "${_dst_pids}" ]; then
    # shellcheck disable=SC2086 # intentional: one PID per word
    set -- ${_dst_pids}
    _dst_pid="$1"
  fi

  _dst_suffix=""
  if [ -f "${DNS_CONF}" ]; then
    _dst_suffix=$(awk -F/ '/^server=\// {print $2}' "${DNS_CONF}" | head -1)
  fi

  # Machine-readable form for foxytail.webapi.sh (`status --json`).
  if [ "${_dst_json}" = true ]; then
    jqr -n -c --arg s "${_dst_state}" --arg sfx "${_dst_suffix}" \
      --argjson p "${DNS_PORT}" --argjson pid "${_dst_pid}" \
      '{state:$s,suffix:$sfx,port:$p,pid:$pid}'
    return 0
  fi

  case "${_dst_state}" in
    running) _dst_color="${green}" ;;
    degraded) _dst_color="${yellow}" ;;
    *) _dst_color="${red}" ;;
  esac
  printf '%s\n' "${blue}MagicDNS:${normal} ${_dst_color}${_dst_state}${normal}  ${blue}Port:${normal} ${yellow}${DNS_PORT}${normal}"

  if iptables -t nat -L "${CHAIN_DNS}" -n >/dev/null 2>&1; then
    printf '%s\n' "  ${blue}Redirect:${normal} ${green}UDP/53 -> ${DNS_PORT} active (${CHAIN_DNS})${normal}"
  else
    printf '%s\n' "  ${blue}Redirect:${normal} ${red}inactive${normal}"
  fi

  [ -n "${_dst_suffix}" ] && printf '%s\n' "  ${blue}Suffix:${normal} ${yellow}${_dst_suffix}${normal}"
  return 0
}

usage() {
  printf '%s\n' "${yellow}usage${normal}: ${green}${scripts_name}${normal} {${orange}start|stop|status${normal}}"
}

case "$1" in
  start)
    dns_start
    ;;
  stop)
    dns_stop
    ;;
  status)
    dns_status "$2"
    ;;
  *)
    if [ -n "$1" ]; then
      printf '%s\n' "${yellow}${scripts_name} ${orange}$1 ${red}not found${normal}"
      exit 1
    fi
    usage
    ;;
esac
