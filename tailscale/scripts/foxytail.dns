#!/system/bin/sh
# FoxyTail MagicDNS Split Resolver
#
# Split-DNS via a local dnsmasq: tailnet names go to 100.100.100.100,
# everything else to the system resolver. Coexistence-aware.
#
# Subcommands:
#   start   Start dnsmasq split-DNS and the port-53 redirect. Requires
#           MAGIC_DNS=on, a dnsmasq binary in $TS_BIN_DIR and MagicDNS
#           enabled on the tailnet. Reads .MagicDNSSuffix from
#           `tailscale --socket=... status --json`. If any prerequisite fails
#           the script logs a Warning, records state "degraded" and exits 0.
#           If `foxytail.compat check-dns-hijack` reports a conflicting global
#           DNS hijack (non-zero exit), interception is removed, dnsmasq
#           remains available locally, and state stays degraded.
#   stop    Remove the redirect chain and stop dnsmasq.
#   status  Show running / degraded / stopped state. `status --json` prints
#           the machine-readable form {"state","suffix","port","pid"} for
#           foxytail.webapi.sh.

# POSIX sh (Android mksh / busybox). No bashisms, no `set -e`.

DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "${DIR}/../settings.sh"

scripts_name=$(basename "$0")
DNS_BIN=""
DNS_CONF="${TS_RUN_DIR}/dnsmasq.conf"
DNS_LOG="${TS_RUN_DIR}/dnsmasq.log"
DNS_STATE_FILE="${TS_RUN_DIR}/dnsmasq.state"
DNS_REASON_FILE="${TS_RUN_DIR}/dnsmasq.reason"
DNS_CONTEXT_FILE="${TS_RUN_DIR}/dnsmasq.context.json"
DNS_HOSTS_DIR="/dev/foxytail-dns"
DNS_HOSTS="${DNS_HOSTS_DIR}/hosts"
CHAIN_DNS="FOXY_DNS"
LEGACY_OWNERSHIP="${TS_DIR}/state/dnsmasq-connmark.jsonl"
LEGACY_NETWORK="${TS_RUN_DIR}/dnsmasq.network.json"

# New modes are opt-in. Older installs keep the existing dnsmasq behavior.
[ ! -r "${TS_SCRIPTS_DIR}/foxytail.dns-modern.sh" ] || . "${TS_SCRIPTS_DIR}/foxytail.dns-modern.sh"

set_state() {
  _ss_old=; IFS= read -r _ss_old 2>/dev/null <"${DNS_STATE_FILE}" || :
  [ "${_ss_old}" = "$1" ] || echo "$1" >"${DNS_STATE_FILE}"
  _ss_old=; IFS= read -r _ss_old 2>/dev/null <"${DNS_REASON_FILE}" || :
  [ "${_ss_old}" = "${2:-$1}" ] || printf '%s\n' "${2:-$1}" >"${DNS_REASON_FILE}"
}

# Android commonly ships a compatible dnsmasq for tethering. Prefer an
# explicitly supplied binary, then the OS binary; never execute an arbitrary
# PATH entry. The config-path check below keeps tethering's instance separate.
select_dns_binary() {
  DNS_BIN=""
  for _db in "${TS_BIN_DIR}/dnsmasq" /system/bin/dnsmasq /vendor/bin/dnsmasq; do
    if [ -x "${_db}" ]; then DNS_BIN="${_db}"; return 0; fi
  done
  return 1
}

get_state() {
  cat "${DNS_STATE_FILE}" 2>/dev/null || echo "stopped"
}

# PIDs of OUR dnsmasq instance only: argv[0] must be the binary under
# $TS_BIN_DIR (or its bare name) and the cmdline must reference our config.
dns_pids() {
  for _dp_bin in "${TS_BIN_DIR}/dnsmasq" /system/bin/dnsmasq /vendor/bin/dnsmasq; do
    for _dp_pid in $(pids_of_path "${_dp_bin}"); do
      if _proc_cmdline "${_dp_pid}" | grep -qxF -- "--conf-file=${DNS_CONF}"; then
        echo "${_dp_pid}"
      fi
    done
  done
}

# The pinned Android tailscaled also installs its own UDP-only DNS rules.
# This is distinct from our optional local resolver (and lacks search domains).
native_dns_present() {
  iptables -t nat -C OUTPUT ! -o tun+ ! -d 100.100.100.100 -p udp --dport 53 -j DNAT --to-destination 100.100.100.100:53 2>/dev/null
}

# True when the installed coexistence probe finds a reachable DNS redirect.
# Contract: `foxytail.compat check-dns-hijack` exits 0 when the coast is
# clear, non-zero when someone else redirects/TProxys port 53.
dns_hijack_conflict() {
  command -v foxytail.compat >/dev/null 2>&1 || return 1
  ! foxytail.compat check-dns-hijack >/dev/null 2>&1
}

# Connmarks are separate from packet marks; never overwrite other connmark bits.
legacy_connmark_safe() {
  _lc_rules=
  for _lc_cmd in iptables ip6tables; do
    for _lc_table in raw mangle nat filter; do
      _lc_part=$("${_lc_cmd}" -t "${_lc_table}" -S 2>/dev/null) || {
        [ "${_lc_cmd}" = ip6tables ] && { [ "${IPV6}" != on ] || { [ "${_lc_table}" = nat ] && ! ipv6_nat_available; }; } && continue
        return 1
      }
      _lc_rules="${_lc_rules}
${_lc_part}"
    done
  done
  printf '%s\n' "${_lc_rules}" | awk '
    function number(s,n,i,c) {
      if(s ~ /^0[xX][0-9a-fA-F]+$/) {s=tolower(substr(s,3)); n=0; for(i=1;i<=length(s);i++) {c=index("0123456789abcdef",substr(s,i,1))-1; n=n*16+c}; return n}
      if(s ~ /^[0-9]+$/) return s+0
      return -1
    }
    function overlap(s,n) {n=number(s); return n<0 || int(n/536870912)%2==1}
    function mask(s,a,n) {n=split(s,a,"/"); return n!=2 || overlap(a[1]) || overlap(a[2])}
    $1=="-A" && $2=="FOXY_DNS" {next}
    /CONNMARK|connmark/ {
      known=0
      for(i=1;i<=NF;i++) {
        if($i=="--mark" || $i=="--set-mark" || $i=="--set-xmark") {known=1; if(mask($(i+1))) bad=1}
        if($i=="--or-mark" || $i=="--xor-mark") {known=1; if(overlap($(i+1))) bad=1}
        if($i=="--and-mark") {known=1; if(number($(i+1))<0 || !overlap($(i+1))) bad=1}
        if($i=="--save-mark" || $i=="--restore-mark") {known=1; cm="0xffffffff"; nf="0xffffffff"; for(j=1;j<NF;j++) {if($j=="--ctmask") cm=$(j+1); if($j=="--nfmask") nf=$(j+1)}; if(overlap(cm) || overlap(nf)) bad=1}
      }
      if(!known) bad=1
    }
    END {exit bad ? 1 : 0}'
}

legacy_capture_cleanup() {
  _lc_had_rules=false
  for _lc_cmd in iptables ip6tables; do
    "${_lc_cmd}" -t nat -S "${CHAIN_DNS}" >/dev/null 2>&1 && _lc_had_rules=true
  done
  _lc_cleanup_rc=0
  redirect_teardown || _lc_cleanup_rc=1
  redirect6_teardown || _lc_cleanup_rc=1
  [ "${_lc_cleanup_rc}" = 0 ] || return 1
  if [ "${_lc_had_rules}" != true ] && [ ! -s "${LEGACY_OWNERSHIP}" ] && [ ! -f "${DNS_CONF}" ] && [ -z "$(dns_pids)" ]; then return 0; fi
  if [ "${_lc_had_rules}" != true ] && [ ! -s "${LEGACY_OWNERSHIP}" ] &&
    [ "$(cat "${TS_RUN_DIR}/dnsmasq.local-only" 2>/dev/null)" = "$(sed -n 's/^port=//p' "${DNS_CONF}" 2>/dev/null)" ] &&
    [ -s "${TS_RUN_DIR}/dnsmasq.local-only" ]; then return 0; fi
  _lc_port=$(sed -n 's/^port=//p' "${DNS_CONF}" 2>/dev/null)
  if [ -s "${LEGACY_OWNERSHIP}" ]; then
    _lc_port=$(jqr -r '.port' "${LEGACY_OWNERSHIP}" 2>/dev/null) || return 1
  fi
  [ -n "${_lc_port}" ] || return 0
  case "${_lc_port}" in *[!0-9]*) return 1 ;; esac
  legacy_connmark_safe || { set_state degraded ownership-conflict; return 1; }
  mkdir -p "${TS_DIR}/state" || return 1
  tmo 12 "${TS_BIN_DIR}/foxydns" legacy-cleanup --journal "${LEGACY_OWNERSHIP}" --port "${_lc_port}" >/dev/null 2>&1 || {
    set_state degraded reconnect-needed; return 1;
  }
  printf '%s\n' "${_lc_port}" >"${TS_RUN_DIR}/dnsmasq.local-only" || return 1
}

legacy_upstream_snapshot() {
  _lu_snapshot=$(network_snapshot) || return 1
  printf '%s' "${_lu_snapshot}" | jqr -e -c 'select(.known == true) | {signature, dns:(.dns | map(select(type == "string" and test("^[0-9a-fA-F:.]+$") and . != "127.0.0.1" and . != "::1" and . != "100.100.100.100")))} | select(.dns | length > 0)'
}

legacy_upstream_matches() {
  _lu_now=$(legacy_upstream_snapshot) || return 1
  [ "$(cat "${LEGACY_NETWORK}" 2>/dev/null)" = "${_lu_now}" ]
}
# Mount FOXY_DNS (nat) on OUTPUT and redirect UDP/53 into dnsmasq. The first
# rules exempt dnsmasq and marked Tailscale upstream queries. ACCEPT ends nat
# traversal: RETURN would fall through to Android tailscaled's global DNAT.
# One implementation serves both families; <cmd> is iptables or ip6tables.
redirect_family_apply() {
  _dr_cmd="$1"
  "${_dr_cmd}" -t nat -N "${CHAIN_DNS}" 2>/dev/null
  while "${_dr_cmd}" -t nat -D "${CHAIN_DNS}" -m owner --uid-owner 9999 -j RETURN 2>/dev/null; do :; done
  "${_dr_cmd}" -t nat -C "${CHAIN_DNS}" -m owner --uid-owner 9999 -j RETURN 2>/dev/null && return 1
  for _dr_proto in udp tcp; do
    if ! "${_dr_cmd}" -t nat -C "${CHAIN_DNS}" -p "${_dr_proto}" --dport 53 -m owner --uid-owner 9999 -j ACCEPT 2>/dev/null; then
      "${_dr_cmd}" -t nat -I "${CHAIN_DNS}" 1 -p "${_dr_proto}" --dport 53 -m owner --uid-owner 9999 -j ACCEPT || return 1
    fi
    if ! "${_dr_cmd}" -t nat -C "${CHAIN_DNS}" -p "${_dr_proto}" --dport 53 -m mark ! --mark 0x0/0x1e000000 -j ACCEPT 2>/dev/null; then
      "${_dr_cmd}" -t nat -I "${CHAIN_DNS}" 1 -p "${_dr_proto}" --dport 53 -m mark ! --mark 0x0/0x1e000000 -j ACCEPT || return 1
    fi
    if ! "${_dr_cmd}" -t nat -C "${CHAIN_DNS}" -p "${_dr_proto}" --dport 53 -j CONNMARK --set-xmark 0x20000000/0x20000000 2>/dev/null; then
      "${_dr_cmd}" -t nat -A "${CHAIN_DNS}" -p "${_dr_proto}" --dport 53 -j CONNMARK --set-xmark 0x20000000/0x20000000 || return 1
    fi
    if ! "${_dr_cmd}" -t nat -C "${CHAIN_DNS}" -p "${_dr_proto}" --dport 53 -j REDIRECT --to-ports "${DNS_PORT}" 2>/dev/null; then
      "${_dr_cmd}" -t nat -A "${CHAIN_DNS}" -p "${_dr_proto}" --dport 53 -j REDIRECT --to-ports "${DNS_PORT}" ||
        { log Warning "failed to add DNS REDIRECT rule (${_dr_cmd})."; return 1; }
    fi
  done
  # Run before tailscaled's own DNAT, otherwise short queries skip dnsmasq.
  if [ "$("${_dr_cmd}" -t nat -S OUTPUT 2>/dev/null | awk '$1=="-A" {print; exit}')" != "-A OUTPUT -j ${CHAIN_DNS}" ]; then
    while "${_dr_cmd}" -t nat -D OUTPUT -j "${CHAIN_DNS}" 2>/dev/null; do :; done
    "${_dr_cmd}" -t nat -I OUTPUT 1 -j "${CHAIN_DNS}" ||
      { log Warning "failed to mount ${CHAIN_DNS} on ${_dr_cmd} nat/OUTPUT."; return 1; }
  fi
  return 0
}

redirect_family_teardown() {
  _dt_cmd="$1"
  while "${_dt_cmd}" -t nat -D OUTPUT -j "${CHAIN_DNS}" 2>/dev/null; do :; done
  "${_dt_cmd}" -t nat -F "${CHAIN_DNS}" 2>/dev/null
  "${_dt_cmd}" -t nat -X "${CHAIN_DNS}" 2>/dev/null
  "${_dt_cmd}" -t nat -C OUTPUT -j "${CHAIN_DNS}" 2>/dev/null && return 1
  "${_dt_cmd}" -t nat -S "${CHAIN_DNS}" >/dev/null 2>&1 && return 1
  return 0
}

redirect_apply() { redirect_family_apply iptables; }

redirect_teardown() { redirect_family_teardown iptables; }

redirect6_apply() { redirect_family_apply ip6tables; }

redirect6_teardown() { redirect_family_teardown ip6tables; }

# Android kernels can support IPv6 routing/filtering without an IPv6 nat
# table. DNS interception then remains useful over IPv4; this capability is
# separate from the user's IPv6 tunnel preference and may change at runtime.
ipv6_nat_available() {
  ip6tables -t nat -S OUTPUT >/dev/null 2>&1
}

# Search only OS module trees for the exact legacy IPv6 NAT module. Do not
# download modules, guess a different kernel build, or load similarly named
# IPv6 modules (for example 6LoWPAN compression modules).
ipv6_nat_module_dirs() {
  for _im_root in /system_dlkm/lib/modules /vendor_dlkm/lib/modules \
    /odm_dlkm/lib/modules /system/lib/modules /vendor/lib/modules \
    /odm/lib/modules "/lib/modules/$(uname -r)"; do
    [ ! -d "${_im_root}" ] || realpath "${_im_root}"
  done | sort -u | while IFS= read -r _im_dir; do
    if [ -n "$(find "${_im_dir}" -maxdepth 8 -type f \
      \( -name ip6table_nat.ko -o -name ip6table_nat.ko.xz \
      -o -name ip6table_nat.ko.gz -o -name ip6table_nat.ko.zst \) \
      -print 2>/dev/null | head -n 1)" ]; then
      printf '%s\n' "${_im_dir}"
    fi
  done
}

ipv6_module_boot() {
  cat /proc/sys/kernel/random/boot_id 2>/dev/null
}

ipv6_module_status() {
  _im_boot="" _im_status=""
  if [ -r "${TS_RUN_DIR}/dnsmasq.ipv6-module" ]; then
    read -r _im_boot _im_status <"${TS_RUN_DIR}/dnsmasq.ipv6-module" || :
  fi
  if [ -z "${_im_boot}" ] || [ "${_im_boot}" != "$(ipv6_module_boot)" ]; then
    echo not-checked
    return
  fi
  case "${_im_status}" in
    loaded|missing|load-failed|loader-unavailable|not-needed) echo "${_im_status}" ;;
    *) echo not-checked ;;
  esac
}

record_ipv6_module_status() {
  printf '%s %s\n' "$(ipv6_module_boot)" "$1" \
    >"${TS_RUN_DIR}/dnsmasq.ipv6-module"
}

load_ipv6_nat_module() {
  # Native Android modprobe resolves this tree's declared dependencies. The
  # kernel validates ABI/signatures; never use forced loads or direct insmod.
  command -v timeout >/dev/null 2>&1 || return 127
  for _im_loader in /system/bin/modprobe /vendor/bin/modprobe /sbin/modprobe; do
    [ -x "${_im_loader}" ] || continue
    timeout "${2:-3}" "${_im_loader}" -d "$1" ip6table_nat >/dev/null 2>&1
    return $?
  done
  return 127
}

# Mutation-only capability upgrade. Status/check calls never load modules.
# Rechecking the actual table, rather than trusting modprobe's exit status,
# handles missing dependencies, ABI mismatches and a concurrently loaded module.
ensure_ipv6_nat() {
  [ "${IPV6}" = on ] || return 1
  if ipv6_nat_available; then
    [ "$(ipv6_module_status)" = loaded ] || record_ipv6_module_status not-needed
    return 0
  fi
  _im_dirs=$(ipv6_nat_module_dirs)
  if [ -z "${_im_dirs}" ]; then record_ipv6_module_status missing; return 1; fi
  _im_failure=load-failed
  _im_deadline=$(($(date +%s) + 6))
  for _im_dir in ${_im_dirs}; do
    _im_remaining=$((_im_deadline - $(date +%s)))
    [ "${_im_remaining}" -gt 0 ] || break
    [ "${_im_remaining}" -le 3 ] || _im_remaining=3
    load_ipv6_nat_module "${_im_dir}" "${_im_remaining}"
    _im_rc=$?
    if ipv6_nat_available; then
      record_ipv6_module_status loaded
      log Info "IPv6 DNS interception enabled with the system ip6table_nat module."
      return 0
    fi
    [ "${_im_rc}" != 127 ] || _im_failure=loader-unavailable
  done
  record_ipv6_module_status "${_im_failure}"
  return 1
}

# Reconcile redirect independently from process liveness. A running dnsmasq
# without interception remains degraded and can recover on the next start.
reconcile_redirect() {
  if dns_hijack_conflict; then
    _dr_cleanup=0
    legacy_capture_cleanup || _dr_cleanup=1
    log Warning "another tool hijacks DNS; local resolver runs without interception"
    [ "${_dr_cleanup}" != 0 ] || set_state degraded conflict
    return "${_dr_cleanup}"
  fi
  if ! legacy_upstream_matches || ! legacy_connmark_safe ||
    ! tmo 12 "${TS_BIN_DIR}/foxydns" legacy-claim --journal "${LEGACY_OWNERSHIP}" --port "${DNS_PORT}" >/dev/null 2>&1; then
    legacy_capture_cleanup || return 1
    set_state degraded ownership-unavailable
    return 0
  fi
  rm -f "${TS_RUN_DIR}/dnsmasq.local-only" || return 1
  # Rebuild incomplete/pre-upgrade chains so marking cannot land after REDIRECT.
  if ! redirect_present; then redirect_teardown && redirect6_teardown || return 1; fi
  _dr_v6=off
  if [ "${IPV6}" = on ] && ensure_ipv6_nat; then _dr_v6=on; fi
  if ! redirect_apply || { [ "${_dr_v6}" = on ] && ! redirect6_apply; }; then
    legacy_capture_cleanup || return 1
    set_state degraded redirect-failed
    return 1
  fi
  if [ "${_dr_v6}" != on ] && ! redirect6_teardown; then
    set_state degraded cleanup-failed
    return 1
  fi
  _dr_reason=running
  if [ "${IPV6}" = on ] && [ "${_dr_v6}" != on ]; then _dr_reason=ipv6-unavailable; fi
  # DoT configured by Android bypasses port 53; report it without changing
  # the user's encrypted DNS policy or repeatedly restarting a healthy daemon.
  [ "$(settings get global private_dns_mode 2>/dev/null)" = hostname ] && _dr_reason=private-dns
  set_state running "${_dr_reason}"
}

redirect_present() {
  for _dp_cmd in iptables ip6tables; do
    if [ "${_dp_cmd}" = ip6tables ]; then
      [ "${IPV6}" = on ] && ipv6_nat_available || continue
    fi
    "${_dp_cmd}" -t nat -C OUTPUT -j "${CHAIN_DNS}" 2>/dev/null || return 1
    [ "$("${_dp_cmd}" -t nat -S OUTPUT 2>/dev/null | awk '$1=="-A" {print; exit}')" = "-A OUTPUT -j ${CHAIN_DNS}" ] || return 1
    for _dp_proto in udp tcp; do
      "${_dp_cmd}" -t nat -C "${CHAIN_DNS}" -p "${_dp_proto}" --dport 53 -m owner --uid-owner 9999 -j ACCEPT 2>/dev/null || return 1
      "${_dp_cmd}" -t nat -C "${CHAIN_DNS}" -p "${_dp_proto}" --dport 53 -m mark ! --mark 0x0/0x1e000000 -j ACCEPT 2>/dev/null || return 1
      "${_dp_cmd}" -t nat -C "${CHAIN_DNS}" -p "${_dp_proto}" --dport 53 -j CONNMARK --set-xmark 0x20000000/0x20000000 2>/dev/null || return 1
      "${_dp_cmd}" -t nat -C "${CHAIN_DNS}" -p "${_dp_proto}" --dport 53 -j REDIRECT --to-ports "${DNS_PORT}" 2>/dev/null || return 1
      "${_dp_cmd}" -t nat -S "${CHAIN_DNS}" 2>/dev/null | awk -v chain="${CHAIN_DNS}" -v proto="${_dp_proto}" -v port="${DNS_PORT}" '
        {gsub(/ -m (udp|tcp)/, "")}
        $0=="-A " chain " -p " proto " --dport 53 -j REDIRECT --to-ports " port {
          if(previous!="-A " chain " -p " proto " --dport 53 -j CONNMARK --set-xmark 0x20000000/0x20000000") bad=1
          found=1
        }
        {previous=$0}
        END {exit (!found || bad) ? 1 : 0}' || return 1
    done
  done
}

# A live resolver is useful only for the currently selected account/tailnet.
# Keep the observed context as JSON data; suffixes are validated before they
# are written to dnsmasq configuration. An unreachable daemon is not ready.
current_dns_context() {
  _dc_json=$(ts_status_json tmo 5 tailscale --socket="${TS_SOCKET}" status --json 2>/dev/null) || return 1
  printf '%s' "${_dc_json}" | jqr -e -c '
    select(.CurrentTailnet.MagicDNSEnabled == true)
    | (.MagicDNSSuffix // "" | ascii_downcase) as $suffix
    | select($suffix | test("^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"))
    | {suffix:$suffix,tailnet:(.CurrentTailnet.Name // ""),self:(.Self.ID // ""),
       hosts:([.Self, ((.Peer // {}) | .[])]
        | map(select(. != null)
          | (.DNSName // "" | ascii_downcase | rtrimstr(".")) as $name
          | select($name | endswith("." + $suffix))
          | ($name | rtrimstr("." + $suffix)) as $short
          | select($short | test("^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"))
          | .TailscaleIPs[]? | select(test("^[0-9a-fA-F:.]+$"))
          | {ip:.,name:$name,short:$short}) | unique | sort_by(.name,.ip))}' 2>/dev/null
}

dns_context_matches() {
  [ -f "${DNS_CONTEXT_FILE}" ] &&
    [ "$(cat "${DNS_CONTEXT_FILE}" 2>/dev/null)" = "$1" ] &&
    [ "$(awk -F/ '/^server=\// {print $2; exit}' "${DNS_CONF}" 2>/dev/null)" = "$(printf '%s' "$1" | jqr -r '.suffix')" ] &&
    ! grep -q '^address=' "${DNS_CONF}" 2>/dev/null &&
    [ "$(sed -n 's/^addn-hosts=//p' "${DNS_CONF}" 2>/dev/null)" = "${DNS_HOSTS}" ] &&
    dns_hosts_dir_safe && [ -f "${DNS_HOSTS}" ] && [ ! -L "${DNS_HOSTS}" ] &&
    [ "$(stat -c '%u:%a' "${DNS_HOSTS}" 2>/dev/null)" = "$(id -u):644" ] &&
    [ "$(cat "${DNS_HOSTS}" 2>/dev/null)" = "$(dns_alias_lines "$1")" ]
}

dns_alias_lines() {
  # Some Android tailscaled builds omit AAAA answers for otherwise reachable
  # peers. Hosts-file records match exact names, unlike address= suffix rules.
  printf '%s' "$1" | jqr -r '.hosts[] | "\(.ip) \(.short) \(.name)"'
}

# Android dnsmasq 2.51 supports addn-hosts, but reads it after dropping root.
# Keep only these mappings outside /data/adb; never relax its mode.
dns_hosts_dir_safe() {
  [ ! -L "${DNS_HOSTS_DIR}" ] && [ -d "${DNS_HOSTS_DIR}" ] &&
    [ "$(stat -c '%u:%a' "${DNS_HOSTS_DIR}" 2>/dev/null)" = "$(id -u):755" ]
}

write_dns_hosts() {
  if [ ! -e "${DNS_HOSTS_DIR}" ] && [ ! -L "${DNS_HOSTS_DIR}" ]; then
    (umask 022; mkdir "${DNS_HOSTS_DIR}") || return 1
  fi
  dns_hosts_dir_safe || return 1
  [ ! -L "${DNS_HOSTS}" ] || return 1
  [ ! -e "${DNS_HOSTS}" ] || [ -f "${DNS_HOSTS}" ] || return 1
  _dh_next=$(mktemp "${DNS_HOSTS_DIR}/.hosts.XXXXXX") || return 1
  if dns_alias_lines "$1" >"${_dh_next}" && chmod 0644 "${_dh_next}" &&
    mv -f "${_dh_next}" "${DNS_HOSTS}"; then
    return 0
  fi
  rm -f "${_dh_next}"
  return 1
}

remove_dns_hosts() {
  [ -e "${DNS_HOSTS_DIR}" ] || [ -L "${DNS_HOSTS_DIR}" ] || return 0
  dns_hosts_dir_safe || return 1
  [ ! -L "${DNS_HOSTS}" ] || return 1
  [ ! -e "${DNS_HOSTS}" ] || [ -f "${DNS_HOSTS}" ] || return 1
  rm -f "${DNS_HOSTS}" || return 1
  # A killed publisher may leave its private mktemp file behind. Only remove
  # regular files matching our staging name, owner and creation/public mode.
  for _dh_stale in "${DNS_HOSTS_DIR}"/.hosts.??????; do
    [ ! -L "${_dh_stale}" ] && [ -f "${_dh_stale}" ] || continue
    case "$(stat -c '%u:%a' "${_dh_stale}" 2>/dev/null)" in
      "$(id -u):600"|"$(id -u):644") rm -f "${_dh_stale}" || return 1 ;;
    esac
  done
  # Unrelated entries must remain untouched, but an unused directory cannot
  # make successful listener/rule cleanup permanently fail.
  rmdir "${DNS_HOSTS_DIR}" 2>/dev/null || :
}

# Android caches NXDOMAIN independently of dnsmasq. A newly enabled resolver
# or changed peer mapping must invalidate those stale answers once. Transaction
# 11 is flushNetworkCache in the verified frozen IDnsResolver AIDL versions
# 4..15 (versions 1..3 do not expose it). Unknown versions are never guessed.
# https://android.googlesource.com/platform/packages/modules/DnsResolver/+/refs/heads/main/aidl_api/dnsresolver_aidl_interface/
flush_android_dns_cache() {
  _fc_status="${TS_RUN_DIR}/dnsmasq.cache-status"
  if ! command -v service >/dev/null 2>&1 || ! command -v dumpsys >/dev/null 2>&1 ||
    ! service list 2>/dev/null | grep -qF 'dnsresolver: [android.net.IDnsResolver]'; then
    echo unavailable >"${_fc_status}"
    log Warning "local DNS is active; Android cache refresh is unavailable, cached failures may persist"
    return 1
  fi
  _fc_version=$(service call dnsresolver 16777215 2>/dev/null |
    awk '$1=="Result:" && $2=="Parcel(" && $3=="00000000" {print $4; exit}')
  case "${_fc_version}" in
    00000004|00000005|00000006|00000007|00000008|00000009|0000000a|0000000b|0000000c|0000000d|0000000e|0000000f) ;;
    *)
      printf 'unsupported-version:%s\n' "${_fc_version:-unknown}" >"${_fc_status}"
      log Warning "local DNS is active; cache refresh skipped for unverified IDnsResolver version ${_fc_version:-unknown}"
      return 1
      ;;
  esac
  _fc_nets=$(dumpsys dnsresolver 2>/dev/null | awk '$1=="NetId:" && $2~/^[0-9]+$/ {print $2}' | sort -nu)
  _fc_count=0
  _fc_failed=0
  for _fc_net in ${_fc_nets}; do
    [ "${_fc_net}" -ge 1 ] && [ "${_fc_net}" -le 65535 ] || continue
    # Only invalidate this existing network cache. Never recreate it or change
    # DNS servers, search domains, Private DNS, interfaces, or routes.
    _fc_reply=$(service call dnsresolver 11 i32 "${_fc_net}" 2>/dev/null)
    if printf '%s\n' "${_fc_reply}" | grep -Eq '^Result: Parcel\([[:space:]]*00000000([[:space:]]|$)'; then
      _fc_count=$((_fc_count + 1))
    else
      _fc_failed=1
    fi
  done
  if [ "${_fc_failed}" = 0 ] && [ "${_fc_count}" -gt 0 ]; then
    printf 'flushed:%s\n' "${_fc_count}" >"${_fc_status}"
    return 0
  fi
  echo failed >"${_fc_status}"
  log Warning "local DNS is active; Android cache refresh did not complete, cached failures may persist"
  return 1
}

dns_start() {
  ensure_run_dirs
  load_runtime_conf || return 1
  if [ "${DNS_MODE:-legacy}" != legacy ]; then
    [ "${MAGIC_DNS}" = on ] || { dns_stop; return $?; }
    modern_dns_start
    return $?
  fi
  if command -v modern_dns_stop >/dev/null 2>&1 &&
    { [ -e "${MODERN_CONF}" ] || [ -e "${MODERN_STATE}" ] || [ -e "${MODERN_JOURNAL}" ]; }; then
    modern_dns_stop || return 1
  fi
  select_dns_binary || :

  if [ "${MAGIC_DNS}" != "on" ]; then
    log Debug "MAGIC_DNS=off; split DNS disabled."
    dns_stop
    return $?
  fi

  _ds_context=$(current_dns_context)
  if [ -z "${_ds_context}" ]; then
    log Warning "current tailnet MagicDNS is unavailable; removing stale resolver state"
    dns_stop || { set_state degraded; return 1; }
    set_state degraded tailnet-unavailable
    return 0
  fi
  _ds_suffix=$(printf '%s' "${_ds_context}" | jqr -r '.suffix')

  if [ -n "$(dns_pids)" ]; then
    _ds_config_v6=off
    grep -q '^listen-address=::1$' "${DNS_CONF}" 2>/dev/null && _ds_config_v6=on
    if [ "$(sed -n 's/^port=//p' "${DNS_CONF}" 2>/dev/null)" = "${DNS_PORT}" ] &&
      [ "${_ds_config_v6}" = "${IPV6}" ] && dns_context_matches "${_ds_context}" && legacy_upstream_matches; then
      log Info "dnsmasq is already running; reconciling DNS interception."
      _ds_redirect_ready=false
      [ "$(get_state)" = running ] && redirect_present && _ds_redirect_ready=true
      reconcile_redirect
      _ds_redirect_rc=$?
      if [ "${_ds_redirect_rc}" = 0 ] && [ "$(get_state)" = running ] && [ "${_ds_redirect_ready}" != true ]; then
        flush_android_dns_cache || :
      fi
      return "${_ds_redirect_rc}"
    fi
    dns_stop || return 1
  fi

  if [ -z "${DNS_BIN}" ]; then
    log Warning "dnsmasq not found in the module or system; local MagicDNS resolver unavailable."
    set_state degraded missing-binary
    return 0
  fi
  legacy_capture_cleanup || return 1

  _ds_network=$(legacy_upstream_snapshot) || _ds_network='{"signature":"unknown","dns":[]}'
  _ds_default_dns=$(printf '%s' "${_ds_network}" | jqr -r '.dns[]')
  mkdir -p "${TS_DIR}/state" || return 1
  write_dns_hosts "${_ds_context}" || { set_state degraded hosts-failed; return 1; }

  {
    echo "port=${DNS_PORT}"
    echo "listen-address=127.0.0.1"
    [ "${IPV6}" = "on" ] && echo "listen-address=::1"
    echo "bind-interfaces"
    echo "no-resolv"
    echo "cache-size=512"
    # Exact records remain readable after dnsmasq drops to nobody, including
    # on Android's older 2.51 build which does not support host-record=.
    echo "addn-hosts=${DNS_HOSTS}"
    echo "server=/${_ds_suffix}/100.100.100.100"
    for _ds_upstream in ${_ds_default_dns}; do printf 'server=%s\n' "${_ds_upstream}"; done
  } >"${DNS_CONF}"
  chmod 0644 "${DNS_CONF}"
  printf '%s\n' "${_ds_network}" >"${LEGACY_NETWORK}" || return 1
  printf '%s\n' "${DNS_PORT}" >"${TS_RUN_DIR}/dnsmasq.local-only" || return 1

  rotate_log "${DNS_LOG}"
  log Info "Starting dnsmasq on 127.0.0.1:${DNS_PORT} (suffix: ${_ds_suffix}, upstream: ${_ds_default_dns})."
  nohup "${DNS_BIN}" --keep-in-foreground --conf-file="${DNS_CONF}" \
    --user=nobody >>"${DNS_LOG}" 2>&1 &

  sleep 1
  if [ -z "$(dns_pids)" ]; then
    log Warning "dnsmasq failed to start; see ${DNS_LOG}. MagicDNS degraded."
    set_state degraded process-failed
    return 0
  fi

  printf '%s\n' "${_ds_context}" >"${DNS_CONTEXT_FILE}" || { set_state degraded; return 1; }
  reconcile_redirect || return 1
  [ "$(get_state)" = running ] || return 0

  # This is after a new configuration/process is ready. The unchanged-process
  # fast path above does not flush caches on every watchdog reconciliation.
  flush_android_dns_cache || :

  log Success "MagicDNS split resolver is up."
  return 0
}

dns_stop() {
  ensure_run_dirs
  # Cleanup uses fixed chain names and the owned process path, not desired config.

  _dt_rc=0
  if command -v modern_dns_stop >/dev/null 2>&1; then
    modern_dns_stop || _dt_rc=1
  fi
  # Only the legacy redirects decide whether it is safe to stop this listener.
  # An unrelated modern cleanup failure must not keep legacy dnsmasq alive.
  _dt_legacy_rc=0
  legacy_capture_cleanup || _dt_legacy_rc=1
  if [ "${_dt_legacy_rc}" = 0 ]; then
    _dt_pids=$(dns_pids)
    if [ -n "${_dt_pids}" ]; then
      stop_by_pids dnsmasq "${_dt_pids}" || _dt_rc=1
    fi
    [ -z "$(dns_pids)" ] || _dt_rc=1
  else
    _dt_rc=1
  fi
  if [ "${_dt_rc}" = 0 ]; then remove_dns_hosts || _dt_rc=1; fi
  if [ "${_dt_rc}" = 0 ]; then
    rm -f "${DNS_CONTEXT_FILE}"
    set_state stopped
  else
    log Error "DNS cleanup incomplete; retaining degraded state for retry"
    [ "$(cat "${DNS_REASON_FILE}" 2>/dev/null)" = reconnect-needed ] || set_state degraded cleanup-failed
  fi
  return "${_dt_rc}"
}

dns_status() {
  ensure_run_dirs
  load_runtime_conf || return 1
  if [ "${DNS_MODE:-legacy}" != legacy ] ||
    { command -v modern_runtime_active >/dev/null 2>&1 && modern_runtime_active; }; then
    modern_dns_status "$1"
    return $?
  fi
  select_dns_binary || :

  _dst_json=false
  [ "${1:-}" = "--json" ] && _dst_json=true

  _dst_state=$(get_state)
  _dst_reason=$(cat "${DNS_REASON_FILE}" 2>/dev/null)
  _dst_pids=$(dns_pids)
  if [ -n "${_dst_pids}" ]; then
    _dst_context=$(current_dns_context)
    if [ "${_dst_state}" != running ] || [ -z "${_dst_context}" ] ||
      ! dns_context_matches "${_dst_context}" || ! legacy_upstream_matches || ! redirect_present || ! legacy_connmark_safe || dns_hijack_conflict; then
      _dst_state=degraded
      case "${_dst_reason}" in reconnect-needed|ownership-conflict|ownership-unavailable|cleanup-failed) ;; *) _dst_reason=reconcile-needed ;; esac
    fi
  elif [ "${_dst_state}" = "running" ]; then
    # An unexpectedly dead resolver may leave interception in place.
    _dst_state="degraded"
    _dst_reason=process-failed
  fi
  if [ "${_dst_state}" = running ]; then
    # Reflect current kernel capability even if it changed since start. A
    # recovered nat table without our IPv6 rules fails redirect_present above
    # and schedules reconciliation; an absent table never erases working IPv4.
    _dst_reason=running
    if [ "${IPV6}" = on ] && ! ipv6_nat_available; then _dst_reason=ipv6-unavailable; fi
    [ "$(settings get global private_dns_mode 2>/dev/null)" = hostname ] && _dst_reason=private-dns
  fi

  _dst_enabled=false
  if [ "${MAGIC_DNS}" = on ]; then
    _dst_enabled=true
    if [ -z "${_dst_pids}" ] && [ "${_dst_state}" = stopped ]; then _dst_reason=apply-pending; fi
  elif [ -z "${_dst_pids}" ]; then
    _dst_reason=disabled
  else
    _dst_reason=disable-pending
  fi
  _dst_native=false
  native_dns_present && _dst_native=true

  _dst_v6=disabled
  _dst_module=$(ipv6_module_status)
  if [ "${IPV6}" = on ]; then
    _dst_v6=fallback
    if ipv6_nat_available; then
      _dst_v6=available
      [ "${_dst_module}" != loaded ] || _dst_v6=module-loaded
    fi
  fi

  _dst_pid=null
  if [ -n "${_dst_pids}" ]; then
    # shellcheck disable=SC2086 # intentional: one PID per word
    set -- ${_dst_pids}
    _dst_pid="$1"
  fi

  _dst_suffix=""
  if [ -f "${DNS_CONF}" ]; then
    _dst_suffix=$(awk -F/ '/^server=\// {print $2}' "${DNS_CONF}" | head -1)
  fi

  # Machine-readable form for foxytail.webapi.sh (`status --json`). Include
  # the cached transparent-mode capability even in legacy mode so the
  # settings page can grey out the choice before the user switches away.
  if [ "${_dst_json}" = true ]; then
    _dst_ta=null; _dst_ta_reason=
    _dst_ta_cache=$(modern_cached_capabilities 2>/dev/null)
    if [ -n "${_dst_ta_cache}" ]; then
      if [ "$(printf '%s' "${_dst_ta_cache}" | jqr -r '.ok')" = true ]; then
        _dst_ta=true
      else
        _dst_ta=false
        _dst_ta_reason=$(printf '%s' "${_dst_ta_cache}" | jqr -r '.error | select(type == "string" and length > 0) | gsub("[[:cntrl:]]";" ") | .[0:512]' 2>/dev/null)
      fi
    fi
    jqr -n -c --arg s "${_dst_state}" --arg sfx "${_dst_suffix}" \
      --argjson p "${DNS_PORT}" --argjson pid "${_dst_pid}" \
      --argjson enabled "${_dst_enabled}" --arg reason "${_dst_reason}" \
      --arg binary "${DNS_BIN}" --argjson native "${_dst_native}" \
      --arg v6 "${_dst_v6}" --arg module "${_dst_module}" \
      --argjson ta "${_dst_ta}" --arg taReason "${_dst_ta_reason}" \
      '{state:$s,suffix:$sfx,port:$p,pid:$pid,enabled:$enabled,reason:$reason,
        binary:(if $binary=="" then null else $binary end),upstreamNative:$native,
        transparentAvailable:$ta,transparentUnavailableReason:(if $taReason=="" then null else $taReason end),
        ipv6DnsInterception:$v6,ipv6ModuleStatus:$module}'
    return 0
  fi

  case "${_dst_state}" in
    running) _dst_color="${green}" ;;
    degraded) _dst_color="${yellow}" ;;
    *) _dst_color="${red}" ;;
  esac
  printf '%s\n' "${blue}MagicDNS:${normal} ${_dst_color}${_dst_state}${normal}  ${blue}Port:${normal} ${yellow}${DNS_PORT}${normal}"

  if iptables -t nat -L "${CHAIN_DNS}" -n >/dev/null 2>&1; then
    printf '%s\n' "  ${blue}Redirect:${normal} ${green}UDP/53 -> ${DNS_PORT} active (${CHAIN_DNS})${normal}"
  else
    printf '%s\n' "  ${blue}Redirect:${normal} ${red}inactive${normal}"
  fi

  [ -n "${_dst_suffix}" ] && printf '%s\n' "  ${blue}Suffix:${normal} ${yellow}${_dst_suffix}${normal}"
  return 0
}

usage() {
  printf '%s\n' "${yellow}usage${normal}: ${green}${scripts_name}${normal} {${orange}start|stop|status${normal}}"
}

case "$1" in
  guard)
    modern_dns_guard
    ;;
  start)
    dns_start
    ;;
  stop)
    dns_stop
    ;;
  status)
    dns_status "$2"
    ;;
  probe-transparent)
    # Cache the transparent-mode capability probe regardless of whether
    # MagicDNS is currently running; the settings page uses this to grey out
    # the transparent choice before the user commits to it.
    if command -v modern_probe_capabilities >/dev/null 2>&1; then
      modern_probe_capabilities
    else
      echo "modern DNS controller unavailable" >&2
      exit 1
    fi
    ;;
  *)
    if [ -n "$1" ]; then
      printf '%s\n' "${yellow}${scripts_name} ${orange}$1 ${red}not found${normal}"
      exit 1
    fi
    usage
    ;;
esac
