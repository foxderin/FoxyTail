#!/system/bin/sh
# FoxyTail MagicDNS Split Resolver
#
# Split-DNS via a local dnsmasq: tailnet names go to 100.100.100.100,
# everything else to the system resolver. Coexistence-aware.
#
# Subcommands:
#   start   Start dnsmasq split-DNS and the port-53 redirect. Requires
#           MAGIC_DNS=on, a dnsmasq binary in $TS_BIN_DIR and MagicDNS
#           enabled on the tailnet. Reads .MagicDNSSuffix from
#           `tailscale --socket=... status --json`. If any prerequisite fails
#           the script logs a Warning, records state "degraded" and exits 0.
#           If `foxytail.compat check-dns-hijack` reports a conflicting global
#           DNS hijack (non-zero exit), the REDIRECT rule is skipped and only
#           dnsmasq runs.
#   stop    Remove the redirect chain and stop dnsmasq.
#   status  Show running / degraded / stopped state. `status --json` prints
#           the machine-readable form {"state","suffix","port","pid"} for
#           foxytail.webapi.sh.

# POSIX sh (Android mksh / busybox). No bashisms, no `set -e`.

DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "${DIR}/../settings.sh"

scripts_name=$(basename "$0")
TS_SOCKET="${TS_RUN_DIR}/tailscaled.sock"
DNS_BIN="${TS_BIN_DIR}/dnsmasq"
DNS_CONF="${TS_RUN_DIR}/dnsmasq.conf"
DNS_LOG="${TS_RUN_DIR}/dnsmasq.log"
PID_FILE="${TS_PID_DIR}/dnsmasq.pid"
DNS_STATE_FILE="${TS_RUN_DIR}/dnsmasq.state"
CHAIN_DNS="FOXY_DNS"

set_state() {
  echo "$1" >"${DNS_STATE_FILE}"
}

get_state() {
  cat "${DNS_STATE_FILE}" 2>/dev/null || echo "stopped"
}

# PIDs of OUR dnsmasq instance only: argv[0] must be the binary under
# $TS_BIN_DIR (or its bare name) and the cmdline must reference our config.
dns_pids() {
  for _dp_pid in $(pids_of_path "${DNS_BIN}"); do
    if tr '\0' ' ' <"/proc/${_dp_pid}/cmdline" 2>/dev/null | grep -qF "${DNS_CONF}"; then
      echo "${_dp_pid}"
    fi
  done
}

# True when another module already hijacks port 53 globally; the compat
# probe is optional (written in a later wave) and only consulted if present.
# Contract: `foxytail.compat check-dns-hijack` exits 0 when the coast is
# clear, non-zero when someone else redirects/TProxys UDP/53.
dns_hijack_conflict() {
  command -v foxytail.compat >/dev/null 2>&1 || return 1
  ! foxytail.compat check-dns-hijack >/dev/null 2>&1
}

# Mount FOXY_DNS (nat) on OUTPUT and redirect UDP/53 into dnsmasq. The first
# rule exempts dnsmasq's own upstream queries (it runs as AID_NOBODY=9999, see
# --user=nobody below) so they are not redirected back into dnsmasq itself.
redirect_apply() {
  iptables -t nat -N "${CHAIN_DNS}" 2>/dev/null
  if ! iptables -t nat -C "${CHAIN_DNS}" -m owner --uid-owner 9999 -j RETURN 2>/dev/null; then
    iptables -t nat -I "${CHAIN_DNS}" 1 -m owner --uid-owner 9999 -j RETURN ||
      { log Warning "failed to add dnsmasq owner exemption to ${CHAIN_DNS}."; return 1; }
  fi
  if ! iptables -t nat -C "${CHAIN_DNS}" -p udp --dport 53 -j REDIRECT --to-ports "${DNS_PORT}" 2>/dev/null; then
    iptables -t nat -A "${CHAIN_DNS}" -p udp --dport 53 -j REDIRECT --to-ports "${DNS_PORT}" ||
      { log Warning "failed to add DNS REDIRECT rule."; return 1; }
  fi
  if ! iptables -t nat -C OUTPUT -j "${CHAIN_DNS}" 2>/dev/null; then
    iptables -t nat -A OUTPUT -j "${CHAIN_DNS}" ||
      { log Warning "failed to mount ${CHAIN_DNS} on nat/OUTPUT."; return 1; }
  fi
  return 0
}

redirect_teardown() {
  while iptables -t nat -D OUTPUT -j "${CHAIN_DNS}" 2>/dev/null; do :; done
  iptables -t nat -F "${CHAIN_DNS}" 2>/dev/null
  iptables -t nat -X "${CHAIN_DNS}" 2>/dev/null
  return 0
}

redirect6_apply() {
  ip6tables -t nat -N "${CHAIN_DNS}" 2>/dev/null
  if ! ip6tables -t nat -C "${CHAIN_DNS}" -m owner --uid-owner 9999 -j RETURN 2>/dev/null; then
    ip6tables -t nat -I "${CHAIN_DNS}" 1 -m owner --uid-owner 9999 -j RETURN ||
      { log Warning "failed to add v6 dnsmasq owner exemption to ${CHAIN_DNS}."; return 1; }
  fi
  if ! ip6tables -t nat -C "${CHAIN_DNS}" -p udp --dport 53 -j REDIRECT --to-ports "${DNS_PORT}" 2>/dev/null; then
    ip6tables -t nat -A "${CHAIN_DNS}" -p udp --dport 53 -j REDIRECT --to-ports "${DNS_PORT}" ||
      { log Warning "failed to add v6 DNS REDIRECT rule."; return 1; }
  fi
  if ! ip6tables -t nat -C OUTPUT -j "${CHAIN_DNS}" 2>/dev/null; then
    ip6tables -t nat -A OUTPUT -j "${CHAIN_DNS}" ||
      { log Warning "failed to mount ${CHAIN_DNS} on ip6tables nat/OUTPUT."; return 1; }
  fi
  return 0
}

redirect6_teardown() {
  while ip6tables -t nat -D OUTPUT -j "${CHAIN_DNS}" 2>/dev/null; do :; done
  ip6tables -t nat -F "${CHAIN_DNS}" 2>/dev/null
  ip6tables -t nat -X "${CHAIN_DNS}" 2>/dev/null
  return 0
}

dns_start() {
  ensure_run_dirs
  load_conf

  if [ "${MAGIC_DNS}" != "on" ]; then
    log Debug "MAGIC_DNS=off; split DNS disabled."
    set_state stopped
    return 0
  fi

  if [ -n "$(dns_pids)" ]; then
    log Info "dnsmasq (FoxyTail) is already running."
    set_state running
    return 0
  fi

  if [ ! -x "${DNS_BIN}" ]; then
    log Warning "dnsmasq binary not found at ${DNS_BIN}; MagicDNS degraded."
    set_state degraded
    return 0
  fi

  _ds_json=$(timeout 10 tailscale --socket="${TS_SOCKET}" status --json 2>/dev/null || echo '{}')
  _ds_suffix=$(echo "${_ds_json}" | jqr -r '.MagicDNSSuffix // empty' 2>/dev/null)
  _ds_enabled=$(echo "${_ds_json}" | jqr -r '.CurrentTailnet.MagicDNSEnabled // false' 2>/dev/null)
  if [ "${_ds_enabled}" != "true" ] || [ -z "${_ds_suffix}" ]; then
    log Warning "MagicDNS not enabled on this tailnet (or daemon unreachable); split DNS degraded."
    set_state degraded
    return 0
  fi

  _ds_default_dns=$(getprop net.dns1 2>/dev/null)
  [ -z "${_ds_default_dns}" ] && _ds_default_dns="1.1.1.1"

  {
    echo "port=${DNS_PORT}"
    echo "listen-address=127.0.0.1"
    [ "${IPV6}" = "on" ] && echo "listen-address=::1"
    echo "bind-interfaces"
    echo "no-resolv"
    echo "cache-size=512"
    echo "server=/${_ds_suffix}/100.100.100.100"
    echo "server=${_ds_default_dns}"
  } >"${DNS_CONF}"
  chmod 0644 "${DNS_CONF}"

  rotate_log "${DNS_LOG}"
  log Info "Starting dnsmasq on 127.0.0.1:${DNS_PORT} (suffix: ${_ds_suffix}, upstream: ${_ds_default_dns})."
  nohup "${DNS_BIN}" --keep-in-foreground --conf-file="${DNS_CONF}" \
    --pid-file="${PID_FILE}" --user=nobody >>"${DNS_LOG}" 2>&1 &

  sleep 1
  if [ -z "$(dns_pids)" ]; then
    log Warning "dnsmasq failed to start; see ${DNS_LOG}. MagicDNS degraded."
    set_state degraded
    return 0
  fi

  if dns_hijack_conflict; then
    log Warning "another module already hijacks UDP/53; skipping REDIRECT (dnsmasq still running on ${DNS_PORT})."
  else
    _ds_redir=1
    redirect_apply || _ds_redir=0
    if [ "${IPV6}" = "on" ]; then
      redirect6_apply || _ds_redir=0
    fi
    if [ "${_ds_redir}" != 1 ]; then
      log Error "DNS REDIRECT installation failed; MagicDNS degraded."
      set_state degraded
      return 1
    fi
  fi

  set_state running
  log Success "MagicDNS split resolver is up."
  return 0
}

dns_stop() {
  ensure_run_dirs
  load_conf

  redirect_teardown
  redirect6_teardown

  _dt_rc=0
  _dt_pids=$(dns_pids)
  if [ -n "${_dt_pids}" ]; then
    stop_by_pids dnsmasq "${_dt_pids}" || _dt_rc=1
  fi

  rm -f "${PID_FILE}"
  set_state stopped
  return "${_dt_rc}"
}

dns_status() {
  ensure_run_dirs
  load_conf

  _dst_json=false
  [ "${1:-}" = "--json" ] && _dst_json=true

  _dst_state=$(get_state)
  _dst_pids=$(dns_pids)
  if [ -n "${_dst_pids}" ]; then
    _dst_state="running"
  elif [ "${_dst_state}" = "running" ]; then
    _dst_state="stopped"
  fi

  _dst_pid=null
  if [ -n "${_dst_pids}" ]; then
    # shellcheck disable=SC2086 # intentional: one PID per word
    set -- ${_dst_pids}
    _dst_pid="$1"
  fi

  _dst_suffix=""
  if [ -f "${DNS_CONF}" ]; then
    _dst_suffix=$(awk -F/ '/^server=\// {print $2}' "${DNS_CONF}" | head -1)
  fi

  # Machine-readable form for foxytail.webapi.sh (`status --json`).
  if [ "${_dst_json}" = true ]; then
    jqr -n -c --arg s "${_dst_state}" --arg sfx "${_dst_suffix}" \
      --argjson p "${DNS_PORT}" --argjson pid "${_dst_pid}" \
      '{state:$s,suffix:$sfx,port:$p,pid:$pid}'
    return 0
  fi

  case "${_dst_state}" in
    running) _dst_color="${green}" ;;
    degraded) _dst_color="${yellow}" ;;
    *) _dst_color="${red}" ;;
  esac
  printf '%s\n' "${blue}MagicDNS:${normal} ${_dst_color}${_dst_state}${normal}  ${blue}Port:${normal} ${yellow}${DNS_PORT}${normal}"

  if iptables -t nat -L "${CHAIN_DNS}" -n >/dev/null 2>&1; then
    printf '%s\n' "  ${blue}Redirect:${normal} ${green}UDP/53 -> ${DNS_PORT} active (${CHAIN_DNS})${normal}"
  else
    printf '%s\n' "  ${blue}Redirect:${normal} ${red}inactive${normal}"
  fi

  [ -n "${_dst_suffix}" ] && printf '%s\n' "  ${blue}Suffix:${normal} ${yellow}${_dst_suffix}${normal}"
  return 0
}

usage() {
  printf '%s\n' "${yellow}usage${normal}: ${green}${scripts_name}${normal} {${orange}start|stop|status${normal}}"
}

case "$1" in
  start)
    dns_start
    ;;
  stop)
    dns_stop
    ;;
  status)
    dns_status "$2"
    ;;
  *)
    if [ -n "$1" ]; then
      printf '%s\n' "${yellow}${scripts_name} ${orange}$1 ${red}not found${normal}"
      exit 1
    fi
    usage
    ;;
esac
