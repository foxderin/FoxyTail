#!/system/bin/sh
# FoxyTail policy routing. Only the named chains, exact policy rule and
# protocol-186 routes on tailscale0 are owned by this controller.
DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "${DIR}/../settings.sh"

CHAIN_MARK=FOXY_MARK
CHAIN_STAT=FOXY_STAT
ROUTE_RULE_PREF=12510
ROUTE_PROTOCOL=186
ROUTE_STATE_FILE="${TS_RUN_DIR}/route.state"
ROUTE_SNAPSHOT_DIR="${TS_RUN_DIR}/route.snapshot"
ROUTE_READ_SNAPSHOT=

safe_table() {
  [ "$1" = 1052 ]
}

route_exit_destinations() {
  if [ -n "${ROUTE_READ_SNAPSHOT:-}" ]; then
    _re_snapshot=${ROUTE_READ_SNAPSHOT}
  else
    _re_snapshot=$("${TS_SCRIPTS_DIR}/foxytail.exitnode" snapshot) || {
      log Error "exit preference is unknown; refusing to claim current routing"; return 1;
    }
  fi
  ROUTE_EXIT_FINGERPRINT=$(printf '%s' "${_re_snapshot}" | jqr -c '{profile,self,pref,actual:(.actual.ID // "")}') || return 1
  ROUTE_DESTINATIONS=""
  ROUTE_SKIPPED_DEFAULTS=""
  for _re_net in ${ROUTE_SUBNETS}; do
    case "${_re_net}" in
      0.0.0.0/0|::/0)
        ROUTE_SKIPPED_DEFAULTS="${ROUTE_SKIPPED_DEFAULTS}${ROUTE_SKIPPED_DEFAULTS:+ }${_re_net}"
        continue ;;
    esac
    ROUTE_DESTINATIONS="${ROUTE_DESTINATIONS}${ROUTE_DESTINATIONS:+ }${_re_net}"
  done
  if [ "${TS_MODE}" = bridge ] &&
    { [ "${ROUTE_SCOPE}" != selected ] || [ -n "$(printf '%s\n' ${UID_LIST} | awk '$0!="0" && $0!=""')" ]; } &&
    printf '%s' "${_re_snapshot}" | jqr -e '.profile!="" and .self!="" and .backend=="Running" and .actual!=null and
      ((.pref.id!="" and .actual.ID==.pref.id) or
       (.pref.id=="" and .pref.ip!="" and ((.actual.TailscaleIPs // [])|index(.pref.ip))!=null))' >/dev/null; then
    case " ${ROUTE_DESTINATIONS} " in *' 0.0.0.0/0 '*) ;; *) ROUTE_DESTINATIONS="${ROUTE_DESTINATIONS} 0.0.0.0/0" ;; esac
    if [ "${IPV6}" = on ]; then
      case " ${ROUTE_DESTINATIONS} " in *' ::/0 '*) ;; *) ROUTE_DESTINATIONS="${ROUTE_DESTINATIONS} ::/0" ;; esac
    fi
  fi
  # A configured default route only ever forwards through an online exit
  # node; naming what remains skipped is far better than routing nothing
  # silently while `check` still passes and `status` claims applied.
  _re_still_skipped=""
  for _re_net in ${ROUTE_SKIPPED_DEFAULTS}; do
    case " ${ROUTE_DESTINATIONS} " in
      *" ${_re_net} "*) ;;
      *)
        _re_still_skipped="${_re_still_skipped}${_re_still_skipped:+ }${_re_net}"
        case "${_re_net}" in
          ::/0) log Warning "ROUTE_SUBNETS entry ${_re_net} is skipped: a default route applies only through an online exit node and requires IPV6=on" ;;
          *) log Warning "ROUTE_SUBNETS entry ${_re_net} is skipped: a default route applies only through an online exit node" ;;
        esac ;;
    esac
  done
  ROUTE_SKIPPED_DEFAULTS=${_re_still_skipped}
}

route_validate() {
  safe_table "${ROUTE_TABLE}" || { log Error "unsafe policy table ${ROUTE_TABLE}"; return 1; }
  [ "${FWMARK}" = 0x40000000 ] && [ "${FWMARK_MASK}" = 0x40000000 ] || {
    log Error "unsupported mark/mask; FoxyTail reserves bit 0x40000000"; return 1;
  }
  route_exit_destinations || return 1
  if [ "${IPV6}" = on ]; then
    case "${ROUTE_DESTINATIONS}" in
      *:*) ;;
      *) log Error "IPV6=on requires an IPv6 ROUTE_SUBNETS entry, e.g. fd7a:115c:a1e0::/48"; return 1 ;;
    esac
  fi
  case "${TS_MODE}:${ROUTE_SCOPE}" in
    bridge:all|bridge:selected|bridge:bypass|tun:all) ;;
    *) log Error "UID routing requires bridge mode; native tun supports scope=all only"; return 1 ;;
  esac
}

route_fingerprint() {
  printf '%s\n' "${TS_MODE}|${ROUTE_SCOPE}|${UID_LIST}|${ROUTE_DESTINATIONS}|${IPV6}|${ROUTE_TABLE}|${FWMARK}/${FWMARK_MASK}|${ROUTE_RULE_PREF}|${MAGIC_DNS}|${ROUTE_EXIT_FINGERPRINT}"
}

# State is data, never shell input. Bad/incomplete state cannot select a table.
state_table() {
  _st=$(sed -n 's/^ROUTE_TABLE=//p' "${ROUTE_STATE_FILE}" 2>/dev/null)
  safe_table "${_st}" && printf '%s\n' "${_st}"
}

# Use the shared atomic-owner lock, so desired config cannot change between
# load and kernel mutation. One lock implementation also avoids stale mkdir
# recovery races and interruption windows with an unpublished PID.
route_lock() {
  conf_lock_acquire || return 1
  trap 'conf_lock_release' EXIT
  trap 'exit 1' INT TERM
}

# Match every part of the policy rule, including priority and table.
fwmark_rule_present() {
  awk -v fw="${FWMARK}/${FWMARK_MASK}" -v tab="${ROUTE_TABLE}" -v pref="${ROUTE_RULE_PREF}:" '
    $1 == pref {
      mark=0; table=0
      for (i=2;i<NF;i++) {
        if ($i=="fwmark" && tolower($(i+1))==tolower(fw)) mark=1
        if (($i=="lookup" || $i=="table") && $(i+1)==tab) table=1
      }
      if (mark && table) found=1
    }
    END { exit !found }'
}

owned_routes() {
  ip "$1" route show table "$2" proto "${ROUTE_PROTOCOL}" dev "${TUN_IFACE}" 2>/dev/null | sort
}

# iproute2 omits fields already selected on its command line. Compare both
# renderings without dev/proto labels, while retaining the kernel's exact
# protocol/device filter above as the ownership authority. Foreign routes
# remain extra records and can never be claimed by this normalization.
route_comparison_lines() {
  awk '{
    line=""
    for (i=1;i<=NF;i++) {
      if ($i=="dev" || $i=="proto") {i++; continue}
      line=line (line=="" ? "" : " ") $i
    }
    if (line!="") print line
  }' | sort
}

# Refuse another controller's table or priority; never replace its routes.
table_available() {
  for _ta_family in -4 -6; do
    _ta_all=$(ip "${_ta_family}" route show table "${ROUTE_TABLE}" 2>/dev/null | route_comparison_lines)
    _ta_owned=$(owned_routes "${_ta_family}" "${ROUTE_TABLE}" | route_comparison_lines)
    [ "${_ta_all}" = "${_ta_owned}" ] || {
      log Error "table ${ROUTE_TABLE} contains foreign routes (${_ta_family})"; return 1;
    }
    _ta_rules=$(ip "${_ta_family}" rule show 2>/dev/null | awk -v p="${ROUTE_RULE_PREF}:" -v t="${ROUTE_TABLE}" '
      $1==p {print; next}
      {for(i=1;i<NF;i++) if(($i=="lookup"||$i=="table")&&$(i+1)==t) {print; break}}')
    if [ -n "${_ta_rules}" ]; then
      if [ "$(printf '%s\n' "${_ta_rules}" | wc -l | tr -d ' ')" != 1 ] ||
        ! printf '%s\n' "${_ta_rules}" | fwmark_rule_present; then
        log Error "policy table/priority is already used (${_ta_family})"
        return 1
      fi
    fi
  done
}

# Compare canonical kernel output with the manifest captured after apply.
# Every configured subnet and both families participate; an intact chain alone
# is not sufficient. check performs no network mutations.
route_check() {
  route_validate || return 1
  iface_exists || return 1
  [ "$(sed -n 's/^FINGERPRINT=//p' "${ROUTE_STATE_FILE}" 2>/dev/null)" = "$(route_fingerprint)" ] || return 1
  for _rc_cmd in iptables ip6tables; do
    if [ "${_rc_cmd}" = ip6tables ]; then
      _rc_family=-6
      if [ "${IPV6}" != on ]; then
        ip6tables -t mangle -C OUTPUT -j "${CHAIN_MARK}" 2>/dev/null && return 1
        ip6tables -t filter -C OUTPUT -j "${CHAIN_STAT}" 2>/dev/null && return 1
        ip -6 rule show 2>/dev/null | fwmark_rule_present && return 1
        [ -z "$(owned_routes -6 "${ROUTE_TABLE}")" ] || return 1
        continue
      fi
    else
      _rc_family=-4
    fi
    for _rc_pair in "mangle:${CHAIN_MARK}" "filter:${CHAIN_STAT}"; do
      _rc_table=${_rc_pair%:*}; _rc_chain=${_rc_pair#*:}
      "${_rc_cmd}" -t "${_rc_table}" -C OUTPUT -j "${_rc_chain}" 2>/dev/null || return 1
      [ "$("${_rc_cmd}" -t "${_rc_table}" -S OUTPUT 2>/dev/null | awk -v c="${_rc_chain}" '$0 == "-A OUTPUT -j " c {n++} END {print n+0}')" = 1 ] || return 1
      _rc_actual=$("${_rc_cmd}" -t "${_rc_table}" -S "${_rc_chain}" 2>/dev/null) || return 1
      [ -f "${ROUTE_SNAPSHOT_DIR}/${_rc_cmd}.${_rc_table}" ] || return 1
      [ "${_rc_actual}" = "$(cat "${ROUTE_SNAPSHOT_DIR}/${_rc_cmd}.${_rc_table}")" ] || return 1
    done
    ip "${_rc_family}" rule show 2>/dev/null | fwmark_rule_present || return 1
    [ -f "${ROUTE_SNAPSHOT_DIR}/${_rc_family}.routes" ] || return 1
    [ "$(owned_routes "${_rc_family}" "${ROUTE_TABLE}")" = "$(cat "${ROUTE_SNAPSHOT_DIR}/${_rc_family}.routes")" ] || return 1
  done
  table_available
}

# Android/netd and other modules share the xtables lock. Wait briefly for each
# mutation instead of treating a concurrent writer as a broken rule set.
# Read-only readiness checks keep their immediate behavior, including absent
# families/tables; no unbounded -w is used in the controller.
xtables_write() {
  _xw_cmd="$1"
  shift
  "${_xw_cmd}" -w 2 "$@"
}

unmount() { while xtables_write "$1" -t "$2" -D OUTPUT -j "$3" 2>/dev/null; do :; done; }

route_cleanup() {
  _cl_failed=0
  for _cl_cmd in iptables ip6tables; do
    unmount "${_cl_cmd}" mangle "${CHAIN_MARK}"
    unmount "${_cl_cmd}" filter "${CHAIN_STAT}"
    xtables_write "${_cl_cmd}" -t mangle -F "${CHAIN_MARK}" 2>/dev/null
    xtables_write "${_cl_cmd}" -t mangle -X "${CHAIN_MARK}" 2>/dev/null
    xtables_write "${_cl_cmd}" -t filter -F "${CHAIN_STAT}" 2>/dev/null
    xtables_write "${_cl_cmd}" -t filter -X "${CHAIN_STAT}" 2>/dev/null
    "${_cl_cmd}" -t mangle -S "${CHAIN_MARK}" >/dev/null 2>&1 && _cl_failed=1
    "${_cl_cmd}" -t filter -S "${CHAIN_STAT}" >/dev/null 2>&1 && _cl_failed=1
  done
  _cl_table=$(state_table)
  if [ -n "${_cl_table}" ]; then
    for _cl_family in -4 -6; do
      while ip "${_cl_family}" rule del pref "${ROUTE_RULE_PREF}" fwmark 0x40000000/0x40000000 table "${_cl_table}" 2>/dev/null; do :; done
      # Legacy rules used an unmasked 0xf7. Remove only that recorded tuple;
      # legacy untagged routes are deliberately not assumed to be ours.
      if [ "$(sed -n 's/^FWMARK=//p' "${ROUTE_STATE_FILE}" 2>/dev/null | tr A-F a-f)" = 0xf7 ]; then
        while ip "${_cl_family}" rule del fwmark 0xf7 table "${_cl_table}" 2>/dev/null; do :; done
        log Warning "removed legacy 0xf7 policy rule; untagged legacy routes are preserved and may require explicit review"
      fi
      # Never flush a table. Each delete also requires our protocol and device.
      owned_routes "${_cl_family}" "${_cl_table}" | while IFS=' ' read -r _cl_net _cl_rest; do
        [ -n "${_cl_net}" ] || continue
        ip "${_cl_family}" route del "${_cl_net}" table "${_cl_table}" proto "${ROUTE_PROTOCOL}" dev "${TUN_IFACE}" 2>/dev/null
      done
      [ -z "$(owned_routes "${_cl_family}" "${_cl_table}")" ] || _cl_failed=1
      if ip "${_cl_family}" rule show 2>/dev/null | awk -v t="${_cl_table}" '
        {m=0; tab=0; for(i=1;i<NF;i++) {
           if($i=="fwmark" && tolower($(i+1))=="0x40000000/0x40000000") m=1
           if(($i=="table"||$i=="lookup") && $(i+1)==t) tab=1
         } if($1=="12510:" && m && tab) found=1}
        END {exit !found}'; then _cl_failed=1; fi
    done
  fi
  if [ "${_cl_failed}" != 0 ]; then
    log Error "network cleanup incomplete; retained ownership state for retry"
    return 1
  fi
  rm -f "${ROUTE_STATE_FILE}"
  rm -rf "${ROUTE_SNAPSHOT_DIR}"
  return 0
}

# Mark only requested destinations. Root processes host tailscaled and HEV;
# excluding UID 0 prevents their control/forwarding sockets re-entering TUN.
# Preserve Android marks and bypass every packet already marked by Tailscale.
apply_family() {
  _af_cmd="$1"; _af_family="$2"
  xtables_write "${_af_cmd}" -t mangle -N "${CHAIN_MARK}" 2>/dev/null || return 1
  xtables_write "${_af_cmd}" -t filter -N "${CHAIN_STAT}" 2>/dev/null || return 1
  xtables_write "${_af_cmd}" -t mangle -A "${CHAIN_MARK}" -m owner --uid-owner 0 -j RETURN || return 1
  xtables_write "${_af_cmd}" -t mangle -A "${CHAIN_MARK}" -m mark ! --mark 0x0/0x1e000000 -j RETURN || return 1
  # The local resolver must reach Quad100 even when the user's selected/bypass
  # UID scope excludes nobody. Restrict the exception to DNS, its UID and one
  # service address; preserve the daemon/root and Tailscale mark exemptions.
  if [ "${TS_MODE}" = bridge ] && [ "${MAGIC_DNS}" = on ] && [ "${_af_family}" = -4 ]; then
    for _af_proto in udp tcp; do
      xtables_write "${_af_cmd}" -t mangle -A "${CHAIN_MARK}" -m owner --uid-owner 9999 -d 100.100.100.100/32 -p "${_af_proto}" --dport 53 -j MARK --set-xmark "${FWMARK}/${FWMARK_MASK}" || return 1
    done
    ip -4 route add 100.100.100.100/32 dev "${TUN_IFACE}" table "${ROUTE_TABLE}" proto "${ROUTE_PROTOCOL}" || return 1
  fi
  if [ "${ROUTE_SCOPE}" = bypass ]; then
    for _af_uid in ${UID_LIST}; do
      xtables_write "${_af_cmd}" -t mangle -A "${CHAIN_MARK}" -m owner --uid-owner "${_af_uid}" -j RETURN || return 1
    done
  fi
  for _af_net in ${ROUTE_DESTINATIONS}; do
    case "${_af_family}:${_af_net}" in -4:*:*) continue ;; -6:*:*) ;; -6:*) continue ;; esac
    if [ "${ROUTE_SCOPE}" = selected ]; then
      for _af_uid in ${UID_LIST}; do
        xtables_write "${_af_cmd}" -t mangle -A "${CHAIN_MARK}" -d "${_af_net}" -m owner --uid-owner "${_af_uid}" -j MARK --set-xmark "${FWMARK}/${FWMARK_MASK}" || return 1
      done
    else
      xtables_write "${_af_cmd}" -t mangle -A "${CHAIN_MARK}" -d "${_af_net}" -j MARK --set-xmark "${FWMARK}/${FWMARK_MASK}" || return 1
    fi
    if [ "${_af_net}" != 100.100.100.100/32 ] || [ "${TS_MODE}:${MAGIC_DNS}:${_af_family}" != bridge:on:-4 ]; then
      ip "${_af_family}" route add "${_af_net}" dev "${TUN_IFACE}" table "${ROUTE_TABLE}" proto "${ROUTE_PROTOCOL}" || return 1
    fi
  done
  # OUTPUT on the actual TUN interface counts transmitted overlay bytes only.
  # UID rules precede the terminal return and are summed over both families.
  for _af_uid in ${UID_LIST}; do
    xtables_write "${_af_cmd}" -t filter -A "${CHAIN_STAT}" -o "${TUN_IFACE}" -m owner --uid-owner "${_af_uid}" -j RETURN || return 1
  done
  xtables_write "${_af_cmd}" -t filter -A "${CHAIN_STAT}" -j RETURN || return 1
  xtables_write "${_af_cmd}" -t mangle -A OUTPUT -j "${CHAIN_MARK}" || return 1
  xtables_write "${_af_cmd}" -t filter -A OUTPUT -j "${CHAIN_STAT}" || return 1
  ip "${_af_family}" rule add pref "${ROUTE_RULE_PREF}" fwmark "${FWMARK}/${FWMARK_MASK}" table "${ROUTE_TABLE}" || return 1
  "${_af_cmd}" -t mangle -S "${CHAIN_MARK}" >"${ROUTE_SNAPSHOT_DIR}/${_af_cmd}.mangle" || return 1
  "${_af_cmd}" -t filter -S "${CHAIN_STAT}" >"${ROUTE_SNAPSHOT_DIR}/${_af_cmd}.filter" || return 1
  owned_routes "${_af_family}" "${ROUTE_TABLE}" >"${ROUTE_SNAPSHOT_DIR}/${_af_family}.routes"
}

route_apply() {
  route_validate || return 1
  iface_exists || { log Error "interface ${TUN_IFACE} is unavailable"; return 1; }
  route_check >/dev/null 2>&1 && return 0
  route_cleanup || return 1
  table_available || return 1
  mkdir -p "${ROUTE_SNAPSHOT_DIR}" || return 1
  # Write cleanup ownership before mutation, so failed applies can roll back.
  {
    echo "ROUTE_TABLE=${ROUTE_TABLE}"
    echo "FWMARK=${FWMARK}"
    echo "FINGERPRINT=$(route_fingerprint)"
  } >"${ROUTE_STATE_FILE}" || return 1
  if ! apply_family iptables -4 || { [ "${IPV6}" = on ] && ! apply_family ip6tables -6; }; then
    log Error "policy apply failed; removing partial FoxyTail rules"
    route_cleanup
    return 1
  fi
  printf '%s\n' "$(date +%s)-$$" >"${ROUTE_SNAPSHOT_DIR}/generation"
  log Success "policy routing applied with isolated mark bit and owned routes"
}

ensure_run_dirs
# Teardown needs only validated applied ownership, even if desired config is
# damaged. Never let a bad newly edited config strand the previous rules.
case "$1" in
  check) load_runtime_conf || exit 1; route_check ;;
  check-snapshot)
    load_runtime_conf || exit 1
    [ "$2" = "${TS_MODE}|${ROUTE_SCOPE}|${UID_LIST}|${ROUTE_SUBNETS}|${IPV6}|${ROUTE_TABLE}|${FWMARK}/${FWMARK_MASK}|${MAGIC_DNS}" ] || exit 1
    # This read-only entry consumes the caller's bracketed snapshot, never a cache.
    ROUTE_READ_SNAPSHOT=$(jqr -e -s -c 'select(length==1) | .[0] | select(type=="object" and
      (.profile|type)=="string" and .profile!="" and (.self|type)=="string" and .self!="" and
      (.backend|type)=="string" and (.pref|type)=="object" and
      (.pref.id|type)=="string" and (.pref.ip|type)=="string" and (.pref.auto|type)=="string" and
      (.pref.allowLAN|type)=="boolean" and (.actual==null or
        ((.actual|type)=="object" and (.actual.ID|type)=="string" and
         (.actual.Online|type)=="boolean" and ((.actual.TailscaleIPs // [])|type)=="array" and
         all((.actual.TailscaleIPs // [])[]; type=="string"))))') || exit 1
    route_check
    ;;
  apply|reload)
    route_lock || exit 1
    if [ "$1" = reload ]; then conf_apply_runtime routes.conf || exit 1; fi
    load_runtime_conf || exit 1
    route_apply
    ;;
  teardown) route_lock || exit 1; route_cleanup ;;
  status)
    load_runtime_conf || exit 1
    ROUTE_SKIPPED_DEFAULTS=""
    if route_check; then echo 'Policy routing: applied'; else echo 'Policy routing: incomplete'; fi
    # Additive notes keep the first line's applied/incomplete contract intact.
    for _st_skip in ${ROUTE_SKIPPED_DEFAULTS}; do
      echo "note: ROUTE_SUBNETS entry ${_st_skip} is skipped (default routes apply only through an online exit node)"
    done
    ip -4 rule show
    ip -4 route show table "${ROUTE_TABLE}"
    if [ "${IPV6}" = on ]; then
      ip -6 rule show
      ip -6 route show table "${ROUTE_TABLE}"
    fi
    ;;
  *) echo "usage: $0 {apply|teardown|reload|check|status}" >&2; exit 1 ;;
esac
