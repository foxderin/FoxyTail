#!/system/bin/sh
# FoxyTail - traffic stats collector.
#
# Subcommands:
#   start        resident collection loop (dedup via pid file, trap TERM)
#   stop         stop the resident loop
#   status       JSON: {"running":bool,...}
#   collect-once append one JSON sample to $TS_STATS_DIR/YYYY-MM-DD.jsonl
#   query hourly <YYYY-MM-DD> | daily | topn <n>

DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "$DIR"/../settings.sh
if [ "${1:-}" != stop ]; then load_runtime_conf || exit 1; fi
ensure_run_dirs
# KSU service context runs with umask 000; keep samples root-only readable.
umask 027

PID_FILE="${TS_PID_DIR}/foxytail.stats.pid"

# _date_lt <a> <b>: true when date string a sorts before b (YYYY-MM-DD).
# POSIX-safe: test's \< / \> are undefined in POSIX sh (SC3012).
_date_lt() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort | head -n 1)" = "$1" ]
}

# _in_retention <file> <basename> <cut-epoch> <cut-date>: true when the
# stats file is inside the retention window. Primary comparison is by the
# file-name date; when `date -d @epoch` is unavailable (some busybox/toybox
# builds) fall back to the file mtime, warning instead of silently skipping.
_in_retention() {
  _ir_file="$1"
  _ir_base="$2"
  _ir_cut_epoch="$3"
  _ir_cut="$4"
  if [ -n "${_ir_cut}" ]; then
    ! _date_lt "${_ir_base}" "${_ir_cut}"
    return
  fi
  _ir_mt=$(stat -c %Y "${_ir_file}" 2>/dev/null)
  case "${_ir_mt}" in
    '' | *[!0-9]*)
      log Warning "stats: cannot determine age of ${_ir_file}; treating it as inside the window."
      return 0
      ;;
  esac
  [ "${_ir_mt}" -ge "${_ir_cut_epoch}" ]
}

# Print the retention cutoff: "<epoch> <YYYY-MM-DD>" (date empty when the
# local date(1) cannot convert epochs).
_stats_cutoff() {
  _sco_epoch=$(( $(date +%s) - STATS_RETENTION_DAYS * 86400 ))
  _sco_date=$(date -d "@${_sco_epoch}" +%F 2>/dev/null)
  echo "${_sco_epoch} ${_sco_date}"
}

# Delete stats files older than STATS_RETENTION_DAYS.
prune_stats() {
  _ps_cut=$(_stats_cutoff)
  # shellcheck disable=SC2086 # intentional: "<epoch> <date>" splits into $1/$2
  set -- ${_ps_cut}
  if [ -z "${2:-}" ]; then
    log Warning "stats: 'date -d @epoch' unsupported; pruning by file mtime instead."
  fi
  for _f in "${TS_STATS_DIR}"/????-??-??.jsonl; do
    [ -f "$_f" ] || continue
    _base=${_f##*/}; _base=${_base%.jsonl}
    if ! _in_retention "$_f" "$_base" "$1" "${2:-}"; then
      rm -f "$_f"
    fi
  done
}

# Print the paths of stats files inside the retention window, oldest first.
stats_recent_files() {
  _srf_cut=$(_stats_cutoff)
  # shellcheck disable=SC2086 # intentional: "<epoch> <date>" splits into $1/$2
  set -- ${_srf_cut}
  for _f in "${TS_STATS_DIR}"/????-??-??.jsonl; do
    [ -f "$_f" ] || continue
    _base=${_f##*/}; _base=${_base%.jsonl}
    if _in_retention "$_f" "$_base" "$1" "${2:-}"; then
      echo "$_f"
    fi
  done
}

collect_once() {
  _when=$(date '+%s %F')
  _ts=${_when%% *} _day=${_when#* }
  _file="${TS_STATS_DIR}/${_day}.jsonl"
  # Retention changes once per date, not once per sample. Repair permissions
  # on the first opened file too, including files left by an earlier version.
  if [ "${_stats_day:-}" != "$_day" ] || [ ! -f "$_file" ]; then
    : >>"$_file" || return 1
    chmod 0640 "$_file" || return 1
    prune_stats
    _stats_day=$_day
  fi
  if ! _status=$(ts_status_json tmo 10 tailscale --socket="${TS_SOCKET}" status --json 2>/dev/null) || [ -z "$_status" ]; then
    stats_unreachable
    return $?
  fi

  _iface="null"
  if [ -d "/sys/class/net/${TUN_IFACE}" ]; then
    _rx='' _tx=''
    IFS= read -r _rx <"/sys/class/net/${TUN_IFACE}/statistics/rx_bytes" 2>/dev/null || :
    IFS= read -r _tx <"/sys/class/net/${TUN_IFACE}/statistics/tx_bytes" 2>/dev/null || :
    case "$_rx" in '' | *[!0-9]*) _rx=0 ;; esac
    case "$_tx" in '' | *[!0-9]*) _tx=0 ;; esac
    _iface="{\"rx\":${_rx},\"tx\":${_tx}}"
  fi

  # Read only families whose current ownership snapshot has UID counters.
  # Re-read these tiny files every round so a hot apply is visible immediately.
  _uid_tables=
  for _uid_cmd in iptables ip6tables; do
    _uid_snapshot="${TS_RUN_DIR}/route.snapshot/${_uid_cmd}.filter"
    [ -f "$_uid_snapshot" ] || continue
    while IFS= read -r _uid_rule; do
      case "$_uid_rule" in *' --uid-owner '*) _uid_tables="$_uid_tables $_uid_cmd"; break ;; esac
    done <"$_uid_snapshot"
  done
  _uids=
  if [ -n "$_uid_tables" ]; then
    _uids=$({
      for _uid_cmd in $_uid_tables; do
        "${_uid_cmd}" -t filter -nvxL FOXY_STAT 2>/dev/null
      done
    } | awk '/owner UID match/ { for(i=1;i<=NF;i++) if($i=="match") print $2, $(i+1) }')
  fi

  _daemon_generation=$(for _sg_pid in $(pids_of_path "${TS_BIN_DIR}/tailscaled"); do
    printf '%s:%s\n' "${_sg_pid}" "$(_conf_pid_stamp "${_sg_pid}")"
  done)
  _iface_generation='' _uid_generation=''
  [ ! -f "/sys/class/net/${TUN_IFACE}/ifindex" ] || IFS= read -r _iface_generation <"/sys/class/net/${TUN_IFACE}/ifindex"
  [ ! -f "${TS_RUN_DIR}/route.snapshot/generation" ] || IFS= read -r _uid_generation <"${TS_RUN_DIR}/route.snapshot/generation"
  if ! _sample=$(printf '%s' "$_status" | jqr -s -c --argjson ts "$_ts" \
    --argjson iface "$_iface" --arg uids "$_uids" \
    --arg dg "${_daemon_generation}" --arg ig "${_iface_generation}" --arg ug "${_uid_generation}" \
    'if length!=1 or (.[0]|type)!="object" then error("invalid status") else .[0] end
     | [.Peer // {} | .[] | {id:(.ID|tostring),rx:(.RxBytes // 0),tx:(.TxBytes // 0)}] as $peers
     | ($uids | split("\n") | map(select(length>0) | split(" ")
         | {uid:.[1],rx:0,tx:(.[0]|tonumber)}) | group_by(.uid)
         | map({uid:.[0].uid,rx:0,tx:(map(.tx)|add)})) as $uidRows
     | {ts:$ts,peers:$peers,iface:$iface,uids:$uidRows,uidDirection:"tx",
        generation:{peers:$dg,iface:$ig,uids:$ug}}' 2>/dev/null); then
    stats_unreachable
    return $?
  fi
  printf '%s\n' "$_sample" >>"$_file" || return 1
  _stats_error_day=
}

# Error rows are ignored by the delta reader. Keep one per uninterrupted outage
# and day instead of writing identical failures for a stopped daemon forever.
stats_unreachable() {
  [ "${_stats_error_day:-}" != "$_day" ] || return 0
  printf '{"ts":%s,"error":"daemon-unreachable"}\n' "$_ts" >>"$_file" || return 1
  _stats_error_day=$_day
}

_stats_stop() {
  _stats_running=0
}

do_start() {
  [ "${STATS:-on}" = on ] || return 0
  _stats_running=1
  trap '_stats_stop' TERM INT
  daemon_claim_pidfile foxytail.stats || { [ "$?" = 2 ] && return 0; return 1; }
  log Info "foxytail.stats started (pid $$, interval ${STATS_INTERVAL}s)"
  while [ "$_stats_running" = "1" ]; do
    load_runtime_conf || { log Error "stats: invalid runtime configuration"; break; }
    [ "${STATS:-on}" = on ] || break
    collect_once
    _int=$(effective_interval "${STATS_INTERVAL}" 5 300 900)
    isleep "$_int"
  done
  daemon_release_pidfile foxytail.stats
  log Info "foxytail.stats stopped"
  return 0
}

do_status() {
  if daemon_pid_alive foxytail.stats; then
    jqr -n -c --argjson r true --argjson p "${_dpa_pid}" \
      --argjson i "${STATS_INTERVAL}" --arg d "$TS_STATS_DIR" \
      '{running:$r,pid:$p,interval:$i,dir:$d}'
  else
    jqr -n -c --argjson r false --argjson i "${STATS_INTERVAL}" \
      --arg d "$TS_STATS_DIR" '{running:$r,pid:null,interval:$i,dir:$d}'
  fi
}

# Keep only last counters and aggregate buckets, never all retained samples.
stats_summary() (
  _sd_tmp=$(mktemp -d "${TS_RUN_DIR}/.stats-query.XXXXXX") || exit 1
  trap 'rm -rf "${_sd_tmp}"' 0
  trap 'exit 130' HUP INT TERM
  {
    for _sd_file in $(stats_recent_files); do cat "${_sd_file}" || exit 1; done
    : >"${_sd_tmp}/input-complete"
  } | "${TS_BIN_DIR}/foxyfiles" ordered-stats "${_sd_tmp}" >"${_sd_tmp}/ordered" || exit 1
  [ -f "${_sd_tmp}/input-complete" ] || exit 1
  jqr -R -n -c --arg d "${1:-$(date +%F)}" --arg mode "${2:-summary}" --argjson n "${3:-10}" '
      def delta($old; $new; $changed):
        if $old == null then 0 elif $changed or $new < $old then $new else $new - $old end;
      def pair($old; $new; $changed):
        {rx:delta($old.rx; ($new.rx // 0); $changed),tx:delta($old.tx; ($new.tx // 0); $changed)};
      reduce (inputs | fromjson? | select(type=="object" and .error==null and (.ts|type)=="number")) as $s
        ({lastIface:null,lastPeers:{},lastUids:{},days:{},hours:{},peers:{},uids:{}};
          . as $acc | ($s.generation // {}) as $gen
          | ($s.ts | strflocaltime("%F")) as $day
          | ($s.ts | strflocaltime("%H")) as $hour
          | .days[$day] //= {date:$day,samples:0,rx:0,tx:0}
          | if $day==$d then .hours[$hour] //= {hour:($hour|tonumber),samples:0,iface:{rx:0,tx:0},peers:{}} else . end
          | if $s.iface != null then
              pair(.lastIface.value; $s.iface; .lastIface!=null and ($gen.iface // "")!=(.lastIface.gen // "")) as $v
              | .days[$day].samples+=1 | .days[$day].rx+=$v.rx | .days[$day].tx+=$v.tx
              | if $day==$d then .hours[$hour].samples+=1 | .hours[$hour].iface.rx+=$v.rx | .hours[$hour].iface.tx+=$v.tx else . end
              | .lastIface={value:$s.iface,gen:$gen.iface}
            else . end
          | reduce $s.peers[]? as $p (. ;
              ($p.id|tostring) as $id | $acc.lastPeers[$id] as $old
              | pair($old.value; $p; $old!=null and ($gen.peers // "")!=($old.gen // "")) as $v
              | .peers[$id] //= {id:$id,rx:0,tx:0}
              | .peers[$id].rx+=$v.rx | .peers[$id].tx+=$v.tx
              | if $day==$d then
                  .hours[$hour].peers[$id] //= {id:$id,rx:0,tx:0}
                  | .hours[$hour].peers[$id].rx+=$v.rx | .hours[$hour].peers[$id].tx+=$v.tx
                else . end
              | .lastPeers[$id]={value:$p,gen:$gen.peers})
          | if $s.uidDirection=="tx" then
              reduce $s.uids[]? as $u (. ;
                ($u.uid|tostring) as $id | $acc.lastUids[$id] as $old
                | pair($old.value; $u; $old!=null and ($gen.uids // "")!=($old.gen // "")) as $v
                | .uids[$id] //= {uid:$id,rx:0,tx:0} | .uids[$id].tx+=$v.tx
                | .lastUids[$id]={value:$u,gen:$gen.uids})
            else . end)
      | . as $result
      | {date:$d,attribution:"interval-end",direction:"tx",
          days:(.days | [.[]] | sort_by(.date)),
          hours:[range(0;24) | . as $h | ($h|tostring | if length==1 then "0"+. else . end) as $key
            | ($result.hours[$key] // {hour:$h,samples:0,iface:{rx:0,tx:0},peers:{}}) | .peers |= [.[]]],
          topn:(.peers | [.[] | select(.rx+.tx>0)] | sort_by([-(.rx+.tx),.id])),
          uids:(.uids | [.[] | select(.tx>0)] | sort_by([-.tx,.uid]))}
      | if $mode=="hourly" then {date,attribution,hours}
        elif $mode=="daily" then {attribution,days}
        elif $mode=="topn" then {topn:.topn[:$n]}
        elif $mode=="uids" then {uids:.uids[:$n],direction}
        else . end' "${_sd_tmp}/ordered"
)

query() {
  case "$1" in
    summary) stats_summary "$2" ;;
    hourly) stats_summary "$2" hourly ;;
    daily) stats_summary '' daily ;;
    topn|uids)
      _n="$2"; case "$_n" in ''|*[!0-9]*) _n=10 ;; esac
      stats_summary '' "$1" "${_n}"
      ;;
    *) echo "usage: $0 query {summary [date]|hourly <date>|daily|topn <n>|uids <n>}" >&2; return 1 ;;
  esac
}

case "$1" in
  start) do_start ;;
  stop) daemon_stop_pidfile foxytail.stats ;;
  status) do_status ;;
  collect-once) collect_once ;;
  query) shift; query "$@" ;;
  *)
    echo "usage: $0 {start|stop|status|collect-once|query ...}" >&2
    exit 1
    ;;
esac
