#!/system/bin/sh
# FoxyTail - inotifyd callback: react to the module disable flag.
#
# inotifyd invokes this as: foxytail.inotify <events> <dir> <file>
#   n (created) -> module disabled -> stop everything
#   d (deleted) -> module enabled  -> start everything

DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "$DIR"/../settings.sh

events="$1"
# monitor_dir="$2"
monitor_file="$3"

[ "$monitor_file" = "disable" ] || exit 0

_ctl() {
  # _ctl <start|stop>: best-effort call on every managed component.
  # stats/watchdog/context `start` are resident loops that never return, so
  # they must be backgrounded like in start.sh - a foreground call would block
  # this inotifyd callback forever. `stop` exits immediately either way.
  _op="$1"
  for _s in foxytail.service foxytail.stats foxytail.watchdog foxytail.context; do
    if [ -x "${TS_SCRIPTS_DIR}/${_s}" ]; then
      if [ "$_op" = "start" ] && [ "$_s" != "foxytail.service" ]; then
        "${TS_SCRIPTS_DIR}/${_s}" "$_op" >>"${TS_RUN_DIR}/${_s}.log" 2>&1 &
      else
        "${TS_SCRIPTS_DIR}/${_s}" "$_op" >>"${TS_RUN_LOG_FILE}" 2>&1
      fi
    else
      log Warning "inotify: ${_s} not found, skipped"
    fi
  done
}

case "$events" in
  *n*)
    log Info "module disabled via manager; stopping FoxyTail"
    _ctl stop
    ;;
  *d*)
    log Info "module enabled via manager; starting FoxyTail"
    _ctl start
    ;;
esac
