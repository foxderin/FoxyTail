#!/system/bin/sh
# FoxyTail - inotifyd callback: react to the module disable flag.
#
# inotifyd invokes this as: foxytail.inotify <events> <dir> <file>
# BusyBox emits one letter per event bit in <events>: n=create, d=delete,
# y=moved-into-dir, m=moved-out, w=closed-write, and more. A manager that
# installs the flag by renaming it into place produces 'y', never 'n', so
# matching individual letters silently misses toggles. The flag's meaning
# is its existence: any event on it reconciles idempotently instead.

DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "$DIR"/../settings.sh

events="$1"
monitor_dir="$2"
monitor_file="$3"

[ -n "$events" ] || exit 0
[ "$monitor_file" = "disable" ] || exit 0

_ctl() {
  ensure_run_dirs
  if [ "$1" = start ]; then
    "${TS_SCRIPTS_DIR}/start.sh" enable >>"${TS_RUN_LOG_FILE}" 2>&1
  else
    # Do not stop/restart the watcher from its own callback.
    _ctl_failed=0
    for _s in foxytail.watchdog foxytail.context foxytail.stats foxytail.logd; do
      [ ! -x "${TS_SCRIPTS_DIR}/${_s}" ] || "${TS_SCRIPTS_DIR}/${_s}" stop || _ctl_failed=1
    done
    "${TS_SCRIPTS_DIR}/foxytail.service" stop --internal >>"${TS_RUN_LOG_FILE}" 2>&1 || _ctl_failed=1
    return "${_ctl_failed}"
  fi
}

# Reconcile on any event letter (create, delete, rename into or out of the
# module dir, metadata changes). Existence is the only source of truth, so
# duplicate or combined event strings can never flip the state backwards.
if [ -f "${monitor_dir}/${monitor_file}" ]; then
  log Info "module disabled via manager; stopping FoxyTail"
  _ctl stop
else
  log Info "module enabled via manager; starting FoxyTail"
  _ctl start
fi
