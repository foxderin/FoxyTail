#!/system/bin/sh
# FoxyTail Tunnel Manager
#
# Manages the hev-socks5-tunnel that turns tailscaled's userspace socks5
# proxy into a real `tailscale0` network interface (bridge mode).
#
# Subcommands:
#   start    Start hev-socks5-tunnel. Only does something in TS_MODE=bridge.
#            Renders foxytail.tun.config.yaml (@SOCKS_PORT@, optional IPv6
#            block) to ${TS_RUN_DIR}/hev.yaml, starts the daemon, waits up to
#            10s for the tailscale0 interface, then runs the user hook
#            foxytail.tun.up if it is executable. A failed up hook rolls
#            back through stop; incomplete cleanup is retried before start.
#   stop     TERM, then KILL every remaining PID, then run foxytail.tun.down
#            hook.
#   restart  Restart hev-socks5-tunnel.
#   status   Show interface, process and gateway state.

# POSIX sh (Android mksh / busybox). No bashisms, no `set -e`.

DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "${DIR}/../settings.sh"

scripts_name=$(basename "$0")
HEV_BIN="${TS_BIN_DIR}/hev-socks5-tunnel"
HEV_NAME="hev-socks5-tunnel"
HEV_TEMPLATE="${TS_SCRIPTS_DIR}/foxytail.tun.config.yaml"
HEV_CONF="${TS_RUN_DIR}/hev.yaml"
HEV_LOG="${TS_RUN_DIR}/hev-socks5-tunnel.log"
PID_FILE="${TS_PID_DIR}/hev-socks5-tunnel.pid"
TUN_PENDING="${TS_RUN_DIR}/hev.pending"

# PIDs of OUR hev-socks5-tunnel instance: argv[0] must be the binary under
# $TS_BIN_DIR (or its bare name), so other modules' instances never match.
hev_pids() {
  pids_of_path "${HEV_BIN}"
}

# Wait up to 10s for the tunnel interface to appear.
wait_iface() {
  wait_for "interface ${TUN_IFACE}" 20 0.5 iface_exists
}

# Render the runtime config from the template: substitute @SOCKS_PORT@ and
# strip the IPv6 block unless IPV6=on.
render_conf() {
  if [ ! -f "${HEV_TEMPLATE}" ]; then
    log Error "tunnel config template not found: ${HEV_TEMPLATE}"
    return 1
  fi
  if [ "${IPV6}" = "on" ]; then
    sed -e "s/\"@SOCKS_PORT@\"/${SOCKS_PORT}/g" -e "s/@SOCKS_PORT@/${SOCKS_PORT}/g" \
      -e '/^  # @IPV6_BEGIN@$/d' -e '/^  # @IPV6_END@$/d' \
      "${HEV_TEMPLATE}" >"${HEV_CONF}"
  else
    sed -e "s/\"@SOCKS_PORT@\"/${SOCKS_PORT}/g" -e "s/@SOCKS_PORT@/${SOCKS_PORT}/g" \
      -e '/^  # @IPV6_BEGIN@$/,/^  # @IPV6_END@$/d' \
      "${HEV_TEMPLATE}" >"${HEV_CONF}"
  fi
}

run_hook() {
  _rh_hook="${TS_SCRIPTS_DIR}/foxytail.tun.$1"
  if [ -x "${_rh_hook}" ]; then
    log Info "running user hook: ${_rh_hook}"
    "${_rh_hook}"
  fi
}

tun_start() {
  ensure_run_dirs
  load_runtime_conf || return 1

  if [ "${TS_MODE}" != "bridge" ]; then
    log Debug "TS_MODE=${TS_MODE}: hev tunnel is only used in bridge mode; skipping."
    return 0
  fi

  if [ -e "${TUN_PENDING}" ]; then
    log Warning "previous tunnel operation incomplete; retrying cleanup before start."
    tun_stop || return 1
  fi

  if [ -n "$(hev_pids)" ]; then
    if iface_exists; then
      log Info "${HEV_NAME} is already running with its interface."
      return 0
    fi
    log Warning "${HEV_NAME} is alive without its interface; restarting it."
    tun_stop || return 1
  fi

  if [ ! -x "${HEV_BIN}" ]; then
    log Error "binary not found or not executable: ${HEV_BIN}"
    return 1
  fi

  render_conf || return 1
  rotate_log "${HEV_LOG}"

  # Keep incomplete startup/cleanup visible across invocations. Custom up
  # hooks may append rules, so clean up with down before attempting up again.
  : >"${TUN_PENDING}" || return 1
  log Info "Starting ${HEV_NAME} (socks5 127.0.0.1:${SOCKS_PORT} -> ${TUN_IFACE})."
  nohup "${HEV_BIN}" "${HEV_CONF}" >>"${HEV_LOG}" 2>&1 &
  echo "$!" >"${PID_FILE}"

  if ! wait_iface; then
    if [ -z "$(hev_pids)" ]; then
      log Error "${HEV_NAME} died at startup; see ${HEV_LOG}."
      return 1
    fi
    log Error "interface ${TUN_IFACE} not ready after 10s."
    return 1
  else
    log Success "${TUN_IFACE} is up."
  fi

  if ! run_hook up; then
    log Error "foxytail.tun.up hook failed; rolling back tunnel startup."
    tun_stop || log Error "tunnel rollback incomplete; cleanup must succeed before starting again."
    return 1
  fi
  rm -f "${TUN_PENDING}"
}

tun_stop() {
  ensure_run_dirs
  # Cleanup only uses owned process paths and the fixed hook; bad desired
  # configuration must not strand a running helper.
  load_runtime_conf || :

  : >"${TUN_PENDING}" || return 1
  _ts_pids=$(hev_pids)
  if [ -n "${_ts_pids}" ]; then
    # The down hook is promised a stopped tunnel; retain ownership and
    # pending cleanup if termination cannot be confirmed.
    stop_by_pids "${HEV_NAME}" "${_ts_pids}" || return 1
  else
    log Debug "${HEV_NAME} is not running."
  fi

  if ! run_hook down; then
    log Error "foxytail.tun.down hook failed; cleanup remains pending."
    return 1
  fi
  rm -f "${PID_FILE}" "${TUN_PENDING}"
}

tun_status() {
  ensure_run_dirs
  load_runtime_conf || return 1

  if iface_exists; then
    printf '%s\n' "${blue}Interface:${normal} ${green}${TUN_IFACE} up${normal}"
    ip -o addr show dev "${TUN_IFACE}" 2>/dev/null | while IFS= read -r _tst_line; do
      printf '%s\n' "  ↳ ${yellow}$(echo "${_tst_line}" | awk '{print $2, $4}')${normal}"
    done
  else
    printf '%s\n' "${blue}Interface:${normal} ${red}${TUN_IFACE} down${normal}"
  fi

  _tst_pids=$(hev_pids)
  if [ -n "${_tst_pids}" ]; then
    # shellcheck disable=SC2086 # intentional: one PID per word
    set -- ${_tst_pids}
    printf '%s\n' "${blue}Process:${normal} ${green}${HEV_NAME} running${normal} (PID: $1)"
  else
    printf '%s\n' "${blue}Process:${normal} ${red}${HEV_NAME} not running${normal}"
  fi

  _tst_gw=$(ip route show dev "${TUN_IFACE}" 2>/dev/null | awk '/default/ {print $3; exit}')
  if [ -n "${_tst_gw}" ]; then
    printf '%s\n' "${blue}Gateway:${normal} ${yellow}${_tst_gw}${normal}"
  else
    printf '%s\n' "${blue}Gateway:${normal} ${yellow}100.100.100.100${normal} (configured)"
  fi

  printf '%s\n' "${blue}Mode:${normal} ${yellow}${TS_MODE}${normal}, ${blue}socks5:${normal} ${yellow}127.0.0.1:${SOCKS_PORT}${normal}"
  return 0
}

usage() {
  printf '%s\n' "${yellow}usage${normal}: ${green}${scripts_name}${normal} {${orange}start|stop|restart|status${normal}}"
}

case "$1" in
  start)
    tun_start
    ;;
  stop)
    tun_stop
    ;;
  restart)
    tun_stop || exit 1
    sleep 1
    tun_start
    ;;
  status)
    tun_status
    ;;
  *)
    if [ -n "$1" ]; then
      printf '%s\n' "${yellow}${scripts_name} ${orange}$1 ${red}not found${normal}"
      exit 1
    fi
    usage
    ;;
esac
