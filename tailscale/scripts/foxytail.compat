#!/system/bin/sh
# FoxyTail - coexistence probe.
#
# Subcommands:
#   probe            scan for coexisting proxy/firewall/vpn modules + apps,
#                    print JSON: {"modules":[...],"apps":[...],"warnings":[...]}
#   check            verify FOXY_* iptables chains are still in place; on
#                    tampering write $TS_RUN_DIR/compat-alert and exit 1
#   check-dns-hijack exit 1 when someone else redirects/TProxy's port 53 in
#                    the nat OUTPUT chain, exit 0 when the coast is clear
#   suggest          plain-text coexistence recommendations based on probe

DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "$DIR"/../settings.sh
load_conf
ensure_run_dirs

ALERT_FILE="${TS_RUN_DIR}/compat-alert"

# Map a lower-case name to a category: proxy | firewall | vpn (empty = ignore).
classify() {
  case "$1" in
    # Explicit exclusions: system/vendor apps that merely contain a keyword.
    *sandbox* | *searchbox*) ;;
    *clash* | *mihomo* | *sing-box* | *singbox* | *box4magisk* | *box-for-magisk* | *nekobox* | *hiddify* | *surfing*) echo "proxy" ;;
    *afwall*) echo "firewall" ;;
    *netguard*) echo "vpn" ;;
  esac
}

probe() {
  if ! have_jq; then
    echo '{"modules":[],"apps":[],"warnings":["jq binary not available; probe disabled"]}'
    return 0
  fi

  _mods=""
  _apps=""
  _warns=""
  _proxy_names=""
  _firewall_names=""
  _vpn_names=""

  # Magisk/KernelSU modules.
  for _d in /data/adb/modules/*/; do
    [ -d "$_d" ] || continue
    _n=$(basename "$_d")
    [ "$_n" = "foxytail" ] && continue
    _l=$(echo "$_n" | tr 'A-Z' 'a-z')
    _k=$(classify "$_l")
    [ -n "$_k" ] || continue
    _mods="${_mods}$(jqr -n -c --arg n "$_n" --arg p "${_d%/}" --arg k "$_k" \
      '{name:$n,path:$p,kind:$k}')
"
    case "$_k" in
      proxy) _proxy_names="${_proxy_names}${_n} " ;;
      firewall) _firewall_names="${_firewall_names}${_n} " ;;
      vpn) _vpn_names="${_vpn_names}${_n} " ;;
    esac
  done

  # Installed apps (works in a su context).
  if command -v pm >/dev/null 2>&1; then
    for _p in $(pm list packages 2>/dev/null | sed 's/^package://'); do
      _l=$(echo "$_p" | tr 'A-Z' 'a-z')
      _k=$(classify "$_l")
      [ -n "$_k" ] || continue
      _apps="${_apps}$(jqr -n -c --arg p "$_p" --arg k "$_k" \
        '{package:$p,kind:$k}')
"
      case "$_k" in
        proxy) _proxy_names="${_proxy_names}${_p} " ;;
        firewall) _firewall_names="${_firewall_names}${_p} " ;;
        vpn) _vpn_names="${_vpn_names}${_p} " ;;
      esac
    done
  fi

  [ -n "$_proxy_names" ] && _warns="${_warns}$(jqr -n -c \
    --arg w "Proxy tool detected: ${_proxy_names% }. Its DNS hijack may conflict with MagicDNS; consider MAGIC_DNS=off" \
    '$w')
"
  [ -n "$_firewall_names" ] && _warns="${_warns}$(jqr -n -c \
    --arg w "Firewall tool detected: ${_firewall_names% }. Its rule reloads may wipe the FOXY_* chains; run foxytail.compat check periodically" \
    '$w')
"
  [ -n "$_vpn_names" ] && _warns="${_warns}$(jqr -n -c \
    --arg w "VPN app detected: ${_vpn_names% }. Android allows only one VPN interface at a time; it may grab the tunnel" \
    '$w')
"
  if check_dns_hijack_quiet; then
    _warns="${_warns}$(jqr -n -c \
      --arg w "nat OUTPUT already redirects/TPROXYs port 53; confirm the owner before enabling MagicDNS" \
      '$w')
"
  fi

  _m_json=$(printf '%s' "$_mods" | jqr -s '.')
  _a_json=$(printf '%s' "$_apps" | jqr -s '.')
  _w_json=$(printf '%s' "$_warns" | jqr -s '.')
  jqr -n --argjson m "$_m_json" --argjson a "$_a_json" --argjson w "$_w_json" \
    '{modules:$m,apps:$a,warnings:$w}'
}

# Quiet variant for internal use: 0 = hijack present, 1 = clear.
check_dns_hijack_quiet() {
  iptables -t nat -L OUTPUT -n 2>/dev/null | grep -q 'dpt:53'
}

check() {
  # Nothing to verify while tailscaled is down or in proxy mode (no chains).
  if [ "${TS_MODE}" = "proxy" ] || ! pidof tailscaled >/dev/null 2>&1; then
    rm -f "$ALERT_FILE"
    return 0
  fi

  _problems=""
  # Chain homes are defined by foxytail.route: FOXY_MARK lives in mangle,
  # FOXY_STAT in filter. A bare `iptables -L` probes the filter table only.
  if ! iptables -t mangle -L FOXY_MARK -n >/dev/null 2>&1; then
    _problems="${_problems}- FOXY_MARK chain missing in the mangle table
"
  fi
  if ! iptables -t filter -L FOXY_STAT -n >/dev/null 2>&1; then
    _problems="${_problems}- FOXY_STAT chain missing in the filter table
"
  fi
  if ! iptables -t mangle -S 2>/dev/null | grep -q 'FOXY_'; then
    _problems="${_problems}- no jump to FOXY_* in the mangle table
"
  fi
  if ! iptables -S 2>/dev/null | grep -q 'FOXY_'; then
    _problems="${_problems}- no jump to FOXY_* in the filter table
"
  fi

  if [ -n "$_problems" ]; then
    log Error "FoxyTail iptables chains were wiped by another tool; run 'foxytail.route apply' to restore"
    {
      echo "time: $(date +"%Y-%m-%d %H:%M:%S")"
      echo "problem: FoxyTail iptables chains missing while tailscaled is running"
      printf '%s' "$_problems"
    } >"$ALERT_FILE"
    return 1
  fi

  rm -f "$ALERT_FILE"
  return 0
}

check_dns_hijack() {
  if check_dns_hijack_quiet; then
    log Warning "port 53 is already redirected/TProxied in nat OUTPUT by another tool"
    return 1
  fi
  return 0
}

suggest() {
  _json=$(probe)
  if ! have_jq; then
    echo "jq is not available; no suggestions can be made"
    return 0
  fi
  _found=0

  _names=$(echo "$_json" | jqr -r \
    '[.modules[] | select(.kind=="proxy") | .name] +
     [.apps[] | select(.kind=="proxy") | .package] | unique | .[]' 2>/dev/null)
  if [ -n "$_names" ]; then
    _found=1
    echo "$_names" | while IFS= read -r _n; do
      echo "Proxy tool detected (${_n}): consider MAGIC_DNS=off and avoid overlapping its fake-ip/TPROXY subnets"
    done
  fi

  _names=$(echo "$_json" | jqr -r \
    '[.modules[] | select(.kind=="firewall") | .name] +
     [.apps[] | select(.kind=="firewall") | .package] | unique | .[]' 2>/dev/null)
  if [ -n "$_names" ]; then
    _found=1
    echo "$_names" | while IFS= read -r _n; do
      echo "Firewall tool detected (${_n}): whitelist FoxyTail; if the chains get wiped, run foxytail.compat check and re-run foxytail.route apply"
    done
  fi

  _names=$(echo "$_json" | jqr -r \
    '[.modules[] | select(.kind=="vpn") | .name] +
     [.apps[] | select(.kind=="vpn") | .package] | unique | .[]' 2>/dev/null)
  if [ -n "$_names" ]; then
    _found=1
    echo "$_names" | while IFS= read -r _n; do
      echo "VPN app detected (${_n}): Android allows only one VPN; disable one of them or use bridge/proxy mode"
    done
  fi

  if check_dns_hijack_quiet; then
    _found=1
    echo "Port 53 is already redirected: consider MAGIC_DNS=off, or confirm the rule's owner before coexisting"
  fi

  [ "$_found" = "0" ] && echo "No known conflicting modules or apps detected; no special configuration needed"
}

case "$1" in
  probe) probe ;;
  check) check ;;
  check-dns-hijack) check_dns_hijack ;;
  suggest) suggest ;;
  *)
    echo "usage: $0 {probe|check|check-dns-hijack|suggest}" >&2
    exit 1
    ;;
esac
