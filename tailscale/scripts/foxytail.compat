#!/system/bin/sh
# FoxyTail - coexistence probe.
#
# Subcommands:
#   probe            scan for coexisting proxy/firewall/vpn modules + apps,
#                    print JSON: {"modules":[...],"apps":[...],"warnings":[...]}
#   check            verify FOXY_* iptables chains are still in place; on
#                    tampering write $TS_RUN_DIR/compat-alert and exit 1
#   check-dns-hijack exit 1 when someone else redirects/TProxy's port 53 in
#                    IPv4/IPv6 nat or mangle, exit 0 when clear
#   suggest          plain-text coexistence recommendations based on probe

DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "$DIR"/../settings.sh
# check paths compare live chains against the APPLIED runtime configuration;
# a saved but unapplied TS_MODE/IPV6 change would skew the proxy-skip and
# ip6tables verdicts. probe/suggest stay on the saved configuration, matching
# what diag records for forensics.
case "${1:-}" in
  check | check-dns-hijack) load_runtime_conf || exit 1 ;;
  *) load_conf || exit 1 ;;
esac
ensure_run_dirs

ALERT_FILE="${TS_RUN_DIR}/compat-alert"
trap 'exit 130' HUP INT TERM

# Share one classifier across module names and the complete package inventory.
_compat_kind='def kind: ascii_downcase |
  if test("sandbox|searchbox") then ""
  elif test("clash|mihomo|sing-box|singbox|box4magisk|box-for-magisk|nekobox|hiddify|surfing") then "proxy"
  elif contains("afwall") then "firewall"
  elif contains("netguard") then "vpn"
  else "" end;'

probe() {
  if ! have_jq; then
    echo '{"modules":[],"apps":[],"warnings":["jq binary not available; probe disabled"]}'
    return 0
  fi

  _mods=""
  for _d in /data/adb/modules/*/; do
    [ -d "$_d" ] || continue
    _path=${_d%/}; _n=${_path##*/}
    [ "$_n" = foxytail ] && continue
    _mods="${_mods}$(jqr -n -c --arg n "$_n" --arg p "$_path" "${_compat_kind}"'
      ($n | kind) as $kind | select($kind != "") | {name:$n,path:$p,kind:$kind}')
"
  done
  _apps='[]'
  if command -v pm >/dev/null 2>&1; then
    _apps=$(pm list packages 2>/dev/null | jqr -R -s -c "${_compat_kind}"'
      split("\n") | map(sub("\r$"; "") | select(startswith("package:")) | ltrimstr("package:") |
        . as $package | kind as $kind | select($kind != "") | {package:$package,kind:$kind})') || return 1
  fi
  # Installed apps are inventory, not evidence of a live DNS conflict.
  _dns_conflict=false
  if check_dns_hijack_quiet; then _dns_conflict=true; fi
  printf '%s' "$_mods" | jqr -s --argjson apps "$_apps" --argjson dnsConflict "$_dns_conflict" '
    . as $modules | ($modules + $apps) as $inventory |
    ($inventory | map(select(.kind=="firewall") | .name // .package) | join(" ")) as $firewalls |
    ($inventory | map(select(.kind=="vpn") | .name // .package) | join(" ")) as $vpns |
    {modules:$modules,apps:$apps,warnings:[
      (if $firewalls!="" then "Firewall tool detected: \($firewalls). Its rule reloads may wipe the FOXY_* chains; run foxytail.compat check periodically" else empty end),
      (if $vpns!="" then "VPN app detected: \($vpns). Android allows only one VPN interface at a time; it may grab the tunnel" else empty end),
      (if $dnsConflict then "IPv4/IPv6 nat or mangle redirects/TPROXYs port 53; confirm the owner before enabling MagicDNS" else empty end)
    ]}'
}

# Conservatively follow paths that can carry UDP/TCP destination port 53.
# Unknown matches may include DNS; disjoint port/protocol intersections cannot.
check_dns_hijack_quiet() {
  for _dh_cmd in iptables ip6tables; do
    for _dh_table in nat mangle; do
      _dh_rules=$("${_dh_cmd}" -t "${_dh_table}" -S 2>/dev/null) || {
        [ "${_dh_cmd}" = ip6tables ] && [ "${IPV6:-off}" != on ] && continue
        if [ "${_dh_cmd}:${_dh_table}" = ip6tables:nat ] &&
          [ -r /proc/net/ip6_tables_names ] && ! grep -qx nat /proc/net/ip6_tables_names &&
          ip6tables -t filter -S >/dev/null 2>&1; then continue; fi
        return 0
      }
      _dh_verdict=$(printf '%s\n' "${_dh_rules}" | awk -v table="${_dh_table}" '
        # Exact rules emitted by the pinned Android tailscaled DNS manager
        # are compatible with our earlier local resolver jump. Do not exempt
        # arbitrary rules merely because they mention Quad100 or port 53.
        function native_rule(line, ip, family) {
          if (table != "nat") return 0
          gsub(/ -m udp/, "", line)
          gsub(/100\.100\.100\.100\/32/, "100.100.100.100", line)
          gsub(/fd7a:115c:a1e0::53\/128/, "fd7a:115c:a1e0::53", line)
          gsub(/\[fd7a:115c:a1e0::53\]:53/, "fd7a:115c:a1e0::53:53", line)
          for (family=1; family<=2; family++) {
            ip=(family==1 ? "100.100.100.100" : "fd7a:115c:a1e0::53")
            if (line == "-A OUTPUT ! -d " ip " ! -o tun+ -p udp --dport 53 -j DNAT --to-destination " ip ":53" ||
                line == "-A OUTPUT ! -o tun+ ! -d " ip " -p udp --dport 53 -j DNAT --to-destination " ip ":53" ||
                line == "-A PREROUTING ! -i tun+ -p udp --dport 53 -j DNAT --to-destination " ip ":53") return 1
          }
          return 0
        }
        function own(chain) {return chain=="FOXY_DNS" || chain=="FOXY_DNS_QUEUE" || chain=="FOXY_DNS_CAPTURE"}
        function port53(value, parts,ranges,count,k,lo,hi,unknown) {
          count=split(value,parts,","); unknown=0
          for(k=1;k<=count;k++) {
            if(parts[k]=="domain") return 1
            if(parts[k] ~ /^[0-9]+$/) {if(parts[k]+0==53) return 1; continue}
            if(parts[k] ~ /^[0-9]*:[0-9]*$/) {
              split(parts[k],ranges,":"); lo=(ranges[1]=="" ? 0 : ranges[1]+0); hi=(ranges[2]=="" ? 65535 : ranges[2]+0)
              if(lo<=53 && hi>=53) return 1
            } else unknown=1
          }
          return unknown ? 2 : 0
        }
        native_rule($0) {next}
        $1=="-A" && !own($2) {
          n++; source[n]=$2; udp[n]=1; tcp[n]=1; dns[n]=1
          for(i=3;i<NF;i++) {
            if(($i=="-j" || $i=="-g") && !own($(i+1))) target[n]=$(i+1)
            if($i=="--dport" || $i=="--destination-port" || $i=="--dports" || $i=="--destination-ports") {
              neg=($(i-1)=="!" || $(i+1)=="!"); value=$(i+1+($(i+1)=="!")); covers=port53(value)
              if(covers!=2 && ((!neg && !covers) || (neg && covers))) dns[n]=0
            }
            if($i=="-p" || $i=="--protocol") {
              neg=($(i-1)=="!" || $(i+1)=="!"); value=$(i+1+($(i+1)=="!"))
              if(value=="udp" || value=="17") {if(neg) udp[n]=0; else tcp[n]=0}
              else if(value=="tcp" || value=="6") {if(neg) tcp[n]=0; else udp[n]=0}
              else if(value=="all" || value=="0") {if(neg) {udp[n]=0; tcp[n]=0}}
              else if(!neg && (value=="icmp" || value=="icmpv6" || value=="ipv6-icmp" || value=="1" || value=="58")) {udp[n]=0; tcp[n]=0}
            }
          }
        }
        END {
          u["OUTPUT"]=1; u["PREROUTING"]=1; t["OUTPUT"]=1; t["PREROUTING"]=1
          for(pass=0;pass<=n;pass++) for(i=1;i<=n;i++) {
            if(!dns[i] || target[i]=="") continue
            pu=u[source[i]] && udp[i]; pt=t[source[i]] && tcp[i]
            if(!pu && !pt) continue
            if(target[i]~/^(REDIRECT|DNAT|TPROXY)$/) {print "conflict"; exit 0}
            if(pu) u[target[i]]=1
            if(pt) t[target[i]]=1
          }
          print "clear"
        }') || return 0
      [ "${_dh_verdict}" = clear ] || return 0
    done
  done
  return 1
}

check() {
  if [ "${TS_MODE}" = proxy ] || [ -z "$(pids_of_path "${TS_BIN_DIR}/tailscaled")" ]; then
    rm -f "$ALERT_FILE"
    return 0
  fi
  if "${TS_SCRIPTS_DIR}/foxytail.route" check >/dev/null 2>&1; then
    rm -f "$ALERT_FILE"
    return 0
  fi
  log Error "FoxyTail desired routing is incomplete; run foxytail.route apply"
  {
    echo "time: $(date +"%Y-%m-%d %H:%M:%S")"
    echo "problem: missing or changed FoxyTail chains, jumps, rules or routes"
  } >"$ALERT_FILE"
  return 1
}

check_dns_hijack() {
  if check_dns_hijack_quiet; then
    log Warning "port 53 is already redirected/TProxied in nat/mangle by another tool"
    return 1
  fi
  return 0
}

suggest() {
  _json=$(probe)
  if ! have_jq; then
    echo "jq is not available; no suggestions can be made"
    return 0
  fi
  _found=0

  _names=$(echo "$_json" | jqr -r \
    '[.modules[] | select(.kind=="proxy") | .name] +
     [.apps[] | select(.kind=="proxy") | .package] | unique | .[]' 2>/dev/null)
  if [ -n "$_names" ]; then
    _found=1
    echo "$_names" | while IFS= read -r _n; do
      echo "Proxy tool installed (${_n}): check-dns-hijack reports whether DNS interception is currently active; installation alone does not require disabling MagicDNS"
    done
  fi

  _names=$(echo "$_json" | jqr -r \
    '[.modules[] | select(.kind=="firewall") | .name] +
     [.apps[] | select(.kind=="firewall") | .package] | unique | .[]' 2>/dev/null)
  if [ -n "$_names" ]; then
    _found=1
    echo "$_names" | while IFS= read -r _n; do
      echo "Firewall tool detected (${_n}): whitelist FoxyTail; if the chains get wiped, run foxytail.compat check and re-run foxytail.route apply"
    done
  fi

  _names=$(echo "$_json" | jqr -r \
    '[.modules[] | select(.kind=="vpn") | .name] +
     [.apps[] | select(.kind=="vpn") | .package] | unique | .[]' 2>/dev/null)
  if [ -n "$_names" ]; then
    _found=1
    echo "$_names" | while IFS= read -r _n; do
      echo "VPN app detected (${_n}): Android allows only one VPN; disable one of them or use bridge/proxy mode"
    done
  fi

  if check_dns_hijack_quiet; then
    _found=1
    echo "Port 53 is already redirected: consider MAGIC_DNS=off, or confirm the rule's owner before coexisting"
  fi

  [ "$_found" = "0" ] && echo "No known conflicting modules or apps detected; no special configuration needed"
}

case "$1" in
  probe) probe ;;
  check) check ;;
  check-dns-hijack) check_dns_hijack ;;
  suggest) suggest ;;
  *)
    echo "usage: $0 {probe|check|check-dns-hijack|suggest}" >&2
    exit 1
    ;;
esac
