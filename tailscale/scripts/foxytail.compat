#!/system/bin/sh
# FoxyTail - coexistence probe.
#
# Subcommands:
#   probe            scan for coexisting proxy/firewall/vpn modules + apps,
#                    print JSON: {"modules":[...],"apps":[...],"warnings":[...]}
#   check            verify FOXY_* iptables chains are still in place; on
#                    tampering write $TS_RUN_DIR/compat-alert and exit 1
#   check-dns-hijack exit 1 when someone else redirects/TProxy's port 53 in
#                    the nat OUTPUT chain, exit 0 when the coast is clear
#   suggest          plain-text coexistence recommendations based on probe

DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "$DIR"/../settings.sh
load_conf
ensure_run_dirs

ALERT_FILE="${TS_RUN_DIR}/compat-alert"

# Map a lower-case name to a category: proxy | firewall | vpn (empty = ignore).
classify() {
  case "$1" in
    *clash* | *mihomo* | *box*) echo "proxy" ;;
    *afwall*) echo "firewall" ;;
    *netguard*) echo "vpn" ;;
  esac
}

probe() {
  if ! command -v jq >/dev/null 2>&1; then
    echo '{"modules":[],"apps":[],"warnings":["jq binary not available; probe disabled"]}'
    return 0
  fi

  _mods=""
  _apps=""
  _warns=""
  _proxy_names=""
  _firewall_names=""
  _vpn_names=""

  # Magisk/KernelSU modules.
  for _d in /data/adb/modules/*/; do
    [ -d "$_d" ] || continue
    _n=$(basename "$_d")
    [ "$_n" = "foxytail" ] && continue
    _l=$(echo "$_n" | tr 'A-Z' 'a-z')
    _k=$(classify "$_l")
    [ -n "$_k" ] || continue
    _mods="${_mods}$(jq -n -c --arg n "$_n" --arg p "${_d%/}" --arg k "$_k" \
      '{name:$n,path:$p,kind:$k}')\n"
    case "$_k" in
      proxy) _proxy_names="${_proxy_names}${_n} " ;;
      firewall) _firewall_names="${_firewall_names}${_n} " ;;
      vpn) _vpn_names="${_vpn_names}${_n} " ;;
    esac
  done

  # Installed apps (works in a su context).
  if command -v pm >/dev/null 2>&1; then
    for _p in $(pm list packages 2>/dev/null | sed 's/^package://'); do
      _l=$(echo "$_p" | tr 'A-Z' 'a-z')
      _k=$(classify "$_l")
      [ -n "$_k" ] || continue
      _apps="${_apps}$(jq -n -c --arg p "$_p" --arg k "$_k" \
        '{package:$p,kind:$k}')\n"
      case "$_k" in
        proxy) _proxy_names="${_proxy_names}${_p} " ;;
        firewall) _firewall_names="${_firewall_names}${_p} " ;;
        vpn) _vpn_names="${_vpn_names}${_p} " ;;
      esac
    done
  fi

  [ -n "$_proxy_names" ] && _warns="${_warns}$(jq -n -c \
    --arg w "检测到代理工具: ${_proxy_names% }。若开启 MagicDNS 可能与其 DNS 劫持冲突,建议 MAGIC_DNS=off" \
    '$w')\n"
  [ -n "$_firewall_names" ] && _warns="${_warns}$(jq -n -c \
    --arg w "检测到防火墙工具: ${_firewall_names% }。其规则重载可能清除 FOXY_* 链,请定期运行 foxytail.compat check" \
    '$w')\n"
  [ -n "$_vpn_names" ] && _warns="${_warns}$(jq -n -c \
    --arg w "检测到 VPN 应用: ${_vpn_names% }。Android 同时只允许一个 VPN 接口,可能抢占隧道" \
    '$w')\n"
  if check_dns_hijack_quiet; then
    _warns="${_warns}$(jq -n -c \
      --arg w "nat OUTPUT 链已存在对 53 端口的重定向/TPROXY 规则,启用 MagicDNS 前请确认归属" \
      '$w')\n"
  fi

  _m_json=$(printf '%b' "$_mods" | jq -s '.')
  _a_json=$(printf '%b' "$_apps" | jq -s '.')
  _w_json=$(printf '%b' "$_warns" | jq -s '.')
  jq -n --argjson m "$_m_json" --argjson a "$_a_json" --argjson w "$_w_json" \
    '{modules:$m,apps:$a,warnings:$w}'
}

# Quiet variant for internal use: 0 = hijack present, 1 = clear.
check_dns_hijack_quiet() {
  iptables -t nat -L OUTPUT -n 2>/dev/null | grep -q 'dpt:53'
}

check() {
  # Nothing to verify while tailscaled is down or in proxy mode (no chains).
  if [ "${TS_MODE}" = "proxy" ] || ! pidof tailscaled >/dev/null 2>&1; then
    rm -f "$ALERT_FILE"
    return 0
  fi

  _problems=""
  if ! iptables -L FOXY_MARK -n >/dev/null 2>&1; then
    _problems="${_problems}- mangle 表 FOXY_MARK 链缺失\n"
  fi
  if ! iptables -t mangle -S 2>/dev/null | grep -q 'FOXY_'; then
    _problems="${_problems}- mangle 表中没有指向 FOXY_* 的跳转\n"
  fi
  if ! iptables -S 2>/dev/null | grep -q 'FOXY_'; then
    _problems="${_problems}- filter 表中没有指向 FOXY_* 的跳转\n"
  fi

  if [ -n "$_problems" ]; then
    log Error "FoxyTail iptables chains were wiped by another tool; run 'foxytail.route apply' to restore"
    {
      echo "time: $(date +"%Y-%m-%d %H:%M:%S")"
      echo "problem: FoxyTail iptables chains missing while tailscaled is running"
      printf '%b' "$_problems"
    } >"$ALERT_FILE"
    return 1
  fi

  rm -f "$ALERT_FILE"
  return 0
}

check_dns_hijack() {
  if check_dns_hijack_quiet; then
    log Warning "port 53 is already redirected/TProxied in nat OUTPUT by another tool"
    return 1
  fi
  return 0
}

suggest() {
  _json=$(probe)
  if ! command -v jq >/dev/null 2>&1; then
    echo "jq 不可用,无法给出建议"
    return 0
  fi
  _found=0

  _names=$(echo "$_json" | jq -r \
    '[.modules[] | select(.kind=="proxy") | .name] +
     [.apps[] | select(.kind=="proxy") | .package] | unique | .[]' 2>/dev/null)
  if [ -n "$_names" ]; then
    _found=1
    echo "$_names" | while IFS= read -r _n; do
      echo "检测到代理工具 ${_n}: 建议 MAGIC_DNS=off,并避免与其 fake-ip/TPROXY 网段重叠"
    done
  fi

  _names=$(echo "$_json" | jq -r \
    '[.modules[] | select(.kind=="firewall") | .name] +
     [.apps[] | select(.kind=="firewall") | .package] | unique | .[]' 2>/dev/null)
  if [ -n "$_names" ]; then
    _found=1
    echo "$_names" | while IFS= read -r _n; do
      echo "检测到防火墙工具 ${_n}: 建议将 FoxyTail 加入其白名单;掉链时运行 foxytail.compat check 并重新 foxytail.route apply"
    done
  fi

  _names=$(echo "$_json" | jq -r \
    '[.modules[] | select(.kind=="vpn") | .name] +
     [.apps[] | select(.kind=="vpn") | .package] | unique | .[]' 2>/dev/null)
  if [ -n "$_names" ]; then
    _found=1
    echo "$_names" | while IFS= read -r _n; do
      echo "检测到 VPN 应用 ${_n}: Android 仅允许单 VPN,建议停用其一或使用 bridge/proxy 模式"
    done
  fi

  if check_dns_hijack_quiet; then
    _found=1
    echo "检测到 53 端口已被重定向: 建议 MAGIC_DNS=off,或确认该规则归属后手动共存"
  fi

  [ "$_found" = "0" ] && echo "未检测到已知冲突的模块或应用,无需特殊配置"
}

case "$1" in
  probe) probe ;;
  check) check ;;
  check-dns-hijack) check_dns_hijack ;;
  suggest) suggest ;;
  *)
    echo "usage: $0 {probe|check|check-dns-hijack|suggest}" >&2
    exit 1
    ;;
esac
