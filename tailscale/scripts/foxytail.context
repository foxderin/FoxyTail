#!/system/bin/sh
# FoxyTail - network context awareness (Wi-Fi SSID / cellular rules).
#
# Subcommands:
#   start       resident loop (exits when context.conf has no effective rules)
#   stop        stop the resident loop
#   status      JSON: {"running":bool,"context":...,"lastResult":object|null}
#   check-once  detect the current context, apply actions on change, exit
#   validate    validate a rules file without loading the main configuration

DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "$DIR"/../settings.sh

PID_FILE="${TS_PID_DIR}/foxytail.context.pid"
TS_SOCKET="${TS_RUN_DIR}/tailscaled.sock"
STATE_FILE="${TS_RUN_DIR}/context.state"
RESULT_FILE="${TS_RUN_DIR}/context.result.json"
RULES_FILE="${TS_CONF_DIR}/context.conf"
INTERVAL=20

SERVICE="${TS_SCRIPTS_DIR}/foxytail.service"

# Keep command capability in this resident process. A transient Binder/network
# failure falls back this round without permanently disabling the compact API.
get_ssid() {
  _w=
  if [ "${_wifi_command:-}" != unsupported ]; then
    if command -v cmd >/dev/null 2>&1; then
      _w=$(tmo 5 cmd wifi status 2>/dev/null)
      _wifi_rc=$?
      case "$_wifi_rc" in 126|127) _wifi_command=unsupported ;; esac
      case "$_w" in
        *'Unknown command'*|*'Unknown option'*|*'No shell command implementation'*|*'usage:'*|*'Usage:'*) _wifi_command=unsupported; _w= ;;
        *'SSID: '*|*'Wifi is '*|*'Wi-Fi is '*) [ "$_wifi_rc" = 0 ] || _w= ;;
        *) _w= ;;
      esac
    else
      _wifi_command=unsupported
    fi
  fi
  [ -n "$_w" ] || _w=$(tmo 5 dumpsys wifi 2>/dev/null)
  _ssid=$(printf '%s\n' "$_w" | awk '
    match($0, /(^|[[:space:],])SSID: /) {
      value=substr($0,RSTART+RLENGTH)
      if (substr(value,1,1)=="\"") {value=substr(value,2); sub(/".*/,"",value)}
      else sub(/,.*/,"",value)
      if (value=="" || value=="<unknown ssid>" || value=="<none>") value="unknown"
      print value; found=1; exit
    }
    END {if (!found) print "unknown"}
  ')
}

# Set the current context token. Cellular-only rules need no Wi-Fi Binder call;
# explicit status reads still obtain the actual SSID for display.
current_context() {
  _def=$(ip route show default 2>/dev/null)
  case "$_def" in
    '') _ctx=none:- ;;
    *'dev wlan'*)
      _ssid=unknown
      [ "${1:-}" = cellular-only ] || get_ssid
      _ctx="ssid:${_ssid}" ;;
    *) _ctx=cellular:- ;;
  esac
}

# Emit normalized rules; callers discard all output if any line is invalid.
# awk reads the final record even when the file has no trailing newline.
parse_rules() {
  [ -f "$1" ] && [ ! -L "$1" ] && [ -r "$1" ] || {
    printf '%s: expected readable regular rules file\n' "$1" >&2
    return 1
  }
  _pr_file=$1
  case "$_pr_file" in /*) ;; *) _pr_file=./$_pr_file ;; esac
  LC_ALL=C awk '
    function error(message) {
      printf "%s:%d: %s\n", FILENAME, FNR, message > "/dev/stderr"
      failed=1
    }
    {
      sub(/\r$/, "")
      sub(/^[ \t]+/, ""); sub(/[ \t]+$/, "")
      if ($0 == "" || substr($0,1,1) == "#") next
      if ($0 ~ /[[:cntrl:]]/) {error("control characters are unsupported"); next}
      if (index($0,"#")) {error("# is only allowed in whole-line comments, not SSIDs or arguments"); next}
      n=split($0,f,":")
      if (n<3) {error("expected trigger:value:action[:arg]"); next}
      if (f[1] != "ssid" && f[1] != "cellular") {error("unknown trigger; use ssid or cellular"); next}
      if (f[1] == "cellular" && f[2] != "-") {error("cellular value must be -"); next}
      if (f[1] == "ssid" && (f[2] ~ /^ *$/ || index(f[2],"\"") ||
          f[2] == "unknown" || f[2] == "<unknown ssid>" || f[2] == "<none>")) {
        error("SSID must be nonempty, unquoted, and not an unknown-network placeholder"); next
      }
      arg=""
      if (f[3] == "exit-node") {
        arg=substr($0,length(f[1])+length(f[2])+length(f[3])+4)
        if (arg !~ /^[A-Za-z0-9:][A-Za-z0-9_.:%-]*$/) {
          error("exit-node requires a node name or IP address argument"); next
        }
      } else if (f[3] == "up" || f[3] == "down" || f[3] == "no-exit-node") {
        if (n != 3) {error("action takes no argument; : is unsupported in SSIDs"); next}
      } else {error("unknown action; : is unsupported in SSIDs"); next}
      print f[1] ":" f[2] ":" f[3] ":" arg
    }
    END {exit failed ? 1 : 0}
  ' "$_pr_file"
}

# An absent optional file means no rules. An existing malformed file is an error.
read_rules() {
  [ -e "$RULES_FILE" ] || [ -L "$RULES_FILE" ] || return 0
  parse_rules "$RULES_FILE"
}

run_action() {
  _act="$1"
  _arg="$2"
  case "$_act" in
    up)
      log Info "context: action up (foxytail.service start --applied)"
      [ -x "$SERVICE" ] && "$SERVICE" start --applied >>"${TS_RUN_LOG_FILE}" 2>&1
      ;;
    down)
      log Info "context: action down (foxytail.service stop)"
      [ -x "$SERVICE" ] && "$SERVICE" stop >>"${TS_RUN_LOG_FILE}" 2>&1
      ;;
    exit-node)
      log Info "context: action exit-node"
      tmo 10 tailscale --socket="$TS_SOCKET" set --exit-node="$_arg" >/dev/null 2>&1
      ;;
    no-exit-node)
      log Info "context: action no-exit-node"
      tmo 10 tailscale --socket="$TS_SOCKET" set --exit-node= >/dev/null 2>&1
      ;;
    *)
      log Error "context: unknown action '${_act}'"
      return 1
      ;;
  esac
}

# Replay the whole ordered group on failure: a later down can undo an earlier
# up. Service start/stop and tailscale set are idempotent desired-state actions.
apply_context() {
  _ac_kind=${1%%:*}
  _ac_val=${1#*:}
  _ac_failed=0 _ac_matched=0
  while IFS=: read -r _trig _tval _act _arg; do
    [ "$_trig" = "$_ac_kind" ] || continue
    if [ "$_ac_kind" = "ssid" ] && [ "$_tval" != "$_ac_val" ]; then
      continue
    fi
    _ac_matched=1
    if ! run_action "$_act" "$_arg"; then
      _ac_failed=1
      log Warning "context: action '${_act}' failed; retrying next round"
    fi
  done <<EOF_RULES
$2
EOF_RULES
  return "$_ac_failed"
}

record_result() {
  _cr_tmp=$(mktemp "${RESULT_FILE}.XXXXXX") || return 1
  if jqr -n -c --arg c "$_ctx" --argjson ok "$1" --argjson at "$(date +%s)" \
    '{context:$c,ok:$ok,at:$at} + (if $ok then {} else {error:"context-action-failed"} end)' \
    >"$_cr_tmp" && mv -f "$_cr_tmp" "$RESULT_FILE"; then
    return 0
  fi
  rm -f "$_cr_tmp"
  return 1
}

# Retry unconfirmed contexts; replay when the rules or applied snapshot change.
check_once() {
  load_runtime_conf || return 1
  [ "${CONTEXT:-on}" = on ] || return 0
  RULES_FILE="${_RUNTIME_CONF_DIR}/context.conf"
  _rules=$(read_rules) || return 1
  if [ -z "$_rules" ]; then
    rm -f "$STATE_FILE" "$RESULT_FILE"
    return $?
  fi
  case "$_rules" in ssid:*|*'
ssid:'*) current_context ;; *) current_context cellular-only ;; esac
  _old=
  [ ! -f "$STATE_FILE" ] || IFS= read -r _old <"$STATE_FILE"
  if [ "$_ctx" != "$_old" ] || [ "${_applied_rules-$_rules}" != "$_rules" ] ||
    [ "${_applied_rules_file-$RULES_FILE}" != "$RULES_FILE" ]; then
    log Info "context: '${_old:-none}' -> '${_ctx}', applying matching rules"
    # Partial actions invalidate the previous context too, even if we return
    # to that network before the next retry.
    rm -f "$STATE_FILE" || return 1
    if ! apply_context "$_ctx" "$_rules"; then
      record_result false
      return 1
    fi
    [ "$_ac_matched" = 0 ] || record_result true || return 1
    printf '%s\n' "$_ctx" >"$STATE_FILE" || return 1
  fi
  _applied_rules=$_rules _applied_rules_file=$RULES_FILE
  return 0
}

_context_stop() {
  _ctx_running=0
}

do_start() {
  load_runtime_conf || return 1
  [ "${CONTEXT:-on}" = on ] || return 0
  RULES_FILE="${_RUNTIME_CONF_DIR}/context.conf"
  _rules=$(read_rules) || return 1
  if [ -z "$_rules" ]; then
    log Info "context: no rules in context.conf, not starting"
    rm -f "$STATE_FILE" "$RESULT_FILE"
    return $?
  fi
  daemon_claim_pidfile foxytail.context || return 0
  # Force the first resident round to replay the rules: the persisted token
  # would otherwise suppress actions that are still owed after a reboot.
  rm -f "$STATE_FILE" "$RESULT_FILE" || return 1
  _ctx_running=1
  trap '_context_stop' TERM INT
  log Info "foxytail.context started (pid $$, interval ${INTERVAL}s)"
  while [ "$_ctx_running" = "1" ]; do
    check_once
    [ "${CONTEXT:-on}" = on ] || break
    _int=$(effective_interval "$INTERVAL" 5 60 180)
    isleep "$_int"
  done
  rm -f "$PID_FILE"
  log Info "foxytail.context stopped"
  return 0
}

do_stop() {
  daemon_stop_pidfile foxytail.context
}

do_status() {
  current_context
  # Read the pid once: the loop removes the file on exit, so a second read
  # could feed jq an empty string and produce broken JSON.
  _ctx_pid=$(cat "$PID_FILE" 2>/dev/null)
  case "$_ctx_pid" in '' | *[!0-9]*) _ctx_pid="" ;; esac
  _ctx_result=$(jqr -s -c '
    if length == 1 and (.[0] | type == "object" and (.context | type) == "string"
        and (.ok | type) == "boolean" and (.at | type) == "number")
    then .[0] | {context,ok,at} + (if .ok then {} else {error:"context-action-failed"} end)
    else null end' "$RESULT_FILE" 2>/dev/null) || _ctx_result=null
  _ctx_live=false
  if [ -n "$_ctx_pid" ] && kill -0 "$_ctx_pid" 2>/dev/null; then
    _ctx_live=true
  else
    _ctx_pid=null
  fi
  jqr -n -c --argjson r "$_ctx_live" --argjson p "$_ctx_pid" --arg c "$_ctx" \
    --argjson result "$_ctx_result" '{running:$r,pid:$p,context:$c,lastResult:$result}'
}

case "$1" in
  start | check-once)
    ensure_run_dirs || exit 1
    if [ "$1" = start ]; then do_start; else check_once; fi
    ;;
  stop) do_stop ;;
  status) do_status ;;
  validate)
    [ "$#" = 2 ] && [ -n "$2" ] || { echo "usage: $0 validate <file>" >&2; exit 1; }
    parse_rules "$2" >/dev/null
    ;;
  *)
    echo "usage: $0 {start|stop|status|check-once|validate <file>}" >&2
    exit 1
    ;;
esac
