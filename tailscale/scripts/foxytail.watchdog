#!/system/bin/sh
# FoxyTail - watchdog: restart tailscaled on crash, rebind on network change.
#
# Subcommands:
#   start       resident loop (no-op when WATCHDOG=off; dedup via pid file)
#   stop        stop the resident loop
#   status      JSON: {"running":bool,...}
#   check-once  run a single check round and exit

DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "$DIR"/../settings.sh
load_conf || exit 1
ensure_run_dirs

PID_FILE="${TS_PID_DIR}/foxytail.watchdog.pid"
TS_SOCKET="${TS_RUN_DIR}/tailscaled.sock"
ROUTE_CACHE="${TS_RUN_DIR}/watchdog.route-cache"
BAD_COUNT_FILE="${TS_RUN_DIR}/watchdog.bad-count"
RESTARTS_FILE="${TS_RUN_DIR}/watchdog.restarts"
# Written by foxytail.service stop; removed by start. While present the
# watchdog must not recover tailscaled — the user asked for it to be down.
MANUAL_STOP_FILE="${TS_RUN_DIR}/manual-stop"
RESTART_LIMIT=5
RESTART_WINDOW=600
COOLDOWN=300
BACKEND_BAD_LIMIT=3

SERVICE="${TS_SCRIPTS_DIR}/foxytail.service"

# shellcheck source=foxytail.watchdog-lib.sh
. "$DIR/foxytail.watchdog-lib.sh"

case "$1" in
  start) do_start ;;
  stop) do_stop ;;
  status) do_status ;;
  check-once) check_once ;;
  *)
    echo "usage: $0 {start|stop|status|check-once}" >&2
    exit 1
    ;;
esac
