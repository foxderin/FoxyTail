#!/system/bin/sh
# @title FoxyTail Service Manager
# @header Manage and customize how tailscaled runs on your Android.
#
# @cmd start | Start tailscaled service
# @desc Reads ${TS_CONF_DIR}/foxytail.conf, builds the daemon command for the
# @desc configured TS_MODE (bridge|tun|proxy), stores output to ${TS_LOG_FILE},
# @desc writes the pid file to ${TS_PID_DIR}, then starts the companion pieces
# @desc (hev tunnel in bridge mode, MagicDNS, policy routing).
#
# @cmd stop | Stop tailscaled service
# @desc Stops MagicDNS, policy routing and the hev tunnel first, then kills
# @desc tailscaled with signal 15, waiting for self cleanup, and force kills
# @desc every remaining PID if it is still running.
#
# @cmd restart | Restart tailscaled service
# @desc Stop, wait, then start again. The old daemon log is rotated to
# @desc ${TS_LOG_FILE}.bak so the last run is always kept.
#
# @cmd status | Show current process status
# @sub summary | Show summary with Self info and peer counts (default)
# @sub peer | Show all peers (online/offline)
# @sub exit-node | Show all exit nodes
# @sub all | Show everything (Self + peers + exit nodes)
# @desc Retrieves info from the daemon via `tailscale --socket=... status
# @desc --json` (10s timeout), useful to inspect the running process.
#
# @cmd log | Logging tools
# @sub daemon | tailscaled daemon log (follow mode)
# @sub service | FoxyTail service operation log (follow mode)
# @desc View logs from the tailscaled daemon or the service scripts.
#
# @cmd mode | Switch run mode and restart
# @sub bridge | userspace networking + socks5 + hev tunnel (tailscale0)
# @sub tun | native tailscaled TUN (requires /dev/net/tun)
# @sub proxy | socks5 proxy only, no interface is created
# @desc Rewrites TS_MODE in ${TS_CONF_DIR}/foxytail.conf and restarts.
#
# @cmd help | Show this help message
# @sub all | Show detailed descriptions for all commands

# POSIX sh (Android mksh / busybox). No bashisms, no `set -e` on purpose:
# every failure path is handled explicitly.

DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "${DIR}/../settings.sh"

scripts_name=$(basename "$0")
TS_SOCKET="${TS_RUN_DIR}/tailscaled.sock"
PID_FILE="${TS_PID_DIR}/tailscaled.pid"

# Print PIDs of OUR tailscaled daemon (multi-PID safe). A bare
# `pgrep -f tailscaled` would also match `tail -F tailscaled.log`, the
# `tailscale` CLI (`tailscale --socket=... status`) and friends, so every
# candidate is verified against /proc/<pid>/cmdline: argv[0] must be the
# tailscaled binary itself (invoked by name or by absolute path).
daemon_pids() {
  pids_of_path "${TS_BIN_DIR}/${TS_DAEMON_CMD}"
}

is_running() {
  _ir_pids=$(daemon_pids)
  if [ -n "${_ir_pids}" ]; then
    # shellcheck disable=SC2086 # intentional: one PID per word
    set -- ${_ir_pids}
    log Info "✔ tailscaled service is running with PID: $1."
    return 0
  fi
  return 1
}

# Update the module description line shown in the Magisk/KernelSU manager.
# $1: "running" | "stopped"
update_mod_desc() {
  _umd_time=$(date +"%Y-%m-%d %H:%M:%S")
  if [ "$1" = "running" ]; then
    _umd_state="✔ tailscaled service is running"
  else
    _umd_state="✘ tailscaled service is stopped"
  fi
  [ -f "${TS_MOD_PROP}" ] || return 0
  sed -i "s/^description=\(\[.*][[:space:]]*\)\{0,1\}/description=[ ⏲ ${_umd_time} | ${_umd_state} ] /" "${TS_MOD_PROP}"
}

# Wait up to 10s for the tailscaled socket to appear.
wait_socket() {
  wait_for "tailscaled socket" 20 0.5 test -S "${TS_SOCKET}"
}

build_daemon_cmd() {
  _bdc_args="--statedir=${TS_DIR}/state --socket=${TS_SOCKET}"
  case "${TS_MODE}" in
    bridge|proxy)
      _bdc_args="${_bdc_args} --tun=userspace-networking --socks5-server=localhost:${SOCKS_PORT}"
      ;;
    tun)
      _bdc_args="${_bdc_args} --tun=tailscale0"
      ;;
  esac
  echo "${TS_DAEMON_CMD} ${_bdc_args}"
}

# Select once before any teardown. Restart passes the same candidate to start.
prepare_service_config() {
  if [ "${_SERVICE_RECOVERY:-0}" = 1 ]; then load_runtime_conf || return 1
  else
    [ -n "${_SERVICE_CANDIDATE:-}" ] || _SERVICE_CANDIDATE=$(conf_prepare_runtime "${TS_CONF_DIR}") || return 1
    load_conf "${_SERVICE_CANDIDATE}" || return 1
  fi
  if [ "$TS_MODE" = tun ] && [ "$ROUTE_SCOPE" != all ]; then
    log Error "native tun supports ROUTE_SCOPE=all only; use bridge for per-app routing"
    return 1
  fi
  if ! command -v "${TS_DAEMON_CMD}" >/dev/null 2>&1; then
    log Error "program not found: ${TS_DAEMON_CMD} (expected in ${TS_BIN_DIR})"
    return 1
  fi

  if [ "${TS_MODE}" = "tun" ] && [ ! -c /dev/net/tun ]; then
    log Error "TS_MODE=tun but /dev/net/tun does not exist; cannot start."
    return 1
  fi
}

start_service() {
  ensure_run_dirs
  if [ -f "${TS_DIR}/.installing" ]; then
    log Error "installation in progress; start deferred"
    return 1
  fi
  if is_running; then
    log Info "tailscaled is already running; reconciling companion layers."
    load_runtime_conf || return 1
    rm -f "${TS_RUN_DIR}/manual-stop"
    reconcile_companions
    return $?
  fi

  prepare_service_config || return 1

  if [ "${_SERVICE_RECOVERY:-0}" != 1 ]; then
    # tailscaled may have died while HEV/DNS retained the old ports and mode.
    if [ "${_SERVICE_STOPPED:-0}" != 1 ]; then stop_service || return 1; fi
    conf_activate_runtime "${_SERVICE_CANDIDATE}" || return 1
    _SERVICE_CANDIDATE=
    load_runtime_conf || return 1
  fi
  log Info "Starting tailscaled service (mode: ${TS_MODE})."
  rm -f "${TS_RUN_DIR}/manual-stop"

  mkdir -p "${TS_DIR}/state"
  rotate_log "${TS_LOG_FILE}"

  _ss_cmd=$(build_daemon_cmd)
  log Debug "daemon command: ${_ss_cmd}"
  # shellcheck disable=SC2086 # intentional: split daemon command into argv
  nohup ${_ss_cmd} >>"${TS_LOG_FILE}" 2>&1 &
  echo "$!" >"${PID_FILE}"

  if ! wait_socket; then
    if ! is_running >/dev/null 2>&1; then
      log Error "tailscaled failed to start; see ${TS_LOG_FILE}."
      return 1
    fi
    log Error "socket ${TS_SOCKET} not ready after 10s."
    return 1
  fi

  # Re-resolve the real daemon PID: a concurrent (double) start may have made
  # $! point at a losing process; the pid file must name the surviving one.
  _ss_real=$(daemon_pids)
  if [ -n "${_ss_real}" ]; then
    # shellcheck disable=SC2086 # intentional: one PID per word
    set -- ${_ss_real}
    echo "$1" >"${PID_FILE}"
  fi

  update_mod_desc running
  log Success "tailscaled started (PID: $(cat "${PID_FILE}" 2>/dev/null))."

  reconcile_companions
}

reconcile_companions() {
  # Companion pieces. Missing helpers are tolerated: they are optional
  # layers. A present helper that fails must NOT be swallowed: propagate the
  # failure so callers (foxytail.webapi.sh control) can report ok:false.
  _ss_failed=""
  case "${TS_MODE}" in
    bridge)
      if [ -x "${TS_SCRIPTS_DIR}/foxytail.tun" ]; then
        "${TS_SCRIPTS_DIR}/foxytail.tun" start || _ss_failed="${_ss_failed} foxytail.tun"
      fi
      if [ -x "${TS_SCRIPTS_DIR}/foxytail.route" ]; then
        "${TS_SCRIPTS_DIR}/foxytail.route" apply || _ss_failed="${_ss_failed} foxytail.route"
      fi
      ;;
    tun)
      if [ -x "${TS_SCRIPTS_DIR}/foxytail.route" ]; then
        "${TS_SCRIPTS_DIR}/foxytail.route" apply || _ss_failed="${_ss_failed} foxytail.route"
      fi
      ;;
    proxy)
      log Debug "proxy mode: no interface, skipping hev tunnel and policy routing."
      ;;
  esac
  if [ -x "${TS_SCRIPTS_DIR}/foxytail.dns" ]; then
    if [ "${MAGIC_DNS}" = "on" ]; then
      "${TS_SCRIPTS_DIR}/foxytail.dns" start || _ss_failed="${_ss_failed} foxytail.dns"
    else
      "${TS_SCRIPTS_DIR}/foxytail.dns" stop || _ss_failed="${_ss_failed} foxytail.dns"
    fi
  fi
  if [ -n "${_ss_failed}" ]; then
    log Error "companion layer(s) failed:${_ss_failed} (tailscaled itself is up)."
    return 1
  fi
  return 0
}

stop_service() {
  ensure_run_dirs
  load_runtime_conf || :
  log Info "Stopping tailscaled service."
  # Remember that this stop was requested (WebUI / CLI / restart). The
  # watchdog must not resurrect a daemon the user deliberately stopped;
  # start_service clears the marker again.
  date +%s >"${TS_RUN_DIR}/manual-stop"

  # Finish all cleanup attempts, but preserve failure for restart/upgrade.
  _st_failed=0
  if [ -x "${TS_SCRIPTS_DIR}/foxytail.dns" ]; then
    "${TS_SCRIPTS_DIR}/foxytail.dns" stop || _st_failed=1
  fi
  if [ -x "${TS_SCRIPTS_DIR}/foxytail.route" ]; then
    "${TS_SCRIPTS_DIR}/foxytail.route" teardown || _st_failed=1
  fi
  if [ -x "${TS_SCRIPTS_DIR}/foxytail.tun" ]; then
    "${TS_SCRIPTS_DIR}/foxytail.tun" stop || _st_failed=1
  fi

  _st_pids=$(daemon_pids)
  if [ -z "${_st_pids}" ]; then
    log Info "✘ tailscaled service is not running."
    rm -f "${PID_FILE}"
    update_mod_desc stopped
    return "$_st_failed"
  fi

  # Graceful: TERM every matching PID, wait for self cleanup, then KILL and
  # verify any survivor.
  if ! stop_by_pids tailscaled "${_st_pids}"; then
    return 1
  fi

  rm -f "${PID_FILE}"
  update_mod_desc stopped
  log Info "✘ tailscaled shut down, service is stopped."
  return "$_st_failed"
}

humanize_bytes() {
  awk -v bytes="$1" 'BEGIN {
    if (bytes < 1024) printf "%.0fB", bytes
    else if (bytes < 1048576) printf "%.2fKB", bytes/1024
    else if (bytes < 1073741824) printf "%.2fMB", bytes/1048576
    else printf "%.2fGB", bytes/1073741824
  }'
}

status_service() {
  _ss_mode="${1:-summary}"
  echo "${blue}Service Status Info${normal}"
  echo ""
  if ! is_running >/dev/null 2>&1; then
    printf '%s\n' "  ${blue}Daemon: ${red}stopped${normal}"
    return 1
  fi

  printf '%s' "  ${blue}Daemon: ${green}running${normal}"
  _ss_status=$(timeout 10 tailscale --socket="${TS_SOCKET}" status --json 2>/dev/null || echo '{}')
  _ss_backend=$(echo "${_ss_status}" | jqr -r '.BackendState // "unknown"')
  if [ "${_ss_backend}" != "Running" ]; then
    printf '%s\n' " | ${blue}Backend: ${yellow}${_ss_backend}${normal}"
    return 1
  fi
  printf '%s\n' " | ${blue}Backend: ${green}${_ss_backend}${normal}"
  printf '%s\n' " | ${blue}Mode: ${yellow}${TS_MODE}${normal}"
  echo ""

  case "${_ss_mode}" in
    summary|all)
      _ss_hostname=$(echo "${_ss_status}" | jqr -r '.Self.HostName // "-"')
      _ss_os=$(echo "${_ss_status}" | jqr -r '.Self.OS // "-"')
      _ss_relay=$(echo "${_ss_status}" | jqr -r '.Self.Relay // empty')
      if [ -f "${TS_DIR}/derpmap.cached.json" ] && [ -n "${_ss_relay}" ]; then
        _ss_relay_name=$(jqr -r --arg code "${_ss_relay}" '.Regions | to_entries[] | select(.value.RegionCode == $code) | .value.RegionName' "${TS_DIR}/derpmap.cached.json" 2>/dev/null)
        [ -n "${_ss_relay_name}" ] && _ss_relay="${_ss_relay_name}"
      fi
      [ -z "${_ss_relay}" ] && _ss_relay="-"
      _ss_ipv4=$(echo "${_ss_status}" | jqr -r '.Self.TailscaleIPs[0] // "-"')
      _ss_ipv6=$(echo "${_ss_status}" | jqr -r '.Self.TailscaleIPs[1] // "-"')

      printf '%s\n' "  ${blue}Self:${normal} ${yellow}${_ss_hostname}${normal} ${orange}(${_ss_os})${normal}"
      printf '%s\n' "    ↳ Relay: ${yellow}${_ss_relay}${normal}"
      printf '%s\n' "    ↳ Tailscale IPs: ${yellow}${_ss_ipv4}${normal}, ${yellow}${_ss_ipv6}${normal}"

      _ss_dns_on=$(echo "${_ss_status}" | jqr -r '.CurrentTailnet.MagicDNSEnabled // false')
      _ss_dns_suffix=$(echo "${_ss_status}" | jqr -r '.MagicDNSSuffix // empty')
      printf '%s' "    ↳ DNS: "
      if [ "${_ss_dns_on}" = "true" ]; then
        printf '%s\n' "${green}Enabled${normal} (${yellow}${_ss_dns_suffix}${normal})"
      else
        printf '%s\n' "${red}Disabled${normal}"
      fi

      _ss_addr_count=$(echo "${_ss_status}" | jqr -r '.Self.Addrs | length')
      printf '%s\n' "    ↳ Endpoints ${orange}(${_ss_addr_count})${normal}:"
      echo "${_ss_status}" | jqr -r '.Self.Addrs[]?' | while IFS= read -r _ss_addr; do
        _ss_ip=$(echo "${_ss_addr}" | sed 's/\[//g;s/\].*//g;s/:.*//g')
        _ss_iface=$(ip -o addr show 2>/dev/null | grep -F "${_ss_ip}" | awk '{print $2}' | head -1)

        if echo "${_ss_addr}" | grep -q '^\['; then
          _ss_addr_type="IPv6"
        elif echo "${_ss_ip}" | grep -qE '^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)'; then
          _ss_addr_type="Private"
        else
          _ss_addr_type="Public"
        fi

        if [ -n "${_ss_iface}" ]; then
          printf '%s\n' "      ↳ ${yellow}${_ss_addr}${normal} ${orange}(${_ss_iface}, ${_ss_addr_type})${normal}"
        else
          printf '%s\n' "      ↳ ${yellow}${_ss_addr}${normal} ${orange}(${_ss_addr_type})${normal}"
        fi
      done
      echo ""

      _ss_exit_id=$(echo "${_ss_status}" | jqr -r '.ExitNodeStatus.ID // empty')
      if [ -n "${_ss_exit_id}" ]; then
        _ss_exit_online=$(echo "${_ss_status}" | jqr -r '.ExitNodeStatus.Online // false')
        _ss_exit_ip=$(echo "${_ss_status}" | jqr -r '.ExitNodeStatus.TailscaleIPs[0] // "-"' | cut -d'/' -f1)
        _ss_exit_host=$(echo "${_ss_status}" | jqr -r --arg id "${_ss_exit_id}" '.Peer | to_entries[] | select(.value.ID == $id) | .value.HostName')
        _ss_exit_rx=$(echo "${_ss_status}" | jqr -r --arg id "${_ss_exit_id}" '.Peer | to_entries[] | select(.value.ID == $id) | .value.RxBytes')
        _ss_exit_tx=$(echo "${_ss_status}" | jqr -r --arg id "${_ss_exit_id}" '.Peer | to_entries[] | select(.value.ID == $id) | .value.TxBytes')
        if [ "${_ss_exit_online}" = "true" ]; then
          printf '%s\n' "  ${blue}Exit Node: ${green}Connected${normal} to ${yellow}${_ss_exit_host}${normal}"
        else
          printf '%s\n' "  ${blue}Exit Node: ${red}Offline${normal} ${yellow}${_ss_exit_host}${normal}"
        fi
        printf '%s\n' "    ↳ IP: ${yellow}${_ss_exit_ip}${normal}"
        printf '%s\n' "    ↳ Traffic: ${green}↓${normal} ${yellow}$(humanize_bytes "${_ss_exit_rx}")${normal} | ${red}↑${normal} ${yellow}$(humanize_bytes "${_ss_exit_tx}")${normal}"
        echo ""
      fi
      ;;
  esac

  _ss_online=$(echo "${_ss_status}" | jqr '[.Peer | to_entries | .[] | select(.value.Online == true)] | length')
  _ss_offline=$(echo "${_ss_status}" | jqr '[.Peer | to_entries | .[] | select(.value.Online == false)] | length')
  _ss_exit_on=$(echo "${_ss_status}" | jqr '[.Peer | to_entries | .[] | select(.value.ExitNodeOption == true and .value.Online == true)] | length')
  _ss_exit_off=$(echo "${_ss_status}" | jqr '[.Peer | to_entries | .[] | select(.value.ExitNodeOption == true and .value.Online == false)] | length')

  case "${_ss_mode}" in
    summary)
      printf '%s\n' "  ${blue}Peers:${normal} ${green}${_ss_online} online${normal}, ${red}${_ss_offline} offline${normal}"
      printf '%s' "    ↳ By OS: "
      _ss_first=true
      echo "${_ss_status}" | jqr -r '
        [.Peer | to_entries | .[] | {os: .value.OS, online: .value.Online}] |
        group_by(.os) |
        map({
          os: .[0].os,
          online: map(select(.online == true)) | length,
          offline: map(select(.online == false)) | length
        }) |
        .[] | "\(.os):\(.online):\(.offline)"
      ' | while IFS=: read -r _ss_pos _ss_pon _ss_poff; do
        if [ "${_ss_first}" = true ]; then
          _ss_first=false
        else
          printf '%s' ", "
        fi
        printf '%s' "${_ss_pos} (${green}${_ss_pon}${normal}|${red}${_ss_poff}${normal})"
      done
      printf '\n'
      printf '%s\n' "    ↳ By Relay:"
      if [ -f "${TS_DIR}/derpmap.cached.json" ]; then
        echo "${_ss_status}" | jqr -r --slurpfile derp "${TS_DIR}/derpmap.cached.json" '
          [.Peer | to_entries | .[].value.Relay] | group_by(.) | map(. as $group | {
            code: $group[0],
            count: ($group | length),
            name: ([$derp[0].Regions | to_entries[] | select(.value.RegionCode == $group[0]) | .value.RegionName][0] // $group[0])
          }) | .[] | "\(.name):\(.count)"
        ' | while IFS=: read -r _ss_region _ss_count; do
          printf '%s\n' "      ↳ ${_ss_region}: ${yellow}${_ss_count}${normal}"
        done
      else
        echo "${_ss_status}" | jqr -r '[.Peer | to_entries | .[].value.Relay] | group_by(.) | .[] | "\(.[0]):\(length)"' | while IFS=: read -r _ss_region _ss_count; do
          printf '%s\n' "      ↳ ${_ss_region}: ${yellow}${_ss_count}${normal}"
        done
      fi
      printf '%s\n' "    ↳ Exit Nodes: ${green}${_ss_exit_on} online${normal}, ${red}${_ss_exit_off} offline${normal}"
      ;;
    peer|all)
      printf '%s\n' "  ${blue}Peers:${normal} ${green}${_ss_online} online${normal}, ${red}${_ss_offline} offline${normal}"
      echo "${_ss_status}" | jqr -r --arg green "${green}" --arg red "${red}" --arg orange "${orange}" --arg yellow "${yellow}" --arg normal "${normal}" '
        (.Peer | to_entries | map(select(.value.Online == true)) | "    ↳ Online (\($green)\(length)\($normal))"),
        (.Peer | to_entries | map(select(.value.Online == true)) | .[] | "      ↳ \($green)\(.value.HostName)\($normal)\t\($orange)\(.value.Relay)\($normal) \($yellow)\(.value.TailscaleIPs[0])\($normal) \($orange)\(.value.OS)\($normal)"),
        (.Peer | to_entries | map(select(.value.Online == false)) | "    ↳ Offline (\($red)\(length)\($normal))"),
        (.Peer | to_entries | map(select(.value.Online == false)) | .[] | "      ↳ \($red)\(.value.HostName)\($normal)\t\($orange)\(.value.Relay)\($normal) \($yellow)\(.value.TailscaleIPs[0])\($normal) \($orange)\(.value.OS)\($normal)")
      ' | while IFS= read -r _ss_line; do echo "${_ss_line}"; done
      [ "${_ss_mode}" = "all" ] && echo ""
      ;;
  esac

  case "${_ss_mode}" in
    exit-node|all)
      printf '%s\n' "  ${blue}Exit Nodes:${normal} ${green}${_ss_exit_on} online${normal}, ${red}${_ss_exit_off} offline${normal}"
      echo "${_ss_status}" | jqr -r --arg green "${green}" --arg red "${red}" --arg orange "${orange}" --arg yellow "${yellow}" --arg normal "${normal}" '.Peer | to_entries | map(select(.value.ExitNodeOption == true)) | .[] | if .value.Online then "    ↳ \($green)\(.value.HostName)\($normal)\t\($orange)\(.value.Relay)\($normal) \($yellow)\(.value.TailscaleIPs[0])\($normal) \($orange)\(.value.OS)\($normal)" else "    ↳ \($red)\(.value.HostName)\($normal)\t\($orange)\(.value.Relay)\($normal) \($yellow)\(.value.TailscaleIPs[0])\($normal) \($orange)\(.value.OS)\($normal)" end' | while IFS= read -r _ss_line; do echo "${_ss_line}"; done
      ;;
  esac
  return 0
}

log_service() {
  case "$1" in
    daemon)
      busybox tail -F "${TS_LOG_FILE}"
      ;;
    service)
      busybox tail -F "${TS_RUN_LOG_FILE}"
      ;;
    *)
      usage log
      return 1
      ;;
  esac
}

set_mode() {
  _sm_mode="$1"
  case "${_sm_mode}" in
    bridge|tun|proxy) ;;
    *)
      log Error "invalid mode: ${_sm_mode:-<empty>} (expected bridge|tun|proxy)"
      usage mode
      return 1
      ;;
  esac
  if [ "${_sm_mode}" = "tun" ] && [ ! -c /dev/net/tun ]; then
    log Error "cannot switch to tun mode: /dev/net/tun does not exist."
    return 1
  fi
  conf_write_key foxytail.conf TS_MODE "${_sm_mode}" || return 1
  log Success "TS_MODE set to ${_sm_mode}; restarting."
  restart_service
}

usage() {
  _u_cmd="$1"
  _u_cmds=""
  _u_opts=""
  _u_in_cmd=false
  while IFS= read -r _u_line; do
    case "${_u_line}" in
      "# @cmd "*)
        if [ -z "${_u_cmd}" ]; then
          _u_line="${_u_line#\# @cmd }"
          _u_c="${_u_line%%\|*}"
          _u_c=$(echo "${_u_c}" | xargs)
          if [ -z "${_u_cmds}" ]; then _u_cmds="${_u_c}"; else _u_cmds="${_u_cmds}|${_u_c}"; fi
        elif echo "${_u_line}" | grep -q "^# @cmd ${_u_cmd} "; then
          _u_in_cmd=true
        elif [ "${_u_in_cmd}" = true ]; then
          break
        fi
        ;;
      "# @sub "*)
        if [ "${_u_in_cmd}" = true ]; then
          _u_line="${_u_line#\# @sub }"
          _u_sub="${_u_line%%\|*}"
          _u_sub=$(echo "${_u_sub}" | xargs)
          if [ -z "${_u_opts}" ]; then _u_opts="${_u_sub}"; else _u_opts="${_u_opts}|${_u_sub}"; fi
        fi
        ;;
    esac
  done <"$0"

  if [ -z "${_u_cmd}" ]; then
    printf '%s\n' "${yellow}usage${normal}: ${green}${scripts_name}${normal} {${orange}${_u_cmds}${normal}}"
  else
    printf '%s\n' "${yellow}usage${normal}: ${green}${scripts_name}${normal} ${yellow}${_u_cmd}${normal} {${orange}${_u_opts}${normal}}"
  fi
}

help() {
  _h_show_all="$1"
  while IFS= read -r _h_line; do
    case "${_h_line}" in
      "# @title "*)
        printf '%s\n' "${green}${_h_line#\# @title }${normal}"
        ;;
      "# @header "*)
        printf '%s\n' "${_h_line#\# @header }"
        ;;
      "# @cmd "*)
        break
        ;;
    esac
  done <"$0"

  printf '%s\n' "${blue}Available Command:${normal}"

  while IFS= read -r _h_line; do
    case "${_h_line}" in
      "# @cmd "*)
        _h_line="${_h_line#\# @cmd }"
        IFS='|' read -r _h_cmd _h_desc <<EOF
${_h_line}
EOF
        _h_cmd=$(echo "${_h_cmd}" | xargs)
        _h_desc=$(echo "${_h_desc}" | xargs)
        printf '%-15s\t• %s\n' "${yellow}${_h_cmd}${normal}" "${_h_desc}"
        ;;
      "# @sub "*)
        _h_line="${_h_line#\# @sub }"
        IFS='|' read -r _h_sub _h_sdesc <<EOF
${_h_line}
EOF
        _h_sub=$(echo "${_h_sub}" | xargs)
        _h_sdesc=$(echo "${_h_sdesc}" | xargs)
        printf '  %s %-11s\t- %s\n' "${yellow}↳${normal}" "${orange}${_h_sub}${normal}" "${_h_sdesc}"
        ;;
      "# @desc "*)
        if [ "${_h_show_all}" = "all" ]; then
          _h_desc="${_h_line#\# @desc }"
          _h_first=true
          echo "${_h_desc}" | busybox fold -sw70 | while IFS= read -r _h_dline; do
            if [ "${_h_first}" = true ]; then
              printf '    %s %s\n' "${yellow}↳${normal}" "${_h_dline}"
              _h_first=false
            else
              printf '      %s\n' "${_h_dline}"
            fi
          done
        fi
        ;;
    esac
  done <"$0"
}

restart_service() {
  prepare_service_config || return 1
  if ! stop_service; then
    log Error "restart aborted: stop failed; not starting again."
    return 1
  fi
  _SERVICE_STOPPED=1
  # The stop half above wrote the manual-stop marker; a Stop requested during
  # the sleep window overwrites it with a newer timestamp. Only start when the
  # marker is unchanged (or already cleared), so a user Stop wins the race.
  _rst_stop=$(cat "${TS_RUN_DIR}/manual-stop" 2>/dev/null)
  sleep 1
  _rst_now=$(cat "${TS_RUN_DIR}/manual-stop" 2>/dev/null)
  if [ -n "${_rst_now}" ] && [ "${_rst_now}" != "${_rst_stop}" ]; then
    log Warning "restart aborted: service was stopped manually during restart; staying stopped."
    return 0
  fi
  start_service
}

# Serialize all controllers (WebUI, watchdog, context and boot).
# PID ownership makes an interrupted controller recoverable without expiring a
# lock still held by a slow, live operation.
service_unlock() {
  case "${_SERVICE_CANDIDATE:-}" in
    "${TS_RUN_DIR}"/.applied.*)
      [ "${_SERVICE_CANDIDATE##*/}" = "$(cat "${TS_RUN_DIR}/applied-config" 2>/dev/null)" ] || rm -rf "${_SERVICE_CANDIDATE}"
      ;;
  esac
  _owner_lock_release "${TS_RUN_DIR}/.service-lock" "${_SERVICE_LOCK_TOKEN}"
}

service_lock() {
  ensure_run_dirs
  _lock_identity
  _SERVICE_LOCK_TOKEN=${_LOCK_TOKEN}
  _owner_lock_acquire "${TS_RUN_DIR}/.service-lock" "${_SERVICE_LOCK_TOKEN}" 120 0.5 || {
    log Error "service controller busy"; return 1;
  }
  trap 'service_unlock' 0
  trap 'exit 1' INT TERM HUP
}

case "$1" in
  start|stop|restart|mode|reconcile|recover|trial) service_lock || exit 1 ;;
esac

if conf_trial_active; then
  case "$1:${2:-}" in
    stop:*) [ -f "${TS_DIR}/.installing" ] || "${TS_SCRIPTS_DIR}/foxytail.trial" supersede || exit 1 ;;
    restart:*|mode:*|start:)
      log Error 'configuration trial active; confirm or revert it before applying another configuration'
      exit 1 ;;
  esac
fi

case "$1" in
  trial)
    _TRIAL_ID="$2"
    _SERVICE_CANDIDATE=$("${TS_SCRIPTS_DIR}/foxytail.trial" prepare "$2" "$3") || exit 1
    "${TS_SCRIPTS_DIR}/start.sh" pause-residents || exit 1
    restart_service || exit 1
    "${TS_SCRIPTS_DIR}/start.sh" resume-residents
    ;;
  reconcile)
    [ -f "${TS_RUN_DIR}/manual-stop" ] && exit 0
    _SERVICE_RECOVERY=1
    start_service
    ;;
  recover)
    [ -f "${TS_RUN_DIR}/manual-stop" ] && exit 0
    _SERVICE_RECOVERY=1
    case "$2" in
      start|reconcile) start_service ;;
      restart) restart_service ;;
      *) exit 1 ;;
    esac
    ;;
  start)
    case "${2:-}" in
      '') ;;
      --applied) _SERVICE_RECOVERY=1 ;;
      *) exit 1 ;;
    esac
    start_service
    ;;
  stop)
    stop_service
    ;;
  restart)
    restart_service
    ;;
  status)
    load_runtime_conf || exit 1
    status_service "$2"
    ;;
  log)
    log_service "$2"
    ;;
  mode)
    set_mode "$2"
    ;;
  help)
    help "$2"
    ;;
  *)
    if [ -n "$1" ]; then
      printf '%s\n' "${yellow}${scripts_name} ${orange}$1 ${red}not found${normal}, run ${yellow}${scripts_name} help${normal} for all commands"
      exit 1
    fi
    usage
    ;;
esac
