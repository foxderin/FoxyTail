#!/system/bin/sh
# FoxyTail - one-shot diagnostics bundle.
#
# Usage: foxytail.diag collect [output-dir]   (default /sdcard/Download)
# Prints the tar.gz path as the LAST line of stdout (webapi parses it).

DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "$DIR"/../settings.sh
load_conf
ensure_run_dirs

TS_SOCKET="${TS_RUN_DIR}/tailscaled.sock"
trap 'exit 130' HUP INT TERM

# Strip Tailscale login URLs from daemon output: the diag bundle lands in
# shared storage and an auth URL is a bearer secret for the node identity.
_redact() {
  sed 's|https://login\.tailscale\.com/[^ ]*|[redacted-login-url]|g'
}

collect() {
  _outdir="${1:-/sdcard/Download}"

  # Verify the output dir is writable; fall back to $TS_DIR otherwise.
  if { [ -d "$_outdir" ] || mkdir -p "$_outdir" 2>/dev/null; } \
    && touch "${_outdir}/.foxytail-write-test" 2>/dev/null; then
    rm -f "${_outdir}/.foxytail-write-test"
  else
    log Warning "diag: ${_outdir} is not writable, falling back to ${TS_DIR}"
    echo "warning: ${_outdir} not writable, using ${TS_DIR} instead"
    _outdir="$TS_DIR"
    mkdir -p "$_outdir" 2>/dev/null
  fi

  _stamp=$(date +%Y%m%d-%H%M%S)-$$
  _out="${_outdir}/foxytail-diag-${_stamp}.tar.gz"
  _partial="${_out}.partial"

  _stage=$(mktemp -d "${TS_RUN_DIR}/diag.XXXXXX" 2>/dev/null) || return 1
  trap 'rm -rf "${_stage}"; rm -f "${_partial}"' 0

  log Info "diag: collecting into ${_stage}"

  # Log tails (auth URLs redacted).
  for _l in "$TS_RUN_LOG_FILE" "$TS_LOG_FILE"; do
    [ -f "$_l" ] && tail -n 500 "$_l" 2>&1 | _redact \
      >"${_stage}/$(basename "$_l").tail"
  done

  # Daemon state.
  tmo 15 tailscale --socket="$TS_SOCKET" status --json \
    >"${_stage}/status.json" 2>"${_stage}/status.err"
  tmo 20 tailscale --socket="$TS_SOCKET" netcheck \
    >"${_stage}/netcheck.txt" 2>&1
  tmo 20 tailscale --socket="$TS_SOCKET" bugreport 2>&1 |
    _redact >"${_stage}/bugreport.txt"

  # Routing and firewall dumps.
  ip rule >"${_stage}/ip-rule.txt" 2>&1
  ip route show table main >"${_stage}/ip-route-main.txt" 2>&1
  ip route show table "${ROUTE_TABLE}" >"${_stage}/ip-route-${ROUTE_TABLE}.txt" 2>&1
  iptables -S >"${_stage}/iptables-filter.txt" 2>&1
  iptables -t mangle -S >"${_stage}/iptables-mangle.txt" 2>&1
  iptables -t nat -S >"${_stage}/iptables-nat.txt" 2>&1
  if [ "$IPV6" = "on" ]; then
    ip6tables -S >"${_stage}/ip6tables-filter.txt" 2>&1
    ip6tables -t mangle -S >"${_stage}/ip6tables-mangle.txt" 2>&1
  fi

  # Sanitized config copies: drop any line containing authkey/key.
  mkdir -p "${_stage}/conf"
  for _c in "${TS_CONF_DIR}"/*; do
    [ -f "$_c" ] || continue
    sed '/[Kk][Ee][Yy]/d' "$_c" >"${_stage}/conf/$(basename "$_c")"
  done

  # Coexistence snapshot.
  if [ -x "${TS_SCRIPTS_DIR}/foxytail.compat" ]; then
    "${TS_SCRIPTS_DIR}/foxytail.compat" probe >"${_stage}/compat.json" 2>/dev/null
  fi

  # Module + device inventory.
  ls /data/adb/modules >"${_stage}/modules.txt" 2>&1
  {
    for _p in ro.product.manufacturer ro.product.model ro.product.device \
      ro.build.version.release ro.build.version.sdk ro.build.fingerprint \
      sys.boot_completed; do
      echo "${_p}=$(getprop "$_p")"
    done
  } >"${_stage}/props.txt"
  [ -f "$TS_MOD_PROP" ] && cp "$TS_MOD_PROP" "${_stage}/module.prop"
  [ -f "${TS_DIR}/VERSIONS" ] && cp "${TS_DIR}/VERSIONS" "${_stage}/VERSIONS"

  if tar -czf "$_partial" -C "$TS_RUN_DIR" "$(basename "$_stage")" 2>/dev/null && mv "$_partial" "$_out"; then
    log Success "diag: bundle written to ${_out}"
  else
    log Error "diag: failed to write ${_out}"
    return 1
  fi
  echo "$_out"
}

case "$1" in
  collect) shift; collect "$@" ;;
  *)
    echo "usage: $0 collect [output-dir]" >&2
    exit 1
    ;;
esac
