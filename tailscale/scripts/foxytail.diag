#!/system/bin/sh
# FoxyTail - one-shot diagnostics bundle.
#
# Usage: foxytail.diag collect [output-dir] [share|local] (default: share)
# Default output is /sdcard/Download for share and $TS_DIR/diag for local:
# local bundles keep raw identities and never default to shared storage.
# Prints the tar.gz path as the LAST line of stdout (webapi parses it).

DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "$DIR"/../settings.sh
load_conf
ensure_run_dirs

trap 'exit 130' HUP INT TERM

# Strip Tailscale login URLs from daemon output: the diag bundle lands in
# shared storage and an auth URL is a bearer secret for the node identity.
_redact() {
  sed -E 's|https://login\.tailscale\.com/[^[:space:]]*|[redacted-login-url]|g; s|tskey-[A-Za-z0-9_-]+|[redacted-key]|g'
}

# One bundle-wide mapping preserves relationships across status, logs and
# rules. The raw mapping/input never enters shared storage or the archive.
share_redact() {
  _redact_input=$(mktemp "${TS_RUN_DIR}/diag-records.XXXXXX") || return 1
  _redact_output=$(mktemp "${TS_RUN_DIR}/diag-redacted.XXXXXX") || return 1
  for _dr_file in "$_stage"/* "$_stage"/conf/*; do
    [ -f "$_dr_file" ] || continue
    jqr -n -c --arg path "${_dr_file#"$_stage"/}" --rawfile text "$_dr_file" \
      '{path:$path,text:$text}' >>"$_redact_input" || return 1
  done
  jqr -s -c '
    def escaped: explode | map(. as $c |
      if ([92,46,94,36,124,63,42,43,40,41,91,93,123,125] | index($c)) != null
      then [92,$c] else [$c] end) | add | implode;
    . as $files | (map(.text)|join("\n")) as $all
    | (map(select(.path=="status.json") | .text | fromjson?) | .[0] // {}) as $status
    | [
        ($status | .. | objects | to_entries[]
          | select(.key | test("^(HostName|DNSName|MagicDNSSuffix|DisplayName|LoginName|Name|ID|UserID|PublicKey|MachineKey|NodeKey|DiscoKey|AuthURL)$"))
          | .value | select(type=="string" or type=="number") | tostring | select(length>0)),
        ($files[] | select(.path=="conf/context.conf") | .text | split("\n")[]
          | select(startswith("ssid:")) | split(":")[1] | select(length>0)),
        ($files[] | select(.path=="conf/context.conf") | .text | split("\n")[]
          | split(":") | select(.[2]=="exit-node") | .[3:] | join(":") | gsub("^[ \\t]+|[ \\t\\r]+$";"") | select(length>0)),
        ($all | scan("ssid:[^:\\r\\n\\x27\"]+") | ltrimstr("ssid:")),
        ($all | scan("[0-9]{1,3}(?:\\.[0-9]{1,3}){3}")),
        ($all | scan("(?:[0-9A-Fa-f]{0,4}:){2,}[0-9A-Fa-f:.]*(?:%[A-Za-z0-9_.-]+)?")
          | select(contains("::") or (split(":")|length)>=8)),
        ($all | scan("[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}")),
        ($all | scan("https?://[^\\s<>\"]+|tskey-[A-Za-z0-9_-]+|(?:nodekey|machinekey|discokey):[A-Za-z0-9]+"))
      ] | unique | sort_by(-length, .) | to_entries
      | map({pattern:("(?<![\\p{L}\\p{N}_.-])"+(.value|escaped)+"(?![\\p{L}\\p{N}_.-])"),
             replacement:("[anon-"+(.key|tostring)+"]")}) as $map
    | def anonymize: reduce $map[] as $m (. ; gsub($m.pattern; $m.replacement));
    $files[] | .text |= (
      . as $raw | try (fromjson | walk(
        if type=="string" then anonymize
        elif type=="object" then with_entries(
          if (.key=="ID" or .key=="UserID") and (.value|type)=="number"
          then .value |= (tostring | anonymize) else . end | .key |= anonymize)
        else . end) | tojson) catch ($raw | anonymize)
    )
  ' "$_redact_input" >"$_redact_output" || return 1
  while IFS= read -r _dr_record; do
    _dr_path=$(printf '%s' "$_dr_record" | jqr -r '.path') || return 1
    printf '%s' "$_dr_record" | jqr -j '.text' >"$_stage/$_dr_path" || return 1
  done <"$_redact_output"
  rm -f "$_redact_input" "$_redact_output" || return 1
}

diag_cleanup() {
  _diag_rc=$?
  rm -rf "${_stage}"
  rm -f "${_partial}" "${_redact_input:-}" "${_redact_output:-}"
  [ "$_diag_rc" = 0 ] || rm -f "$_out"
  exit "$_diag_rc"
}

collect() {
  _outdir=$1
  _mode=${2:-share}
  case "$_mode" in share|local) ;; *) echo 'expected share|local' >&2; return 1 ;; esac
  umask 077
  # A local bundle skips anonymization entirely: without an explicit output
  # directory it must not default onto shared storage.
  if [ -z "${_outdir}" ]; then
    if [ "$_mode" = local ]; then _outdir="${TS_DIR}/diag"; else _outdir=/sdcard/Download; fi
  fi

  # Verify the output dir is writable; fall back to $TS_DIR otherwise.
  if { [ -d "$_outdir" ] || mkdir -p "$_outdir" 2>/dev/null; } \
    && touch "${_outdir}/.foxytail-write-test" 2>/dev/null; then
    rm -f "${_outdir}/.foxytail-write-test"
  else
    log Warning "diag: ${_outdir} is not writable, falling back to ${TS_DIR}"
    echo "warning: ${_outdir} not writable, using ${TS_DIR} instead"
    _outdir="$TS_DIR"
    mkdir -p "$_outdir" 2>/dev/null
  fi

  _stamp=$(date +%Y%m%d-%H%M%S)-$$
  _out="${_outdir}/foxytail-diag-${_stamp}.tar.gz"
  _partial="${_out}.partial"

  _stage=$(mktemp -d "${TS_RUN_DIR}/diag.XXXXXX" 2>/dev/null) || return 1
  trap 'diag_cleanup' 0

  log Info "diag: collecting into ${_stage}"

  # Log tails (auth URLs redacted).
  for _l in "$TS_RUN_LOG_FILE" "$TS_LOG_FILE"; do
    [ -f "$_l" ] && tail -n 500 "$_l" 2>&1 | _redact \
      >"${_stage}/$(basename "$_l").tail"
  done

  # Daemon state: the bundle keeps the raw CLI output with its stderr beside it,
  # so this capture stays outside the validating ts_status_json helper.
  tmo 15 tailscale --socket="${TS_SOCKET}" status --json \
    >"${_stage}/status.json" 2>"${_stage}/status.err"
  tmo 20 tailscale --socket="$TS_SOCKET" netcheck \
    >"${_stage}/netcheck.txt" 2>&1
  tmo 20 tailscale --socket="$TS_SOCKET" bugreport 2>&1 |
    _redact >"${_stage}/bugreport.txt"

  # Routing and firewall dumps.
  ip rule >"${_stage}/ip-rule.txt" 2>&1
  ip route show table main >"${_stage}/ip-route-main.txt" 2>&1
  ip route show table "${ROUTE_TABLE}" >"${_stage}/ip-route-${ROUTE_TABLE}.txt" 2>&1
  iptables -S >"${_stage}/iptables-filter.txt" 2>&1
  iptables -t mangle -S >"${_stage}/iptables-mangle.txt" 2>&1
  iptables -t nat -S >"${_stage}/iptables-nat.txt" 2>&1
  if [ "$IPV6" = "on" ]; then
    ip6tables -S >"${_stage}/ip6tables-filter.txt" 2>&1
    ip6tables -t mangle -S >"${_stage}/ip6tables-mangle.txt" 2>&1
  fi

  # Sanitized config copies: drop any line containing authkey/key.
  mkdir -p "${_stage}/conf"
  for _c in "${TS_CONF_DIR}/foxytail.conf" "${TS_CONF_DIR}/routes.conf" "${TS_CONF_DIR}/context.conf"; do
    [ -f "$_c" ] || continue
    sed '/[Kk][Ee][Yy]/d' "$_c" >"${_stage}/conf/$(basename "$_c")"
  done

  # Coexistence snapshot.
  if [ -x "${TS_SCRIPTS_DIR}/foxytail.compat" ]; then
    "${TS_SCRIPTS_DIR}/foxytail.compat" probe >"${_stage}/compat.json" 2>/dev/null
  fi

  # Module + device inventory.
  ls /data/adb/modules >"${_stage}/modules.txt" 2>&1
  {
    for _p in ro.product.manufacturer ro.product.model ro.product.device \
      ro.build.version.release ro.build.version.sdk ro.build.fingerprint \
      sys.boot_completed; do
      echo "${_p}=$(getprop "$_p")"
    done
  } >"${_stage}/props.txt"
  [ -f "$TS_MOD_PROP" ] && cp "$TS_MOD_PROP" "${_stage}/module.prop"
  [ -f "${TS_DIR}/VERSIONS" ] && cp "${TS_DIR}/VERSIONS" "${_stage}/VERSIONS"

  if [ "$_mode" = share ]; then
    share_redact || { log Error 'diag: anonymization failed; no archive was published'; return 1; }
  fi
  printf 'mode=%s\n' "$_mode" >"${_stage}/diagnostic-mode.txt"

  if tar -czf "$_partial" -C "$TS_RUN_DIR" "$(basename "$_stage")" 2>/dev/null && mv "$_partial" "$_out"; then
    # The private default is invisible to the user, so keep it bounded: retain
    # the newest two bundles instead of one more per run forever. Explicit
    # output directories are the caller's to manage and are never pruned.
    if [ "${_outdir}" = "${TS_DIR}/diag" ]; then
      ls -1t "${_outdir}"/foxytail-diag-*.tar.gz 2>/dev/null | tail -n +3 |
        while IFS= read -r _old; do rm -f "${_old}"; done
    fi
    log Success "diag: bundle written to ${_out}"
  else
    log Error "diag: failed to write ${_out}"
    return 1
  fi
  echo "$_out"
}

case "$1" in
  collect) shift; collect "$@" ;;
  *)
    echo "usage: $0 collect [output-dir] [share|local]" >&2
    exit 1
    ;;
esac
