#!/system/bin/sh
# Bound logs independently of WATCHDOG. See log-lib for event coalescing and
# the bounded audit when a notification is lost.
DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "$DIR"/../settings.sh
# shellcheck source=foxytail.log-lib.sh
. "$DIR"/foxytail.log-lib.sh
ensure_run_dirs

case "$1" in
  start)
    daemon_claim_pidfile foxytail.logd || exit 0
    logd_run
    ;;
  stop) daemon_stop_pidfile foxytail.logd ;;
  once) logd_reload_config; logd_rotate_all ;;
  *) echo "usage: $0 {start|stop|once}" >&2; exit 1 ;;
esac
