#!/system/bin/sh
# Bound logs independently of WATCHDOG. copytruncate in rotate_log keeps
# append-only daemon descriptors attached to the active file.
DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "$DIR"/../settings.sh
ensure_run_dirs

rotate_all() {
  # Invalid configuration still leaves safe default limits; keep protecting
  # storage while its parse diagnostics are being written.
  load_runtime_conf || :
  _la_interval=30
  [ "${POWER_SAVE:-off}" != on ] || _la_interval=60
  _la_limit=$((${LOG_MAX_KB:-512} * 1024))
  _la_sizes='
'
  for _la_file in "${TS_RUN_DIR}"/*.log; do
    [ -f "$_la_file" ] && [ ! -L "$_la_file" ] || continue
    _la_size=$(wc -c <"$_la_file" 2>/dev/null) || continue
    # Only changing logs near the limit need fast checks. Keep sizes in memory
    # so a quiet half-full log cannot pin the entire monitor to two seconds.
    # ponytail: O(n^2) size lookups for a few logs; use a map if the set grows.
    case "${_la_previous_sizes:-}" in
      *"
${_la_file}:${_la_size}
"*) ;;
      *) [ "$_la_size" -le "$((_la_limit / 2))" ] || _la_interval=2 ;;
    esac
    _la_sizes="${_la_sizes}${_la_file}:${_la_size}
"
    [ "$_la_size" -le "$_la_limit" ] || rotate_log "$_la_file" "$_la_size"
  done
  _la_previous_sizes=$_la_sizes
}

case "$1" in
  start)
    daemon_claim_pidfile foxytail.logd || exit 0
    _la_running=1
    trap '_la_running=0' TERM INT
    while [ "$_la_running" = 1 ]; do
      rotate_all
      isleep "$_la_interval"
    done
    rm -f "${TS_PID_DIR}/foxytail.logd.pid"
    ;;
  stop) daemon_stop_pidfile foxytail.logd ;;
  once) rotate_all ;;
  *) echo "usage: $0 {start|stop|once}" >&2; exit 1 ;;
esac
