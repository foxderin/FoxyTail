#!/system/bin/sh
# FoxyTail user hook: runs AFTER the tailscale0 interface goes down.
#
# When is this called?
#   By `foxytail.tun stop`, after hev-socks5-tunnel has been terminated and
#   the tailscale0 interface is gone (or is about to disappear).
#
# What can you use here?
#   Same environment as foxytail.tun.up: everything from settings.sh plus the
#   values loaded by load_conf. Use `log Info "..."` for logging.
#
# What is it for?
#   Undo whatever your foxytail.tun.up added, e.g. remove extra routes:
#
#     ip route del 192.168.10.0/24 dev tailscale0 table "${ROUTE_TABLE}"
#     ip route del 10.8.0.0/16 dev tailscale0 table "${ROUTE_TABLE}"
#
#   or remove custom firewall rules:
#
#     iptables -t mangle -D FOXY_MARK -p tcp --dport 445 -j RETURN
#     iptables -t filter -D FOXY_STAT -s 100.64.0.0/10 -j RETURN
#
# Everything here must be best-effort: the interface may already be gone, so
# failing commands are expected. Do not `set -e`.
#
# The installer never overwrites this file once you have modified it.

DIR=$(dirname "$(realpath "$0")")
# shellcheck source=../settings.sh
. "${DIR}/../settings.sh"

ensure_run_dirs
load_conf

# Default behavior: remove FoxyTail policy routing.
if [ -x "${TS_SCRIPTS_DIR}/foxytail.route" ]; then
  "${TS_SCRIPTS_DIR}/foxytail.route" teardown
fi

exit 0
