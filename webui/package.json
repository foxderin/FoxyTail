{
  "name": "foxytail-webui",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "theme:generate": "node scripts/generate-theme.mjs",
    "check:theme": "node scripts/generate-theme.mjs --check",
    "smoke": "vite build --config vite.smoke.config.ts && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@material-symbols/svg-400": "^0.47.1",
    "kernelsu": "^3.0.2",
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.0",
    "vite-plugin-solid": "^2.11.14"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "packageManager": "pnpm@10.30.3"
}
