<resources>
    <style name="AppThemeBase" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/foxy_primary</item>
        <item name="colorOnPrimary">@color/foxy_on_primary</item>
        <item name="colorPrimaryContainer">@color/foxy_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/foxy_on_primary_container</item>
        <item name="colorSecondary">@color/foxy_secondary</item>
        <item name="colorOnSecondary">@color/foxy_on_secondary</item>
        <item name="colorSecondaryContainer">@color/foxy_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/foxy_on_secondary_container</item>
        <item name="colorTertiary">@color/foxy_tertiary</item>
        <item name="colorOnTertiary">@color/foxy_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/foxy_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/foxy_on_tertiary_container</item>
        <item name="colorSurface">@color/foxy_surface</item>
        <item name="colorSurfaceContainerLow">@color/foxy_surface_low</item>
        <item name="colorSurfaceContainer">@color/foxy_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/foxy_surface_high</item>
        <item name="colorOnSurface">@color/foxy_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/foxy_on_surface_variant</item>
        <item name="colorOutline">@color/foxy_outline</item>
        <item name="colorOutlineVariant">@color/foxy_outline_variant</item>
        <item name="colorError">@color/foxy_error</item>
        <item name="colorOnError">@color/foxy_on_error</item>
        <item name="colorErrorContainer">@color/foxy_error_container</item>
        <item name="colorOnErrorContainer">@color/foxy_on_error_container</item>
        <item name="colorSurfaceContainerLowest">@color/foxy_surface</item>
        <item name="android:colorBackground">@color/foxy_background</item>
        <item name="android:windowBackground">@color/foxy_background</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.FoxyTail.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.FoxyTail.Medium</item>
        <!-- WebUI is flat: borders, not tint overlays -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="materialButtonStyle">@style/Widget.FoxyTail.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.FoxyTail.Button.Outlined</item>
        <item name="materialButtonTonalStyle">@style/Widget.FoxyTail.Button.Tonal</item>
        <item name="textInputOutlinedStyle">@style/Widget.FoxyTail.TextInput</item>
        <item name="textInputOutlinedExposedDropdownMenuStyle">@style/Widget.FoxyTail.TextInput.Exposed</item>
        <item name="android:windowLightStatusBar">@bool/foxy_light_bars</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/foxy_background</item>
    </style>
    <bool name="foxy_light_bars">true</bool>
    <!-- WebUI geometry: buttons 11px, panels 16px, dialogs 18px -->
    <style name="ShapeAppearance.FoxyTail.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">11dp</item>
    </style>
    <style name="ShapeAppearance.FoxyTail.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <!-- Material3 1.14 pins button/input shapes to its own appearances;
         the component-level attrs are no-ops there, so override the widget styles. -->
    <style name="ShapeAppearance.FoxyTail.Input" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Widget.FoxyTail.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.FoxyTail.Small</item>
    </style>
    <style name="Widget.FoxyTail.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.FoxyTail.Small</item>
        <item name="android:textColor">@color/foxy_outlined_button_text</item>
        <item name="iconTint">@color/foxy_outlined_button_text</item>
    </style>
    <style name="Widget.FoxyTail.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="shapeAppearance">@style/ShapeAppearance.FoxyTail.Small</item>
    </style>
    <style name="Widget.FoxyTail.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.FoxyTail.Input</item>
    </style>
    <style name="Widget.FoxyTail.TextInput.Exposed" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="shapeAppearance">@style/ShapeAppearance.FoxyTail.Input</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
</resources>
