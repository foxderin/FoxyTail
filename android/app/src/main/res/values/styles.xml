<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:isLightTheme">@bool/foxy_light_bars</item>
        <item name="android:windowLightStatusBar">@bool/foxy_light_bars</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <bool name="foxy_light_bars">true</bool>
    <style name="AppTheme" parent="AppThemeBase" />
</resources>
